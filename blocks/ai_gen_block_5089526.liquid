{% endstyle %}

<drops-countdown-{{ ai_gen_id }} class="tsq-drops-wrap-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="tsq-drops-inner-{{ ai_gen_id }}">
    {% if block.settings.eyebrow != blank %}
      <div class="tsq-drops-eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow }}</div>
    {% endif %}

    {% if block.settings.headline != blank %}
      <h1 class="tsq-drops-headline-{{ ai_gen_id }}">
        {{ block.settings.headline }}
      </h1>
    {% endif %}

    <div class="tsq-drops-rule-{{ ai_gen_id }}"></div>

    {% if block.settings.body_text != blank %}
      <div class="tsq-drops-body-{{ ai_gen_id }}">
        {{ block.settings.body_text }}
      </div>
    {% endif %}

    {% if block.settings.show_countdown %}
      <div class="tsq-next-drop-{{ ai_gen_id }}">
        <span class="tsq-next-drop-dot-{{ ai_gen_id }}"></span>
        <span>{{ block.settings.next_drop_label }}</span>
      </div>

      <div class="tsq-countdown-wrap-{{ ai_gen_id }}" data-countdown-target="{{ block.settings.countdown_date }}">
        <div class="tsq-countdown-block-{{ ai_gen_id }}">
          <div class="tsq-countdown-num-{{ ai_gen_id }}" data-days>00</div>
          <div class="tsq-countdown-label-{{ ai_gen_id }}">Days</div>
        </div>
        <div class="tsq-countdown-block-{{ ai_gen_id }}">
          <div class="tsq-countdown-num-{{ ai_gen_id }}" data-hours>00</div>
          <div class="tsq-countdown-label-{{ ai_gen_id }}">Hours</div>
        </div>
        <div class="tsq-countdown-block-{{ ai_gen_id }}">
          <div class="tsq-countdown-num-{{ ai_gen_id }}" data-minutes>00</div>
          <div class="tsq-countdown-label-{{ ai_gen_id }}">Minutes</div>
        </div>
        <div class="tsq-countdown-block-{{ ai_gen_id }}">
          <div class="tsq-countdown-num-{{ ai_gen_id }}" data-seconds>00</div>
          <div class="tsq-countdown-label-{{ ai_gen_id }}">Seconds</div>
        </div>
      </div>
    {% endif %}

    {% if block.settings.show_form %}
      <div class="tsq-form-section-label-{{ ai_gen_id }}">{{ block.settings.form_label }}</div>

      {%- form 'contact' -%}
        <input type="hidden" name="contact[tags]" value="drops-waitlist">
        <div class="tsq-form-wrap-{{ ai_gen_id }}">
          <div class="tsq-form-row-{{ ai_gen_id }}">
            <input
              type="text"
              name="contact[first_name]"
              class="tsq-input-{{ ai_gen_id }}"
              placeholder="{{ block.settings.first_name_placeholder }}"
              value="{{ form.first_name }}"
              {% if form.errors %}
                aria-invalid="true"
              {% endif %}
            >
          </div>
          <div class="tsq-form-row-{{ ai_gen_id }}">
            <input
              type="text"
              name="contact[last_name]"
              class="tsq-input-{{ ai_gen_id }}"
              placeholder="{{ block.settings.last_name_placeholder }}"
              value="{{ form.last_name }}"
              {% if form.errors %}
                aria-invalid="true"
              {% endif %}
            >
          </div>
          <div class="tsq-form-row-{{ ai_gen_id }}">
            <input
              type="email"
              name="contact[email]"
              class="tsq-input-{{ ai_gen_id }}"
              placeholder="{{ block.settings.email_placeholder }}"
              value="{{ form.email }}"
              required
              aria-required="true"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              {% if form.errors %}
                aria-invalid="true"
                aria-describedby="tsq-error-{{ ai_gen_id }}"
              {% endif %}
              {% if form.posted_successfully? %}
                aria-describedby="tsq-success-{{ ai_gen_id }}"
              {% endif %}
            >
          </div>
          <button type="submit" class="tsq-submit-{{ ai_gen_id }}">
            {{ block.settings.submit_label }}
          </button>

          {%- if form.errors -%}
            <div id="tsq-error-{{ ai_gen_id }}" class="tsq-error-{{ ai_gen_id }}">
              {{ form.errors.messages.email }}
            </div>
          {%- endif -%}

          {%- if form.posted_successfully? -%}
            <div id="tsq-success-{{ ai_gen_id }}" class="tsq-success-{{ ai_gen_id }}">
              {{ block.settings.success_message }}
            </div>
          {%- endif -%}

          {% if block.settings.fine_print != blank %}
            <div class="tsq-drops-fine-{{ ai_gen_id }}">{{ block.settings.fine_print }}</div>
          {% endif %}
        </div>
      {%- endform -%}
    {% endif %}
  </div>
</drops-countdown-{{ ai_gen_id }}>

<script>
  (function() {
    class DropsCountdown{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.countdownWrap = this.querySelector('[data-countdown-target]');
        if (!this.countdownWrap) return;
        
        this.targetDate = this.countdownWrap.getAttribute('data-countdown-target');
        if (!this.targetDate) return;

        this.daysEl = this.querySelector('[data-days]');
        this.hoursEl = this.querySelector('[data-hours]');
        this.minutesEl = this.querySelector('[data-minutes]');
        this.secondsEl = this.querySelector('[data-seconds]');
      }

      connectedCallback() {
        if (!this.targetDate) return;
        this.updateCountdown();
        this.interval = setInterval(() => this.updateCountdown(), 1000);
      }

      disconnectedCallback() {
        if (this.interval) {
          clearInterval(this.interval);
        }
      }

      updateCountdown() {
        const now = new Date().getTime();
        const target = new Date(this.targetDate).getTime();
        const distance = target - now;

        if (distance < 0) {
          this.daysEl.textContent = '00';
          this.hoursEl.textContent = '00';
          this.minutesEl.textContent = '00';
          this.secondsEl.textContent = '00';
          clearInterval(this.interval);
          return;
        }

        const days = Math.floor(distance / (1000 * 60 * 60 * 24));
        const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((distance % (1000 * 60)) / 1000);

        this.daysEl.textContent = String(days).padStart(2, '0');
        this.hoursEl.textContent = String(hours).padStart(2, '0');
        this.minutesEl.textContent = String(minutes).padStart(2, '0');
        this.secondsEl.textContent = String(seconds).padStart(2, '0');
      }
    }

    customElements.define('drops-countdown-{{ ai_gen_id }}', DropsCountdown{{ ai_gen_id }});
  })();
</script>

