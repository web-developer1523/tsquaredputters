{% doc %}
  @prompt
    <!-- T Squared — Free Engraving Drop Block -->
    <div style="background-color:#f5f1ea;padding:48px 32px;margin:0;font-family:Arial,sans-serif;text-align:center;">
    
      <!-- Eyebrow -->
      <p style="margin:0 0 10px;font-size:10px;font-weight:700;color:#aaa9a0;letter-spacing:4px;text-transform:uppercase;font-family:Arial,sans-serif;">This Weekend Only</p>
    
      <!-- Headline -->
      <p style="margin:0 0 4px;font-size:38px;font-weight:700;color:#1a1a1a;line-height:1.05;letter-spacing:-0.02em;font-family:Arial,sans-serif;">Free Bumper</p>
      <p style="margin:0 0 20px;font-size:38px;font-weight:700;color:#1a1a1a;line-height:1.05;letter-spacing:-0.02em;font-family:Arial,sans-serif;">Engraving.</p>
    
      <!-- Divider -->
      <table cellpadding="0" cellspacing="0" border="0" align="center" style="margin:0 auto 24px;">
        <tr><td style="width:40px;height:2px;background-color:#1a1a1a;font-size:0;line-height:0;">&nbsp;</td></tr>
      </table>
    
      <!-- Description -->
      <p style="margin:0 auto 16px;font-size:16px;font-weight:400;color:#555555;line-height:1.8;font-family:Arial,sans-serif;max-width:480px;">Order any eligible stock putter from Friday at noon through Sunday at midnight and we will engrave both bumpers free of charge.</p>
      <p style="margin:0 auto 32px;font-size:16px;font-weight:400;color:#555555;line-height:1.8;font-family:Arial,sans-serif;max-width:480px;">Up to 8 characters per bumper — your name, initials, a number, anything you want. Just leave your engraving text in the order notes at checkout.</p>
    
      <!-- Image -->
      <div style="margin:0 auto 32px;max-width:320px;">
        <img src="https://cdn.shopify.com/s/files/1/0597/8855/8523/files/713_bumper.jpg?v=1773343359" alt="Bumper Engraving" style="display:block;width:100%;height:auto;" />
      </div>
    
      <!-- Details box -->
      <table cellpadding="0" cellspacing="0" border="0" align="center" style="margin:0 auto 32px;background-color:#1a1a1a;border:1px solid #2a2a2a;max-width:400px;width:100%;">
        <tr>
          <td style="padding:24px 28px;">
            <p style="margin:0 0 14px;font-size:10px;font-weight:700;color:#aaa9a0;letter-spacing:3px;text-transform:uppercase;font-family:Arial,sans-serif;text-align:center;">Offer Details</p>
            <table cellpadding="0" cellspacing="0" border="0" width="100%">
              <tr>
                <td style="padding:6px 0;border-bottom:1px solid #2a2a2a;font-size:13px;color:#888880;font-family:Arial,sans-serif;">Offer</td>
                <td style="padding:6px 0;border-bottom:1px solid #e8e3db;font-size:13px;color:#ffffff;font-weight:700;font-family:Arial,sans-serif;text-align:right;">Free Bumper Engraving</td>
              </tr>
              <tr>
                <td style="padding:6px 0;border-bottom:1px solid #2a2a2a;font-size:13px;color:#888880;font-family:Arial,sans-serif;">Characters</td>
                <td style="padding:6px 0;border-bottom:1px solid #e8e3db;font-size:13px;color:#ffffff;font-weight:700;font-family:Arial,sans-serif;text-align:right;">Up to 8 per bumper</td>
              </tr>
              <tr>
                <td style="padding:6px 0;border-bottom:1px solid #2a2a2a;font-size:13px;color:#888880;font-family:Arial,sans-serif;">Window</td>
                <td style="padding:6px 0;border-bottom:1px solid #e8e3db;font-size:13px;color:#ffffff;font-weight:700;font-family:Arial,sans-serif;text-align:right;">Fri Noon — Sun Midnight</td>
              </tr>
              <tr>
                <td style="padding:6px 0;border-bottom:1px solid #2a2a2a;font-size:13px;color:#888880;font-family:Arial,sans-serif;">Applies To</td>
                <td style="padding:6px 0;border-bottom:1px solid #e8e3db;font-size:13px;color:#ffffff;font-weight:700;font-family:Arial,sans-serif;text-align:right;">All Stock Putters</td>
              </tr>
              <tr>
                <td style="padding:6px 0;font-size:13px;color:#888880;font-family:Arial,sans-serif;border-bottom:none;">Excludes</td>
                <td style="padding:6px 0;font-size:13px;color:#ffffff;font-weight:700;font-family:Arial,sans-serif;text-align:right;">TS-1106+ / TS-1104 / TS-1029</td>
              </tr>
            </table>
          </td>
        </tr>
      </table>
    
      <!-- CTA -->
      <table cellpadding="0" cellspacing="0" border="0" align="center">
        <tr>
          <td align="center" style="background-color:#1a1a1a;">
            <a href="https://tsquaredputters.com/collections/putters" style="display:inline-block;background-color:#1a1a1a;color:#ffffff;font-family:Arial,sans-serif;font-size:12px;font-weight:700;letter-spacing:3px;text-transform:uppercase;text-decoration:none;padding:18px 48px;">SHOP STOCK PUTTERS &rarr;</a>
          </td>
        </tr>
      </table>
    
      <!-- Fine print -->
      <p style="margin:16px 0 0;font-size:11px;color:#aaa9a0;letter-spacing:1px;font-family:Arial,sans-serif;">Add engraving text in order notes at checkout. Offer ends Sunday at midnight.</p>
    
    </div>
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-promo-block-{{ ai_gen_id }} {
    display: block;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    margin: 0;
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    text-align: center;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-promo-block__eyebrow-{{ ai_gen_id }} {
    margin: 0 0 10px;
    font-size: {{ block.settings.eyebrow_size }}px;
    font-weight: 700;
    color: {{ block.settings.eyebrow_color }};
    letter-spacing: {{ block.settings.eyebrow_spacing }}px;
    text-transform: uppercase;
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
  }

  .ai-promo-block__headline-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.headline_spacing }}px;
    font-size: {{ block.settings.headline_size }}px;
    font-weight: 700;
    color: {{ block.settings.headline_color }};
    line-height: 1.05;
    letter-spacing: -0.02em;
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
  }

  .ai-promo-block__divider-{{ ai_gen_id }} {
    width: {{ block.settings.divider_width }}px;
    height: {{ block.settings.divider_height }}px;
    background-color: {{ block.settings.divider_color }};
    margin: 0 auto {{ block.settings.divider_spacing }}px;
  }

  .ai-promo-block__description-{{ ai_gen_id }} {
    margin: 0 auto {{ block.settings.description_spacing }}px;
    font-size: {{ block.settings.description_size }}px;
    font-weight: 400;
    color: {{ block.settings.description_color }};
    line-height: 1.8;
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    max-width: {{ block.settings.description_max_width }}px;
  }

  .ai-promo-block__image-{{ ai_gen_id }} {
    margin: 0 auto {{ block.settings.image_spacing }}px;
    max-width: {{ block.settings.image_max_width }}px;
  }

  .ai-promo-block__image-{{ ai_gen_id }} img {
    display: block;
    width: 100%;
    height: auto;
  }

  .ai-promo-block__details-{{ ai_gen_id }} {
    margin: 0 auto {{ block.settings.details_spacing }}px;
    background-color: {{ block.settings.details_bg_color }};
    border: 1px solid {{ block.settings.details_border_color }};
    max-width: {{ block.settings.details_max_width }}px;
    width: 100%;
  }

  .ai-promo-block__details-inner-{{ ai_gen_id }} {
    padding: {{ block.settings.details_padding }}px;
  }

  .ai-promo-block__details-header-{{ ai_gen_id }} {
    margin: 0 0 14px;
    font-size: 10px;
    font-weight: 700;
    color: {{ block.settings.details_header_color }};
    letter-spacing: 3px;
    text-transform: uppercase;
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    text-align: center;
  }

  .ai-promo-block__details-row-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    padding: 6px 0;
    border-bottom: 1px solid {{ block.settings.details_row_border }};
    font-size: 13px;
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
  }

  .ai-promo-block__details-row-{{ ai_gen_id }}:last-child {
    border-bottom: none;
  }

  .ai-promo-block__details-label-{{ ai_gen_id }} {
    color: {{ block.settings.details_label_color }};
    text-align: left;
  }

  .ai-promo-block__details-value-{{ ai_gen_id }} {
    color: {{ block.settings.details_value_color }};
    font-weight: 700;
    text-align: right;
  }

  .ai-promo-block__cta-{{ ai_gen_id }} {
    display: inline-block;
    background-color: {{ block.settings.cta_bg_color }};
    color: {{ block.settings.cta_text_color }};
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-size: {{ block.settings.cta_size }}px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    text-decoration: none;
    padding: {{ block.settings.cta_padding_vertical }}px {{ block.settings.cta_padding_horizontal }}px;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .ai-promo-block__cta-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.cta_hover_bg_color }};
    color: {{ block.settings.cta_hover_text_color }};
  }

  .ai-promo-block__fine-print-{{ ai_gen_id }} {
    margin: {{ block.settings.fine_print_spacing }}px 0 0;
    font-size: {{ block.settings.fine_print_size }}px;
    color: {{ block.settings.fine_print_color }};
    letter-spacing: 1px;
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
  }

  @media screen and (max-width: 749px) {
    .ai-promo-block-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_vertical | times: 0.7 }}px {{ block.settings.padding_horizontal | times: 0.7 }}px;
    }

    .ai-promo-block__headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_size | times: 0.7 }}px;
    }

    .ai-promo-block__description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.9 }}px;
    }

    .ai-promo-block__details-max-width-{{ ai_gen_id }} {
      max-width: 100%;
    }
  }
{% endstyle %}

<div class="ai-promo-block-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.eyebrow != blank %}
    <p class="ai-promo-block__eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow }}</p>
  {% endif %}

  {% if block.settings.headline_line_1 != blank %}
    <p class="ai-promo-block__headline-{{ ai_gen_id }}">{{ block.settings.headline_line_1 }}</p>
  {% endif %}

  {% if block.settings.headline_line_2 != blank %}
    <p class="ai-promo-block__headline-{{ ai_gen_id }}">{{ block.settings.headline_line_2 }}</p>
  {% endif %}

  {% if block.settings.show_divider %}
    <div class="ai-promo-block__divider-{{ ai_gen_id }}"></div>
  {% endif %}

  {% if block.settings.description_line_1 != blank %}
    <p class="ai-promo-block__description-{{ ai_gen_id }}">{{ block.settings.description_line_1 }}</p>
  {% endif %}

  {% if block.settings.description_line_2 != blank %}
    <p class="ai-promo-block__description-{{ ai_gen_id }}">{{ block.settings.description_line_2 }}</p>
  {% endif %}

  {% if block.settings.image %}
    <div class="ai-promo-block__image-{{ ai_gen_id }}">
      <img
        src="{{ block.settings.image | image_url: width: 640 }}"
        alt="{{ block.settings.image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.image.width }}"
        height="{{ block.settings.image.height }}"
      >
    </div>
  {% endif %}

  {% if block.settings.show_details %}
    <div class="ai-promo-block__details-{{ ai_gen_id }}">
      <div class="ai-promo-block__details-inner-{{ ai_gen_id }}">
        {% if block.settings.details_header != blank %}
          <p class="ai-promo-block__details-header-{{ ai_gen_id }}">{{ block.settings.details_header }}</p>
        {% endif %}

        {% if block.settings.detail_1_label != blank and block.settings.detail_1_value != blank %}
          <div class="ai-promo-block__details-row-{{ ai_gen_id }}">
            <span class="ai-promo-block__details-label-{{ ai_gen_id }}">{{ block.settings.detail_1_label }}</span>
            <span class="ai-promo-block__details-value-{{ ai_gen_id }}">{{ block.settings.detail_1_value }}</span>
          </div>
        {% endif %}

        {% if block.settings.detail_2_label != blank and block.settings.detail_2_value != blank %}
          <div class="ai-promo-block__details-row-{{ ai_gen_id }}">
            <span class="ai-promo-block__details-label-{{ ai_gen_id }}">{{ block.settings.detail_2_label }}</span>
            <span class="ai-promo-block__details-value-{{ ai_gen_id }}">{{ block.settings.detail_2_value }}</span>
          </div>
        {% endif %}

        {% if block.settings.detail_3_label != blank and block.settings.detail_3_value != blank %}
          <div class="ai-promo-block__details-row-{{ ai_gen_id }}">
            <span class="ai-promo-block__details-label-{{ ai_gen_id }}">{{ block.settings.detail_3_label }}</span>
            <span class="ai-promo-block__details-value-{{ ai_gen_id }}">{{ block.settings.detail_3_value }}</span>
          </div>
        {% endif %}

        {% if block.settings.detail_4_label != blank and block.settings.detail_4_value != blank %}
          <div class="ai-promo-block__details-row-{{ ai_gen_id }}">
            <span class="ai-promo-block__details-label-{{ ai_gen_id }}">{{ block.settings.detail_4_label }}</span>
            <span class="ai-promo-block__details-value-{{ ai_gen_id }}">{{ block.settings.detail_4_value }}</span>
          </div>
        {% endif %}

        {% if block.settings.detail_5_label != blank and block.settings.detail_5_value != blank %}
          <div class="ai-promo-block__details-row-{{ ai_gen_id }}">
            <span class="ai-promo-block__details-label-{{ ai_gen_id }}">{{ block.settings.detail_5_label }}</span>
            <span class="ai-promo-block__details-value-{{ ai_gen_id }}">{{ block.settings.detail_5_value }}</span>
          </div>
        {% endif %}
      </div>
    </div>
  {% endif %}

  {% if block.settings.cta_text != blank and block.settings.cta_url != blank %}
    <a href="{{ block.settings.cta_url }}" class="ai-promo-block__cta-{{ ai_gen_id }}">
      {{ block.settings.cta_text }}
    </a>
  {% endif %}

  {% if block.settings.fine_print != blank %}
    <p class="ai-promo-block__fine-print-{{ ai_gen_id }}">{{ block.settings.fine_print }}</p>
  {% endif %}
</div>

