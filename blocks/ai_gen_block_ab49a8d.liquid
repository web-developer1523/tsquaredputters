{% doc %}
  @prompt
    Create a full-width closing section with a refined LAB × Apple aesthetic.
    
    Tone:
    Industrial precision meets minimal design confidence.
    Calm, restrained, not promotional.
    No marketing hype.
    No patriotic shouting.
    
    Layout:
    Full-width background image with subtle dark overlay for text readability.
    Centered text block.
    Generous vertical spacing.
    Clean typography.
    No red buttons.
    No heavy gradients.
    
    Content:
    
    Small eyebrow text:
    “Origin”
    
    Headline:
    “Made where it matters. Buffalo, New York.”
    
    Subtext (short, not a paragraph):
    Designed, milled, and assembled in our Buffalo shop.
    One goal: precision.
    
    Primary button:
    “Our Process”
    Style: Outline button, thin border, black or white depending on background.
    No red fill.
    
    Design rules:
    
    Use sentence case, not all caps.
    
    Keep line length narrow for readability.
    
    Plenty of whitespace.
    
    Text should feel grounded and confident.
    
    This section should feel like the closing statement of the brand story.
    
    The overall aesthetic should align with a blend of LAB Golf engineering authority and Apple-level restraint.
    
    After it generates:
    
    • Reduce overlay until image still feels strong.
    • Make sure headline isn’t overly bold.
    • Increase spacing above and below.
    • Remove any decorative icons Shopify tries to add.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-origin-section-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    min-height: {{ block.settings.section_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .ai-origin-section__background-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .ai-origin-section__background-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-origin-section__background-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #e5e5e5;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-origin-section__background-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 600px;
    max-height: 600px;
    opacity: 0.3;
  }

  .ai-origin-section__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 2;
  }

  .ai-origin-section__content-{{ ai_gen_id }} {
    position: relative;
    z-index: 3;
    text-align: center;
    max-width: {{ block.settings.content_max_width }}px;
    padding: {{ block.settings.vertical_spacing }}px 40px;
    margin: 0 auto;
  }

  .ai-origin-section__eyebrow-{{ ai_gen_id }} {
    font-size: {{ block.settings.eyebrow_size }}px;
    letter-spacing: {{ block.settings.eyebrow_spacing }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 {{ block.settings.eyebrow_margin }}px;
    font-weight: 400;
    opacity: 0.8;
  }

  .ai-origin-section__headline-{{ ai_gen_id }} {
    font-size: {{ block.settings.headline_size }}px;
    line-height: {{ block.settings.headline_line_height }};
    color: {{ block.settings.text_color }};
    margin: 0 0 {{ block.settings.headline_margin }}px;
    font-weight: {{ block.settings.headline_weight }};
    letter-spacing: {{ block.settings.headline_spacing }}px;
  }

  .ai-origin-section__subtext-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtext_size }}px;
    line-height: {{ block.settings.subtext_line_height }};
    color: {{ block.settings.text_color }};
    margin: 0 0 {{ block.settings.subtext_margin }}px;
    font-weight: 300;
    opacity: 0.9;
    max-width: {{ block.settings.subtext_max_width }}px;
    margin-left: auto;
    margin-right: auto;
  }

  .ai-origin-section__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    font-size: {{ block.settings.button_size }}px;
    color: {{ block.settings.button_text_color }};
    background-color: {{ block.settings.button_background }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    text-decoration: none;
    transition: all 0.2s ease;
    letter-spacing: {{ block.settings.button_letter_spacing }}px;
    font-weight: {{ block.settings.button_weight }};
  }

  .ai-origin-section__button-{{ ai_gen_id }}:hover {
    color: {{ block.settings.button_hover_text_color }};
    background-color: {{ block.settings.button_hover_background }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-origin-section-{{ ai_gen_id }} {
      min-height: {{ block.settings.section_height | times: 0.7 }}px;
    }

    .ai-origin-section__content-{{ ai_gen_id }} {
      padding: {{ block.settings.vertical_spacing | times: 0.7 }}px 24px;
    }

    .ai-origin-section__eyebrow-{{ ai_gen_id }} {
      font-size: {{ block.settings.eyebrow_size | times: 0.9 }}px;
    }

    .ai-origin-section__headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_size | times: 0.7 }}px;
    }

    .ai-origin-section__subtext-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtext_size | times: 0.9 }}px;
    }

    .ai-origin-section__button-{{ ai_gen_id }} {
      font-size: {{ block.settings.button_size | times: 0.9 }}px;
      padding: {{ block.settings.button_padding_vertical | times: 0.9 }}px {{ block.settings.button_padding_horizontal | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-origin-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-origin-section__background-{{ ai_gen_id }}">
    {% if block.settings.background_image %}
      <img
        src="{{ block.settings.background_image | image_url: width: 2400 }}"
        alt="{{ block.settings.background_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.background_image.width }}"
        height="{{ block.settings.background_image.height }}"
      >
    {% else %}
      <div class="ai-origin-section__background-placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>

  <div class="ai-origin-section__overlay-{{ ai_gen_id }}"></div>

  <div class="ai-origin-section__content-{{ ai_gen_id }}">
    {% if block.settings.eyebrow_text != blank %}
      <div class="ai-origin-section__eyebrow-{{ ai_gen_id }}">
        {{ block.settings.eyebrow_text }}
      </div>
    {% endif %}

    {% if block.settings.headline_text != blank %}
      <h2 class="ai-origin-section__headline-{{ ai_gen_id }}">
        {{ block.settings.headline_text }}
      </h2>
    {% endif %}

    {% if block.settings.subtext != blank %}
      <div class="ai-origin-section__subtext-{{ ai_gen_id }}">
        {{ block.settings.subtext }}
      </div>
    {% endif %}

    {% if block.settings.button_text != blank and block.settings.button_link != blank %}
      <a
        href="{{ block.settings.button_link }}"
        class="ai-origin-section__button-{{ ai_gen_id }}"
      >
        {{ block.settings.button_text }}
      </a>
    {% endif %}
  </div>
</div>

