{% doc %}
  @prompt
    Create a custom homepage section titled “Our Putters.”
    
    The section should display two putter model cards side-by-side on desktop and one per row on mobile.
    
    Each card must include:
    
    A large centered product image of the putter head
    
    The model name (example: DF3.1, OZ.1i HS) in bold
    
    A short one-sentence description below the model name
    
    Left and right arrow buttons on each card to cycle through different putter models within that card
    
    Behavior & layout requirements:
    
    Clicking arrows changes the image, model name, and description without reloading the page
    
    Clean, modern, dark background styling similar to a premium golf brand
    
    Images remain perfectly centered and do not stretch
    
    Text is high-contrast and easy to read
    
    Section should feel minimal, high-end, and performance-focused
    
    Admin customization:
    
    Ability to add/edit models, images, and descriptions directly in the theme editor
    
    Ability to choose how many models appear in each card, dont put them in two cards make each model have its own card and has a build your and discover buttom on the bottom, there needs to be 8 cards and i would like them to scrollable from right to left not stacked 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-putters-section-{{ ai_gen_id }} {
    display: block;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 0;
    width: 100%;
    overflow: hidden;
  }

  .ai-putters-container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-putters-heading-{{ ai_gen_id }} {
    text-align: center;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    font-weight: 700;
    letter-spacing: 1px;
  }

  .ai-putters-scroll-wrapper-{{ ai_gen_id }} {
    position: relative;
    margin: 0 -20px;
    padding: 0 20px;
  }

  .ai-putters-grid-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.card_gap }}px;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: {{ block.settings.scrollbar_color }} {{ block.settings.scrollbar_track }};
    padding-bottom: 20px;
  }

  .ai-putters-grid-{{ ai_gen_id }}::-webkit-scrollbar {
    height: 8px;
  }

  .ai-putters-grid-{{ ai_gen_id }}::-webkit-scrollbar-track {
    background: {{ block.settings.scrollbar_track }};
    border-radius: 4px;
  }

  .ai-putters-grid-{{ ai_gen_id }}::-webkit-scrollbar-thumb {
    background: {{ block.settings.scrollbar_color }};
    border-radius: 4px;
  }

  .ai-putters-grid-{{ ai_gen_id }}::-webkit-scrollbar-thumb:hover {
    background: {{ block.settings.scrollbar_hover }};
  }

  .ai-putter-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    display: flex;
    flex-direction: column;
    min-width: {{ block.settings.card_width }}px;
    flex-shrink: 0;
  }

  .ai-putter-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.image_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
    background-color: {{ block.settings.image_background }};
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-putter-image-{{ ai_gen_id }} {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
  }

  .ai-putter-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.image_background }};
  }

  .ai-putter-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-putter-info-{{ ai_gen_id }} {
    text-align: center;
    flex-grow: 1;
    margin-bottom: 24px;
  }

  .ai-putter-model-{{ ai_gen_id }} {
    font-size: {{ block.settings.model_size }}px;
    font-weight: 700;
    color: {{ block.settings.text_color }};
    margin: 0 0 12px;
    letter-spacing: 0.5px;
  }

  .ai-putter-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.5;
    margin: 0;
  }

  .ai-putter-buttons-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
    margin-top: auto;
  }

  .ai-putter-button-{{ ai_gen_id }} {
    flex: 1;
    padding: {{ block.settings.button_padding }}px;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;
    border: 2px solid transparent;
    display: inline-block;
  }

  .ai-putter-button-build-{{ ai_gen_id }} {
    background-color: {{ block.settings.build_button_bg }};
    color: {{ block.settings.build_button_text_color }};
    border-color: {{ block.settings.build_button_border }};
  }

  .ai-putter-button-build-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.build_button_hover_bg }};
    color: {{ block.settings.build_button_hover_text }};
    border-color: {{ block.settings.build_button_hover_border }};
    transform: translateY(-2px);
  }

  .ai-putter-button-discover-{{ ai_gen_id }} {
    background-color: {{ block.settings.discover_button_bg }};
    color: {{ block.settings.discover_button_text_color }};
    border-color: {{ block.settings.discover_button_border }};
  }

  .ai-putter-button-discover-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.discover_button_hover_bg }};
    color: {{ block.settings.discover_button_hover_text }};
    border-color: {{ block.settings.discover_button_hover_border }};
    transform: translateY(-2px);
  }

  @media screen and (max-width: 768px) {
    .ai-putters-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-putter-card-{{ ai_gen_id }} {
      min-width: {{ block.settings.card_width | times: 0.85 }}px;
    }

    .ai-putter-image-wrapper-{{ ai_gen_id }} {
      height: {{ block.settings.image_height | times: 0.7 }}px;
    }

    .ai-putter-model-{{ ai_gen_id }} {
      font-size: {{ block.settings.model_size | times: 0.8 }}px;
    }

    .ai-putter-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.9 }}px;
    }

    .ai-putter-buttons-{{ ai_gen_id }} {
      flex-direction: column;
    }
  }
{% endstyle %}

<div class="ai-putters-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-putters-container-{{ ai_gen_id }}">
    {% if block.settings.section_heading != blank %}
      <h2 class="ai-putters-heading-{{ ai_gen_id }}">{{ block.settings.section_heading }}</h2>
    {% endif %}
  </div>

  <div class="ai-putters-scroll-wrapper-{{ ai_gen_id }}">
    <div class="ai-putters-grid-{{ ai_gen_id }}">
      {% for i in (1..8) %}
        {% assign image_key = 'model_' | append: i | append: '_image' %}
        {% assign name_key = 'model_' | append: i | append: '_name' %}
        {% assign desc_key = 'model_' | append: i | append: '_description' %}
        {% assign build_link_key = 'model_' | append: i | append: '_build_link' %}
        {% assign discover_link_key = 'model_' | append: i | append: '_discover_link' %}
        {% assign enabled_key = 'model_' | append: i | append: '_enabled' %}
        
        {% if block.settings[enabled_key] %}
          <div class="ai-putter-card-{{ ai_gen_id }}">
            <div class="ai-putter-image-wrapper-{{ ai_gen_id }}">
              {% if block.settings[image_key] %}
                <img 
                  src="{{ block.settings[image_key] | image_url: width: 800 }}"
                  alt="{{ block.settings[name_key] | escape }}"
                  class="ai-putter-image-{{ ai_gen_id }}"
                  loading="lazy"
                >
              {% else %}
                <div class="ai-putter-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            <div class="ai-putter-info-{{ ai_gen_id }}">
              <h3 class="ai-putter-model-{{ ai_gen_id }}">
                {% if block.settings[name_key] != blank %}
                  {{ block.settings[name_key] }}
                {% else %}
                  Model {{ i }}
                {% endif %}
              </h3>
              <p class="ai-putter-description-{{ ai_gen_id }}">
                {% if block.settings[desc_key] != blank %}
                  {{ block.settings[desc_key] }}
                {% else %}
                  Premium putter crafted for precision and performance.
                {% endif %}
              </p>
            </div>

            <div class="ai-putter-buttons-{{ ai_gen_id }}">
              <a 
                href="{% if block.settings[build_link_key] != blank %}{{ block.settings[build_link_key] }}{% else %}#{% endif %}"
                class="ai-putter-button-{{ ai_gen_id }} ai-putter-button-build-{{ ai_gen_id }}"
              >
                {{ block.settings.build_button_label }}
              </a>
              <a 
                href="{% if block.settings[discover_link_key] != blank %}{{ block.settings[discover_link_key] }}{% else %}#{% endif %}"
                class="ai-putter-button-{{ ai_gen_id }} ai-putter-button-discover-{{ ai_gen_id }}"
              >
                {{ block.settings.discover_button_label }}
              </a>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

