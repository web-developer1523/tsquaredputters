{% doc %}
  @prompt
    <!-- T Squared Putters — Drops Page -->
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500;600&display=swap');
    
      .tsq-drops-wrap * { box-sizing: border-box; margin: 0; padding: 0; }
    
      .tsq-drops-wrap {
        font-family: 'DM Sans', sans-serif;
        background: #0a0a0a;
        color: #f0ede6;
        padding: 64px 24px 80px;
        text-align: center;
        position: relative;
        overflow: hidden;
      }
    
      .tsq-drops-wrap::before {
        content: '';
        position: absolute;
        inset: 0;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
        opacity: 0.35;
        pointer-events: none;
        z-index: 0;
      }
    
      .tsq-drops-inner {
        position: relative;
        z-index: 1;
        max-width: 680px;
        margin: 0 auto;
      }
    
      .tsq-drops-eyebrow {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: #888880;
        margin-bottom: 20px;
      }
    
      .tsq-drops-headline {
        font-family: 'Bebas Neue', sans-serif;
        font-size: clamp(72px, 14vw, 120px);
        line-height: 0.92;
        letter-spacing: 0.02em;
        color: #f0ede6;
        margin-bottom: 8px;
      }
    
      .tsq-drops-headline span {
        display: block;
        color: #e31b1b;
      }
    
      .tsq-drops-rule {
        width: 40px;
        height: 2px;
        background: #e31b1b;
        margin: 32px auto;
      }
    
      .tsq-drops-body {
        font-size: 16px;
        font-weight: 300;
        line-height: 1.8;
        color: #b0aca3;
        max-width: 480px;
        margin: 0 auto 40px;
      }
    
      .tsq-drops-body strong {
        color: #f0ede6;
        font-weight: 500;
      }
    
      .tsq-countdown-wrap {
        display: flex;
        justify-content: center;
        gap: 24px;
        margin: 40px auto;
      }
    
      .tsq-countdown-block {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
      }
    
      .tsq-countdown-num {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 52px;
        line-height: 1;
        color: #f0ede6;
        min-width: 70px;
        background: #161616;
        border: 1px solid #2a2a2a;
        padding: 12px 16px;
        letter-spacing: 0.04em;
      }
    
      .tsq-countdown-label {
        font-size: 9px;
        font-weight: 600;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: #555550;
      }
    
      .tsq-next-drop {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #161616;
        border: 1px solid #2a2a2a;
        padding: 10px 20px;
        margin-bottom: 40px;
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #888880;
      }
    
      .tsq-next-drop-dot {
        width: 7px;
        height: 7px;
        background: #e31b1b;
        border-radius: 50%;
        animation: tsq-pulse 1.8s ease-in-out infinite;
      }
    
      @keyframes tsq-pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.4; transform: scale(0.8); }
      }
    
      /* Waitlist Form */
      .tsq-form-wrap {
        max-width: 420px;
        margin: 0 auto 16px;
        text-align: left;
      }
    
      .tsq-form-section-label {
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: #888880;
        margin-bottom: 16px;
        text-align: center;
      }
    
      .tsq-form-row {
        margin-bottom: 10px;
      }
    
      .tsq-input {
        width: 100%;
        background: #ffffff;
        border: 2px solid #ffffff;
        color: #0a0a0a;
        font-family: 'DM Sans', sans-serif;
        font-size: 15px;
        font-weight: 500;
        padding: 16px 18px;
        outline: none;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
        -webkit-appearance: none;
        border-radius: 0;
      }
    
      .tsq-input::placeholder {
        color: #999999;
        font-weight: 400;
      }
    
      .tsq-input:focus {
        border-color: #e31b1b;
        box-shadow: 0 0 0 3px rgba(227, 27, 27, 0.15);
      }
    
      .tsq-submit {
        width: 100%;
        background: #e31b1b;
        color: #ffffff;
        font-family: 'DM Sans', sans-serif;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        border: none;
        padding: 18px 40px;
        margin-top: 6px;
        cursor: pointer;
        transition: background 0.2s ease, transform 0.15s ease;
      }
    
      .tsq-submit:hover {
        background: #ff2a2a;
        transform: translateY(-1px);
      }
    
      .tsq-drops-fine {
        font-size: 11px;
        color: #555550;
        margin-top: 14px;
        letter-spacing: 0.05em;
      }
    
      .tsq-drops-history {
        margin-top: 64px;
        padding-top: 40px;
        border-top: 1px solid #1e1e1e;
      }
    
      .tsq-drops-history-label {
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: #444440;
        margin-bottom: 16px;
      }
    
      .tsq-drops-history-item {
        font-size: 13px;
        color: #444440;
        padding: 10px 0;
        border-bottom: 1px solid #1a1a1a;
        display: flex;
        justif, <div style="margin-top:64px;padding-top:40px;border-top:1px solid #1e1e1e;">
      <p style="font-size:10px;font-weight:600;letter-spacing:0.2em;text-transform:uppercase;color:#444440;margin-bottom:16px;text-align:center;">Previous Drops</p>
      <div style="font-size:13px;color:#444440;padding:10px 0;border-bottom:1px solid #1a1a1a;display:flex;justify-content:space-between;max-width:400px;margin:0 auto;">
        <span>T-Zero Putter — 001–025</span>
        <span style="font-size:10px;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;color:#e31b1b;">Closed</span>
      </div>
      <div style="font-size:13px;color:#444440;padding:10px 0;border-bottom:1px solid #1a1a1a;display:flex;justify-content:space-between;max-width:400px;margin:0 auto;">
        <span>All Black USA Edition — TS-1029</span>
        <span style="font-size:10px;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;color:#e31b1b;">Closed</span>
      </div>
      <div style="font-size:13px;color:#444440;padding:10px 0;border-bottom:none;display:flex;justify-content:space-between;max-width:400px;margin:0 auto;">
        <span>TS-912 Founder's Edition</span>
        <span style="font-size:10px;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;color:#e31b1b;">Closed</span>
      </div>
    </div>, need a secion for phone number under email adress all feilds are required
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .tsq-drops-wrap-{{ ai_gen_id }} * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  .tsq-drops-wrap-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, sans-serif;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
    text-align: center;
    position: relative;
    overflow: hidden;
    display: block;
    width: 100%;
  }

  .tsq-drops-wrap-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
    opacity: {{ block.settings.noise_opacity | divided_by: 100.0 }};
    pointer-events: none;
    z-index: 0;
  }

  .tsq-drops-inner-{{ ai_gen_id }} {
    position: relative;
    z-index: 1;
    max-width: {{ block.settings.content_max_width }}px;
    margin: 0 auto;
  }

  .tsq-drops-eyebrow-{{ ai_gen_id }} {
    font-size: {{ block.settings.eyebrow_size }}px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: {{ block.settings.eyebrow_color }};
    margin-bottom: 20px;
  }

  .tsq-drops-headline-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, sans-serif;
    font-size: {{ block.settings.headline_size }}px;
    line-height: 0.92;
    letter-spacing: 0.02em;
    color: {{ block.settings.headline_color }};
    margin-bottom: 8px;
  }

  .tsq-drops-headline-{{ ai_gen_id }} span {
    display: block;
    color: {{ block.settings.headline_accent_color }};
  }

  .tsq-drops-rule-{{ ai_gen_id }} {
    width: {{ block.settings.divider_width }}px;
    height: {{ block.settings.divider_height }}px;
    background: {{ block.settings.divider_color }};
    margin: 32px auto;
  }

  .tsq-drops-body-{{ ai_gen_id }} {
    font-size: {{ block.settings.body_size }}px;
    font-weight: 300;
    line-height: 1.8;
    color: {{ block.settings.body_text_color }};
    max-width: 480px;
    margin: 0 auto 40px;
  }

  .tsq-drops-body-{{ ai_gen_id }} strong {
    color: {{ block.settings.text_color }};
    font-weight: 500;
  }

  .tsq-countdown-wrap-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 24px;
    margin: 40px auto;
    flex-wrap: wrap;
  }

  .tsq-countdown-block-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .tsq-countdown-num-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, sans-serif;
    font-size: {{ block.settings.countdown_size }}px;
    line-height: 1;
    color: {{ block.settings.countdown_text_color }};
    min-width: 70px;
    background: {{ block.settings.countdown_bg_color }};
    border: 1px solid {{ block.settings.countdown_border_color }};
    padding: 12px 16px;
    letter-spacing: 0.04em;
  }

  .tsq-countdown-label-{{ ai_gen_id }} {
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: {{ block.settings.countdown_label_color }};
  }

  .tsq-next-drop-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: {{ block.settings.badge_bg_color }};
    border: 1px solid {{ block.settings.badge_border_color }};
    padding: 10px 20px;
    margin-bottom: 40px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: {{ block.settings.badge_text_color }};
  }

  .tsq-next-drop-dot-{{ ai_gen_id }} {
    width: 7px;
    height: 7px;
    background: {{ block.settings.badge_dot_color }};
    border-radius: 50%;
  }

  .tsq-form-wrap-{{ ai_gen_id }} {
    max-width: 420px;
    margin: 0 auto 16px;
    text-align: left;
  }

  .tsq-form-section-label-{{ ai_gen_id }} {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: {{ block.settings.form_label_color }};
    margin-bottom: 16px;
    text-align: center;
  }

  .tsq-form-row-{{ ai_gen_id }} {
    margin-bottom: 10px;
  }

  .tsq-input-{{ ai_gen_id }} {
    width: 100%;
    background: {{ block.settings.input_bg_color }};
    border: 2px solid {{ block.settings.input_border_color }};
    color: {{ block.settings.input_text_color }};
    font-family: {{ block.settings.body_font.family }}, sans-serif;
    font-size: 15px;
    font-weight: 500;
    padding: 16px 18px;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    -webkit-appearance: none;
    border-radius: 0;
  }

  .tsq-input-{{ ai_gen_id }}::placeholder {
    color: {{ block.settings.input_placeholder_color }};
    font-weight: 400;
  }

  .tsq-input-{{ ai_gen_id }}:focus {
    border-color: {{ block.settings.input_focus_border_color }};
    box-shadow: 0 0 0 3px {{ block.settings.input_focus_border_color | color_modify: 'alpha', 0.15 }};
  }

  .tsq-submit-{{ ai_gen_id }} {
    width: 100%;
    background: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    font-family: {{ block.settings.body_font.family }}, sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    border: none;
    padding: 18px 40px;
    margin-top: 6px;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.15s ease;
  }

  .tsq-submit-{{ ai_gen_id }}:hover {
    background: {{ block.settings.button_hover_bg_color }};
    transform: translateY(-1px);
  }

  .tsq-drops-fine-{{ ai_gen_id }} {
    font-size: 11px;
    color: {{ block.settings.fine_print_color }};
    margin-top: 14px;
    letter-spacing: 0.05em;
  }

  .tsq-form-success-{{ ai_gen_id }} {
    color: {{ block.settings.success_color }};
    margin-top: 12px;
    font-size: 14px;
    text-align: center;
  }

  .tsq-form-error-{{ ai_gen_id }} {
    color: {{ block.settings.error_color }};
    margin-top: 8px;
    font-size: 13px;
  }

  .tsq-drops-history-{{ ai_gen_id }} {
    margin-top: 64px;
    padding-top: 40px;
    border-top: 1px solid {{ block.settings.history_border_color }};
  }

  .tsq-drops-history-label-{{ ai_gen_id }} {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: {{ block.settings.history_label_color }};
    margin-bottom: 16px;
  }

  .tsq-drops-history-item-{{ ai_gen_id }} {
    font-size: 13px;
    color: {{ block.settings.history_item_color }};
    padding: 10px 0;
    border-bottom: 1px solid {{ block.settings.history_item_border_color }};
    display: flex;
    justify-content: space-between;
    max-width: 400px;
    margin: 0 auto;
  }

  .tsq-drops-history-item-{{ ai_gen_id }}:last-child {
    border-bottom: none;
  }

  .tsq-drops-history-status-{{ ai_gen_id }} {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: {{ block.settings.history_status_color }};
  }

  @media screen and (max-width: 749px) {
    .tsq-drops-wrap-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.6 }}px {{ block.settings.padding_horizontal | times: 0.6 }}px {{ block.settings.padding_bottom | times: 0.6 }}px;
    }

    .tsq-drops-headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_size | times: 0.6 }}px;
    }

    .tsq-countdown-num-{{ ai_gen_id }} {
      font-size: {{ block.settings.countdown_size | times: 0.75 }}px;
      min-width: 55px;
      padding: 10px 12px;
    }

    .tsq-countdown-wrap-{{ ai_gen_id }} {
      gap: 16px;
    }

    .tsq-drops-history-item-{{ ai_gen_id }} {
      font-size: 12px;
      flex-direction: column;
      gap: 6px;
    }
  }
{% endstyle %}

<drops-countdown-{{ ai_gen_id }} class="tsq-drops-wrap-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="tsq-drops-inner-{{ ai_gen_id }}">
    {% if block.settings.eyebrow != blank %}
      <div class="tsq-drops-eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow }}</div>
    {% endif %}

    {% if block.settings.headline != blank %}
      <h1 class="tsq-drops-headline-{{ ai_gen_id }}">
        {{ block.settings.headline }}
        {% if block.settings.headline_accent != blank %}
          <span>{{ block.settings.headline_accent }}</span>
        {% endif %}
      </h1>
    {% endif %}

    <div class="tsq-drops-rule-{{ ai_gen_id }}"></div>

    {% if block.settings.body_text != blank %}
      <div class="tsq-drops-body-{{ ai_gen_id }}">{{ block.settings.body_text }}</div>
    {% endif %}

    {% if block.settings.show_countdown %}
      <div class="tsq-countdown-wrap-{{ ai_gen_id }}">
        <div class="tsq-countdown-block-{{ ai_gen_id }}">
          <div class="tsq-countdown-num-{{ ai_gen_id }}" data-countdown-days>00</div>
          <div class="tsq-countdown-label-{{ ai_gen_id }}">Days</div>
        </div>
        <div class="tsq-countdown-block-{{ ai_gen_id }}">
          <div class="tsq-countdown-num-{{ ai_gen_id }}" data-countdown-hours>00</div>
          <div class="tsq-countdown-label-{{ ai_gen_id }}">Hours</div>
        </div>
        <div class="tsq-countdown-block-{{ ai_gen_id }}">
          <div class="tsq-countdown-num-{{ ai_gen_id }}" data-countdown-minutes>00</div>
          <div class="tsq-countdown-label-{{ ai_gen_id }}">Minutes</div>
        </div>
        <div class="tsq-countdown-block-{{ ai_gen_id }}">
          <div class="tsq-countdown-num-{{ ai_gen_id }}" data-countdown-seconds>00</div>
          <div class="tsq-countdown-label-{{ ai_gen_id }}">Seconds</div>
        </div>
      </div>
    {% endif %}

    {% if block.settings.show_badge %}
      <div class="tsq-next-drop-{{ ai_gen_id }}">
        <span class="tsq-next-drop-dot-{{ ai_gen_id }}"></span>
        {{ block.settings.badge_text }}
      </div>
    {% endif %}

    {% if block.settings.show_form %}
      {%- form 'contact' -%}
        <input type="hidden" name="contact[waitlist_drop]" value="{{ block.settings.drop_name }}">
        <div class="tsq-form-wrap-{{ ai_gen_id }}">
          {% if block.settings.form_label != blank %}
            <div class="tsq-form-section-label-{{ ai_gen_id }}">{{ block.settings.form_label }}</div>
          {% endif %}

          <div class="tsq-form-row-{{ ai_gen_id }}">
            <input
              type="text"
              name="contact[first_name]"
              class="tsq-input-{{ ai_gen_id }}"
              placeholder="{{ block.settings.first_name_placeholder }}"
              value="{{ form.first_name }}"
              required
              aria-required="true"
              {% if form.errors %}
                aria-invalid="true"
              {% endif %}
            >
          </div>

          <div class="tsq-form-row-{{ ai_gen_id }}">
            <input
              type="email"
              name="contact[email]"
              class="tsq-input-{{ ai_gen_id }}"
              placeholder="{{ block.settings.email_placeholder }}"
              value="{{ form.email }}"
              aria-required="true"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              required
              {% if form.errors %}
                aria-invalid="true"
                aria-describedby="tsq-form-error-{{ ai_gen_id }}"
              {% endif %}
              {% if form.posted_successfully? %}
                aria-describedby="tsq-form-success-{{ ai_gen_id }}"
              {% endif %}
            >
            {%- if form.errors -%}
              <div id="tsq-form-error-{{ ai_gen_id }}" class="tsq-form-error-{{ ai_gen_id }}">
                {{ form.errors.messages.email }}
              </div>
            {%- endif -%}
          </div>

          <div class="tsq-form-row-{{ ai_gen_id }}">
            <input
              type="tel"
              name="contact[phone]"
              class="tsq-input-{{ ai_gen_id }}"
              placeholder="{{ block.settings.phone_placeholder }}"
              value="{{ form.phone }}"
              aria-required="true"
              autocomplete="tel"
              required
              {% if form.errors %}
                aria-invalid="true"
              {% endif %}
            >
          </div>

          <button type="submit" class="tsq-submit-{{ ai_gen_id }}">
            {{ block.settings.button_text }}
          </button>

          {%- if form.posted_successfully? -%}
            <div id="tsq-form-success-{{ ai_gen_id }}" class="tsq-form-success-{{ ai_gen_id }}">
              {{ block.settings.success_message }}
            </div>
          {%- endif -%}

          {% if block.settings.fine_print != blank %}
            <div class="tsq-drops-fine-{{ ai_gen_id }}">{{ block.settings.fine_print }}</div>
          {% endif %}
        </div>
      {%- endform -%}
    {% endif %}

    {% if block.settings.show_history %}
      <div class="tsq-drops-history-{{ ai_gen_id }}">
        {% if block.settings.history_label != blank %}
          <div class="tsq-drops-history-label-{{ ai_gen_id }}">{{ block.settings.history_label }}</div>
        {% endif %}

        {% for i in (1..5) %}
          {% liquid
            assign drop_name_key = 'history_drop_' | append: i | append: '_name'
            assign drop_status_key = 'history_drop_' | append: i | append: '_status'
            assign drop_name = block.settings[drop_name_key]
            assign drop_status = block.settings[drop_status_key]
          %}

          {% if drop_name != blank %}
            <div class="tsq-drops-history-item-{{ ai_gen_id }}">
              <span>{{ drop_name }}</span>
              <span class="tsq-drops-history-status-{{ ai_gen_id }}">{{ drop_status }}</span>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</drops-countdown-{{ ai_gen_id }}>

<script>
  (function() {
    class DropsCountdown{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.targetDate = null;
      }

      connectedCallback() {
        const dateString = '{{ block.settings.countdown_date }}';
        const timeString = '{{ block.settings.countdown_time }}';

        if (dateString && timeString) {
          this.targetDate = new Date(dateString + 'T' + timeString);
          this.startCountdown();
        }
      }

      startCountdown() {
        this.updateCountdown();
        this.interval = setInterval(() => this.updateCountdown(), 1000);
      }

      updateCountdown() {
        const now = new Date().getTime();
        const distance = this.targetDate - now;

        if (distance < 0) {
          clearInterval(this.interval);
          this.setCountdownValues(0, 0, 0, 0);
          return;
        }

        const days = Math.floor(distance / (1000 * 60 * 60 * 24));
        const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((distance % (1000 * 60)) / 1000);

        this.setCountdownValues(days, hours, minutes, seconds);
      }

      setCountdownValues(days, hours, minutes, seconds) {
        const daysEl = this.querySelector('[data-countdown-days]');
        const hoursEl = this.querySelector('[data-countdown-hours]');
        const minutesEl = this.querySelector('[data-countdown-minutes]');
        const secondsEl = this.querySelector('[data-countdown-seconds]');

        if (daysEl) daysEl.textContent = String(days).padStart(2, '0');
        if (hoursEl) hoursEl.textContent = String(hours).padStart(2, '0');
        if (minutesEl) minutesEl.textContent = String(minutes).padStart(2, '0');
        if (secondsEl) secondsEl.textContent = String(seconds).padStart(2, '0');
      }

      disconnectedCallback() {
        if (this.interval) {
          clearInterval(this.interval);
        }
      }
    }

    customElements.define('drops-countdown-{{ ai_gen_id }}', DropsCountdown{{ ai_gen_id }});
  })();
</script>

