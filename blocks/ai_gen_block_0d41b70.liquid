{% doc %}
  @prompt
    Create a premium dark product grid section with background color #0E0E0E.
    
    The TS-912 should appear first and span two columns so it feels visually dominant, but do not add any badges, labels, or additional text. Keep the product name and description exactly as they are.
    
    All product cards should have:
    
    18px rounded corners
    
    1px solid border rgba(255,255,255,0.05)
    
    Generous spacing between rows (at least 60px gap)
    
    Clean, minimal layout
    
    Typography:
    
    Model name large and bold
    
    Secondary text smaller and lighter weight
    
    Price muted gray (#BFBFBF), not red
    
    Remove large buttons. Instead, show a subtle text link “Ready to ship →” on hover.
    
    Hover effects:
    
    Card lifts slightly (translateY -6px)
    
    Image scales smoothly to 1.04
    
    Soft radial glow behind product image
    
    The TS-912 should simply feel more important because of layout and scale, not because of added text.
    
    Keep everything modern, minimal, and premium., need to have 8 product slots ensure that images are clickable 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-premium-grid-{{ ai_gen_id }} {
    display: block;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 20px;
    width: 100%;
  }

  .ai-premium-grid__container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }

  .ai-premium-grid__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.row_gap }}px {{ block.settings.column_gap }}px;
  }

  .ai-premium-grid__item-{{ ai_gen_id }} {
    position: relative;
    background-color: transparent;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 18px;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .ai-premium-grid__item-{{ ai_gen_id }}:first-child {
    grid-column: span 2;
  }

  .ai-premium-grid__item-{{ ai_gen_id }}:hover {
    transform: translateY(-6px);
    border-color: rgba(255, 255, 255, 0.1);
  }

  .ai-premium-grid__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    background: radial-gradient(circle at center, rgba(255, 255, 255, 0.02) 0%, transparent 70%);
  }

  .ai-premium-grid__item-{{ ai_gen_id }}:hover .ai-premium-grid__image-wrapper-{{ ai_gen_id }} {
    background: radial-gradient(circle at center, rgba(255, 255, 255, 0.06) 0%, transparent 70%);
  }

  .ai-premium-grid__image-link-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .ai-premium-grid__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .ai-premium-grid__item-{{ ai_gen_id }}:hover .ai-premium-grid__image-{{ ai_gen_id }} {
    transform: scale(1.04);
  }

  .ai-premium-grid__placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.02);
  }

  .ai-premium-grid__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.1;
  }

  .ai-premium-grid__content-{{ ai_gen_id }} {
    padding: 24px;
  }

  .ai-premium-grid__title-{{ ai_gen_id }} {
    font-family: {{ block.settings.title_font.family }}, {{ block.settings.title_font.fallback_families }};
    font-weight: {{ block.settings.title_font.weight }};
    font-size: {{ block.settings.title_size }}px;
    line-height: 1.2;
    color: {{ block.settings.title_color }};
    margin: 0 0 8px 0;
    letter-spacing: 0.02em;
  }

  .ai-premium-grid__item-{{ ai_gen_id }}:first-child .ai-premium-grid__title-{{ ai_gen_id }} {
    font-size: calc({{ block.settings.title_size }}px * 1.3);
  }

  .ai-premium-grid__description-{{ ai_gen_id }} {
    font-family: {{ block.settings.description_font.family }}, {{ block.settings.description_font.fallback_families }};
    font-weight: {{ block.settings.description_font.weight }};
    font-size: {{ block.settings.description_size }}px;
    line-height: 1.5;
    color: {{ block.settings.description_color }};
    margin: 0 0 12px 0;
    opacity: 0.7;
  }

  .ai-premium-grid__price-{{ ai_gen_id }} {
    font-family: {{ block.settings.price_font.family }}, {{ block.settings.price_font.fallback_families }};
    font-weight: {{ block.settings.price_font.weight }};
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.price_color }};
    margin: 0 0 12px 0;
  }

  .ai-premium-grid__link-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    color: {{ block.settings.link_color }};
    text-decoration: none;
    opacity: 0;
    transform: translateX(-8px);
    transition: all 0.3s ease;
  }

  .ai-premium-grid__item-{{ ai_gen_id }}:hover .ai-premium-grid__link-{{ ai_gen_id }} {
    opacity: 1;
    transform: translateX(0);
  }

  .ai-premium-grid__link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.link_hover_color }};
  }

  @media screen and (max-width: 989px) {
    .ai-premium-grid__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 40px 20px;
    }

    .ai-premium-grid__item-{{ ai_gen_id }}:first-child {
      grid-column: span 2;
    }

    .ai-premium-grid__title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.9);
    }

    .ai-premium-grid__item-{{ ai_gen_id }}:first-child .ai-premium-grid__title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 1.1);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-premium-grid__grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .ai-premium-grid__item-{{ ai_gen_id }}:first-child {
      grid-column: span 1;
    }

    .ai-premium-grid__content-{{ ai_gen_id }} {
      padding: 20px;
    }
  }
{% endstyle %}

<premium-product-grid-{{ ai_gen_id }} class="ai-premium-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-premium-grid__container-{{ ai_gen_id }}">
    <div class="ai-premium-grid__grid-{{ ai_gen_id }}">
      {% for i in (1..8) %}
        {% liquid
          assign product_key = 'product_' | append: i
          assign product = block.settings[product_key]
        %}

        <div class="ai-premium-grid__item-{{ ai_gen_id }}">
          <div class="ai-premium-grid__image-wrapper-{{ ai_gen_id }}">
            {% if product != blank and product.featured_image %}
              <a href="{{ product.url }}" class="ai-premium-grid__image-link-{{ ai_gen_id }}" aria-label="View {{ product.title }}">
                <img
                  src="{{ product.featured_image | image_url: width: 800 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  class="ai-premium-grid__image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="800"
                  height="800"
                >
              </a>
            {% else %}
              <div class="ai-premium-grid__placeholder-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          <div class="ai-premium-grid__content-{{ ai_gen_id }}">
            {% if product != blank %}
              <h3 class="ai-premium-grid__title-{{ ai_gen_id }}">
                {{ product.title }}
              </h3>

              {% if product.description != blank %}
                <div class="ai-premium-grid__description-{{ ai_gen_id }}">
                  {{ product.description | strip_html | truncate: 80 }}
                </div>
              {% endif %}

              <div class="ai-premium-grid__price-{{ ai_gen_id }}">
                {{ product.price | money }}
              </div>

              <a href="{{ product.url }}" class="ai-premium-grid__link-{{ ai_gen_id }}">
                {{ block.settings.link_text }}
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M6 12L10 8L6 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            {% else %}
              <h3 class="ai-premium-grid__title-{{ ai_gen_id }}">
                Product {{ i }}
              </h3>
              <div class="ai-premium-grid__description-{{ ai_gen_id }}">
                Select a product to display
              </div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</premium-product-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class PremiumProductGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.items = this.querySelectorAll('.ai-premium-grid__item-{{ ai_gen_id }}');
        this.setupAccessibility();
      }

      setupAccessibility() {
        this.items.forEach((item) => {
          const link = item.querySelector('.ai-premium-grid__link-{{ ai_gen_id }}');
          if (link) {
            item.addEventListener('keydown', (e) => {
              if (e.key === 'Enter' && e.target === item) {
                link.click();
              }
            });
          }
        });
      }
    }

    customElements.define('premium-product-grid-{{ ai_gen_id }}', PremiumProductGrid{{ ai_gen_id }});
  })();
</script>

