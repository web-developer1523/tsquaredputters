{% doc %}
  @prompt
    Write a coming soon block for a Shopify product page for the T-Zero Putter by T Squared. The putter is priced at $400. An extremely limited drop of only 25 units is coming — the colorway has not been revealed yet. Customers do not know what the colorway is. They are reserving a spot blind, based purely on the reputation of the product and the exclusivity of the drop.
    The block should include:
    A short punchy headline that builds mystery and anticipation around something that hasn't dropped yet. 2-4 words max.
    Two to three sentences of copy that creates desire and urgency without revealing any details about the colorway. Tease that something is coming. Make them feel like being on this list means they are ahead of everyone else.
    A single line of copy above the form telling the visitor to fill out their information to secure their place in line before the colorway is revealed. Make clear that submitting the form reserves their spot but does not guarantee a unit. Only 25 will be available.
    The form should collect: full name, email address, phone number, and a checkbox confirming they understand this is a reservation only and not a guaranteed purchase.
    A short closing line beneath the submit button that reinforces that the reveal is coming and spots are already filling up.
    Tone is luxury, mysterious, and minimal. Confident. No hype words. Let the scarcity and the unknown do the heavy lifting.
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-coming-soon-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding }}px;
    border: 1px solid {{ block.settings.border_color }};
  }

  .ai-coming-soon-container-{{ ai_gen_id }} {
    max-width: 600px;
    margin: 0 auto;
  }

  .ai-coming-soon-headline-{{ ai_gen_id }} {
    font-size: {{ block.settings.headline_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 24px;
    text-align: center;
    letter-spacing: 0.05em;
    font-weight: 400;
  }

  .ai-coming-soon-body-{{ ai_gen_id }} {
    font-size: {{ block.settings.body_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin: 0 0 32px;
    text-align: center;
  }

  .ai-coming-soon-form-intro-{{ ai_gen_id }} {
    font-size: {{ block.settings.form_intro_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 20px;
    text-align: center;
    opacity: 0.9;
  }

  .ai-coming-soon-form-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-coming-soon-field-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .ai-coming-soon-label-{{ ai_gen_id }} {
    font-size: 13px;
    color: {{ block.settings.text_color }};
    opacity: 0.8;
    letter-spacing: 0.02em;
  }

  .ai-coming-soon-input-{{ ai_gen_id }} {
    padding: 14px 16px;
    border: 1px solid {{ block.settings.input_border_color }};
    background-color: {{ block.settings.input_background_color }};
    color: {{ block.settings.text_color }};
    font-size: 15px;
    transition: border-color 0.2s ease;
  }

  .ai-coming-soon-input-{{ ai_gen_id }}:focus {
    outline: none;
    border-color: {{ block.settings.text_color }};
  }

  .ai-coming-soon-checkbox-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-top: 8px;
  }

  .ai-coming-soon-checkbox-{{ ai_gen_id }} {
    margin-top: 4px;
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    cursor: pointer;
  }

  .ai-coming-soon-checkbox-label-{{ ai_gen_id }} {
    font-size: 13px;
    color: {{ block.settings.text_color }};
    opacity: 0.85;
    line-height: 1.5;
    cursor: pointer;
  }

  .ai-coming-soon-submit-{{ ai_gen_id }} {
    padding: 16px 32px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    font-size: 15px;
    letter-spacing: 0.05em;
    cursor: pointer;
    margin-top: 8px;
    transition: background-color 0.2s ease;
  }

  .ai-coming-soon-submit-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-coming-soon-submit-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-coming-soon-closing-{{ ai_gen_id }} {
    font-size: {{ block.settings.closing_size }}px;
    color: {{ block.settings.text_color }};
    margin: 24px 0 0;
    text-align: center;
    opacity: 0.8;
  }

  .ai-coming-soon-success-{{ ai_gen_id }} {
    color: {{ block.settings.success_color }};
    margin-top: 16px;
    text-align: center;
    font-size: 14px;
  }

  .ai-coming-soon-error-{{ ai_gen_id }} {
    color: {{ block.settings.error_color }};
    margin-top: 8px;
    font-size: 13px;
  }

  @media screen and (max-width: 749px) {
    .ai-coming-soon-{{ ai_gen_id }} {
      padding: {{ block.settings.padding | times: 0.7 }}px;
    }

    .ai-coming-soon-headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_size | times: 0.8 }}px;
    }

    .ai-coming-soon-body-{{ ai_gen_id }} {
      font-size: {{ block.settings.body_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<coming-soon-form-{{ ai_gen_id }}
  class="ai-coming-soon-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-coming-soon-container-{{ ai_gen_id }}">
    {% if block.settings.headline != blank %}
      <h2 class="ai-coming-soon-headline-{{ ai_gen_id }}">{{ block.settings.headline }}</h2>
    {% endif %}

    {% if block.settings.body_copy != blank %}
      <div class="ai-coming-soon-body-{{ ai_gen_id }}">{{ block.settings.body_copy }}</div>
    {% endif %}

    {% if block.settings.form_intro != blank %}
      <div class="ai-coming-soon-form-intro-{{ ai_gen_id }}">{{ block.settings.form_intro }}</div>
    {% endif %}

    {%- form 'contact' -%}
      <input
        type="hidden"
        name="contact[product]"
        value="T-Zero Putter"
      >
      <input
        type="hidden"
        name="contact[price]"
        value="$400"
      >
      <input
        type="hidden"
        name="contact[reservation_type]"
        value="Limited Drop - 25 Units"
      >

      <div class="ai-coming-soon-form-{{ ai_gen_id }}">
        <div class="ai-coming-soon-field-{{ ai_gen_id }}">
          <label
            for="ai-coming-soon-name-{{ ai_gen_id }}"
            class="ai-coming-soon-label-{{ ai_gen_id }}"
          >
            Full name
          </label>
          <input
            type="text"
            id="ai-coming-soon-name-{{ ai_gen_id }}"
            name="contact[name]"
            class="ai-coming-soon-input-{{ ai_gen_id }}"
            required
            autocomplete="name"
          >
        </div>

        <div class="ai-coming-soon-field-{{ ai_gen_id }}">
          <label
            for="ai-coming-soon-email-{{ ai_gen_id }}"
            class="ai-coming-soon-label-{{ ai_gen_id }}"
          >
            Email address
          </label>
          <input
            type="email"
            id="ai-coming-soon-email-{{ ai_gen_id }}"
            name="contact[email]"
            class="ai-coming-soon-input-{{ ai_gen_id }}"
            value="{{ form.email }}"
            required
            autocomplete="email"
            autocorrect="off"
            autocapitalize="off"
            {% if form.errors %}
              aria-invalid="true"
              aria-describedby="ai-coming-soon-error-{{ ai_gen_id }}"
            {% endif %}
            {% if form.posted_successfully? %}
              aria-describedby="ai-coming-soon-success-{{ ai_gen_id }}"
            {% endif %}
          >
          {%- if form.errors -%}
            <div
              id="ai-coming-soon-error-{{ ai_gen_id }}"
              class="ai-coming-soon-error-{{ ai_gen_id }}"
            >
              {{ form.errors.messages.email }}
            </div>
          {%- endif -%}
        </div>

        <div class="ai-coming-soon-field-{{ ai_gen_id }}">
          <label
            for="ai-coming-soon-phone-{{ ai_gen_id }}"
            class="ai-coming-soon-label-{{ ai_gen_id }}"
          >
            Phone number
          </label>
          <input
            type="tel"
            id="ai-coming-soon-phone-{{ ai_gen_id }}"
            name="contact[phone]"
            class="ai-coming-soon-input-{{ ai_gen_id }}"
            required
            autocomplete="tel"
          >
        </div>

        <div class="ai-coming-soon-checkbox-wrapper-{{ ai_gen_id }}">
          <input
            type="checkbox"
            id="ai-coming-soon-confirm-{{ ai_gen_id }}"
            name="contact[reservation_confirmed]"
            class="ai-coming-soon-checkbox-{{ ai_gen_id }}"
            value="yes"
            required
          >
          <label
            for="ai-coming-soon-confirm-{{ ai_gen_id }}"
            class="ai-coming-soon-checkbox-label-{{ ai_gen_id }}"
          >
            {{ block.settings.checkbox_label }}
          </label>
        </div>

        <button
          type="submit"
          class="ai-coming-soon-submit-{{ ai_gen_id }}"
        >
          {{ block.settings.button_text }}
        </button>

        {%- if form.posted_successfully? -%}
          <div
            id="ai-coming-soon-success-{{ ai_gen_id }}"
            class="ai-coming-soon-success-{{ ai_gen_id }}"
          >
            {{ block.settings.success_message }}
          </div>
        {%- endif -%}
      </div>
    {%- endform -%}

    {% if block.settings.closing_copy != blank %}
      <div class="ai-coming-soon-closing-{{ ai_gen_id }}">{{ block.settings.closing_copy }}</div>
    {% endif %}
  </div>
</coming-soon-form-{{ ai_gen_id }}>

<script>
  (function() {
    class ComingSoonForm{{ai_gen_id}} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        const form = this.querySelector('form');
        const submitButton = this.querySelector('.ai-coming-soon-submit-{{ ai_gen_id }}');
        const checkbox = this.querySelector('#ai-coming-soon-confirm-{{ ai_gen_id }}');

        if (checkbox && submitButton) {
          checkbox.addEventListener('change', function() {
            submitButton.disabled = !checkbox.checked;
          });

          submitButton.disabled = !checkbox.checked;
        }
      }
    }

    customElements.define('coming-soon-form-{{ ai_gen_id }}', ComingSoonForm{{ai_gen_id}});
  })();
</script>

{% schema %}
{
  "name": "Coming soon",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "headline",
      "label": "Headline",
      "default": "Before the reveal"
    },
    {
      "type": "richtext",
      "id": "body_copy",
