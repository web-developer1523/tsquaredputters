      "default": "<p>Twenty-five units. One colorway. No second chances. The T-Zero returns in a finish we've never released before. Reserve your place now—before you know what it is.</p>"
    },
    {
      "type": "richtext",
      "id": "form_intro",
      "label": "Form introduction",
      "default": "<p>Submit your information to reserve your spot. This does not guarantee a unit—only 25 will be available.</p>"
    },
    {
      "type": "inline_richtext",
      "id": "checkbox_label",
      "label": "Checkbox label",
      "default": "I understand this is a reservation only and does not guarantee a purchase."
    },
    {
      "type": "inline_richtext",
      "id": "button_text",
      "label": "Button text",
      "default": "Reserve my spot"
    },
    {
      "type": "richtext",
