{% doc %}
  @prompt
    T Squared Access — Members Only
    Friday
    Drops.
    Every Friday at noon, we release a limited offer — exclusive pricing, custom options, or something you won't find anywhere else on the site.
    
    Email list gets it first. Always.
    
    Next drop: This Friday at 12:00 PM EST
    03
    Days
    23
    Hours
    45
    Mins
    31
    Secs
    Join the Waitlist
    Full Name
    Email Address
    Phone Number
    Reserve My Spot
    List members get the drop before anyone else.
    Previous Drops
    T-Zero Putter — 001–025
    Closed
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-friday-drops-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    padding: {{ block.settings.padding }}px;
  }

  .ai-friday-drops-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-friday-drops-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-friday-drops-badge-{{ ai_gen_id }} {
    display: inline-block;
    background-color: {{ block.settings.badge_bg_color }};
    color: {{ block.settings.badge_text_color }};
    padding: 8px 20px;
    font-size: {{ block.settings.badge_font_size }}px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 20px;
  }

  .ai-friday-drops-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    font-weight: 700;
    margin: 0 0 20px;
    line-height: 1.2;
  }

  .ai-friday-drops-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_font_size }}px;
    line-height: 1.6;
    margin: 0 auto 30px;
    max-width: 600px;
  }

  .ai-friday-drops-next-drop-{{ ai_gen_id }} {
    font-size: {{ block.settings.next_drop_font_size }}px;
    font-weight: 600;
    margin-bottom: 20px;
  }

  .ai-friday-drops-countdown-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-bottom: 40px;
  }

  .ai-friday-drops-countdown-item-{{ ai_gen_id }} {
    text-align: center;
  }

  .ai-friday-drops-countdown-value-{{ ai_gen_id }} {
    display: block;
    font-size: {{ block.settings.countdown_number_size }}px;
    font-weight: 700;
    line-height: 1;
    margin-bottom: 8px;
    color: {{ block.settings.countdown_number_color }};
  }

  .ai-friday-drops-countdown-label-{{ ai_gen_id }} {
    display: block;
    font-size: {{ block.settings.countdown_label_size }}px;
    text-transform: uppercase;
    letter-spacing: 1px;
    opacity: 0.7;
  }

  .ai-friday-drops-form-section-{{ ai_gen_id }} {
    background-color: {{ block.settings.form_bg_color }};
    padding: 40px;
    border-radius: {{ block.settings.form_border_radius }}px;
    margin-bottom: 40px;
  }

  .ai-friday-drops-form-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.form_title_font_size }}px;
    font-weight: 700;
    text-align: center;
    margin: 0 0 30px;
    color: {{ block.settings.form_text_color }};
  }

  .ai-friday-drops-form-fields-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 20px;
  }

  .ai-friday-drops-input-{{ ai_gen_id }} {
    width: 100%;
    padding: 14px 18px;
    border: 1px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    font-size: 16px;
    background-color: {{ block.settings.input_bg_color }};
    color: {{ block.settings.form_text_color }};
  }

  .ai-friday-drops-input-{{ ai_gen_id }}::placeholder {
    color: {{ block.settings.form_text_color }};
    opacity: 0.5;
  }

  .ai-friday-drops-submit-{{ ai_gen_id }} {
    width: 100%;
    padding: 16px 32px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .ai-friday-drops-submit-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
  }

  .ai-friday-drops-form-note-{{ ai_gen_id }} {
    text-align: center;
    font-size: 14px;
    margin-top: 16px;
    opacity: 0.8;
    color: {{ block.settings.form_text_color }};
  }

  .ai-friday-drops-success-{{ ai_gen_id }} {
    color: {{ block.settings.success_color }};
    text-align: center;
    margin-top: 16px;
    font-weight: 600;
  }

  .ai-friday-drops-error-{{ ai_gen_id }} {
    color: {{ block.settings.error_color }};
    text-align: center;
    margin-top: 16px;
  }

  .ai-friday-drops-previous-{{ ai_gen_id }} {
    text-align: center;
  }

  .ai-friday-drops-previous-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.previous_title_font_size }}px;
    font-weight: 700;
    margin: 0 0 30px;
  }

  .ai-friday-drops-previous-list-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 500px;
    margin: 0 auto;
  }

  .ai-friday-drops-previous-item-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 24px;
    background-color: {{ block.settings.previous_item_bg_color }};
    border-radius: {{ block.settings.previous_item_border_radius }}px;
  }

  .ai-friday-drops-previous-name-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 600;
  }

  .ai-friday-drops-previous-status-{{ ai_gen_id }} {
    font-size: 14px;
    opacity: 0.6;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  @media screen and (max-width: 749px) {
    .ai-friday-drops-{{ ai_gen_id }} {
      padding: {{ block.settings.padding | times: 0.6 }}px;
    }

    .ai-friday-drops-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_font_size | times: 0.7 }}px;
    }

    .ai-friday-drops-countdown-{{ ai_gen_id }} {
      gap: 12px;
    }

    .ai-friday-drops-countdown-value-{{ ai_gen_id }} {
      font-size: {{ block.settings.countdown_number_size | times: 0.7 }}px;
    }

    .ai-friday-drops-form-section-{{ ai_gen_id }} {
      padding: 24px;
    }
  }
{% endstyle %}

<friday-drops-{{ ai_gen_id }}
  class="ai-friday-drops-{{ ai_gen_id }}"
  data-target-date="{{ block.settings.target_date }}"
  data-target-time="{{ block.settings.target_time }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-friday-drops-container-{{ ai_gen_id }}">
    <div class="ai-friday-drops-header-{{ ai_gen_id }}">
      {% if block.settings.badge_text != blank %}
        <div class="ai-friday-drops-badge-{{ ai_gen_id }}">
          {{ block.settings.badge_text }}
        </div>
      {% endif %}

      {% if block.settings.title != blank %}
        <h2 class="ai-friday-drops-title-{{ ai_gen_id }}">
          {{ block.settings.title }}
        </h2>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="ai-friday-drops-description-{{ ai_gen_id }}">
          {{ block.settings.description }}
        </div>
      {% endif %}

      {% if block.settings.next_drop_text != blank %}
        <div class="ai-friday-drops-next-drop-{{ ai_gen_id }}">
          {{ block.settings.next_drop_text }}
        </div>
      {% endif %}

      <div class="ai-friday-drops-countdown-{{ ai_gen_id }}">
        <div class="ai-friday-drops-countdown-item-{{ ai_gen_id }}">
          <span class="ai-friday-drops-countdown-value-{{ ai_gen_id }}" data-countdown-days>00</span>
          <span class="ai-friday-drops-countdown-label-{{ ai_gen_id }}">Days</span>
        </div>
        <div class="ai-friday-drops-countdown-item-{{ ai_gen_id }}">
          <span class="ai-friday-drops-countdown-value-{{ ai_gen_id }}" data-countdown-hours>00</span>
          <span class="ai-friday-drops-countdown-label-{{ ai_gen_id }}">Hours</span>
        </div>
        <div class="ai-friday-drops-countdown-item-{{ ai_gen_id }}">
          <span class="ai-friday-drops-countdown-value-{{ ai_gen_id }}" data-countdown-mins>00</span>
          <span class="ai-friday-drops-countdown-label-{{ ai_gen_id }}">Mins</span>
        </div>
        <div class="ai-friday-drops-countdown-item-{{ ai_gen_id }}">
          <span class="ai-friday-drops-countdown-value-{{ ai_gen_id }}" data-countdown-secs>00</span>
          <span class="ai-friday-drops-countdown-label-{{ ai_gen_id }}">Secs</span>
        </div>
      </div>
    </div>

    <div class="ai-friday-drops-form-section-{{ ai_gen_id }}">
      {% if block.settings.form_title != blank %}
        <h3 class="ai-friday-drops-form-title-{{ ai_gen_id }}">
          {{ block.settings.form_title }}
        </h3>
      {% endif %}

      {%- form 'contact' -%}
        <input type="hidden" name="contact[friday_drops_waitlist]" value="true">

        <div class="ai-friday-drops-form-fields-{{ ai_gen_id }}">
          <input
            type="text"
            name="contact[name]"
            class="ai-friday-drops-input-{{ ai_gen_id }}"
            placeholder="{{ block.settings.name_placeholder }}"
            value="{{ form.name }}"
            {% if form.posted_successfully? %}
              aria-describedby="ai-friday-drops-success-{{ ai_gen_id }}"
            {% endif %}
            {% if form.errors %}
              aria-describedby="ai-friday-drops-error-{{ ai_gen_id }}"
            {% endif %}
          >

          <input
            type="email"
            name="contact[email]"
            class="ai-friday-drops-input-{{ ai_gen_id }}"
            placeholder="{{ block.settings.email_placeholder }}"
            value="{{ form.email }}"
            required
            autocomplete="email"
            {% if form.errors %}
              aria-invalid="true"
              aria-describedby="ai-friday-drops-error-{{ ai_gen_id }}"
            {% endif %}
            {% if form.posted_successfully? %}
              aria-describedby="ai-friday-drops-success-{{ ai_gen_id }}"
            {% endif %}
          >

          <input
            type="tel"
            name="contact[phone]"
            class="ai-friday-drops-input-{{ ai_gen_id }}"
            placeholder="{{ block.settings.phone_placeholder }}"
            value="{{ form.phone }}"
            autocomplete="tel"
            {% if form.posted_successfully? %}
              aria-describedby="ai-friday-drops-success-{{ ai_gen_id }}"
            {% endif %}
            {% if form.errors %}
              aria-describedby="ai-friday-drops-error-{{ ai_gen_id }}"
            {% endif %}
          >
        </div>

        <button type="submit" class="ai-friday-drops-submit-{{ ai_gen_id }}">
          {{ block.settings.button_text }}
        </button>

        {% if block.settings.form_note != blank %}
          <div class="ai-friday-drops-form-note-{{ ai_gen_id }}">
            {{ block.settings.form_note }}
          </div>
        {% endif %}

        {%- if form.posted_successfully? -%}
          <div
            id="ai-friday-drops-success-{{ ai_gen_id }}"
            class="ai-friday-drops-success-{{ ai_gen_id }}"
          >
            {{ block.settings.success_message }}
          </div>
        {%- endif -%}

        {%- if form.errors -%}
          <div
            id="ai-friday-drops-error-{{ ai_gen_id }}"
            class="ai-friday-drops-error-{{ ai_gen_id }}"
          >
            {% if form.errors.email %}
              {{ form.errors.messages.email }}
            {% else %}
              Please check your information and try again.
            {% endif %}
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>

    {% if block.settings.show_previous_drops %}
      <div class="ai-friday-drops-previous-{{ ai_gen_id }}">
        {% if block.settings.previous_title != blank %}
          <h3 class="ai-friday-drops-previous-title-{{ ai_gen_id }}">
            {{ block.settings.previous_title }}
          </h3>
        {% endif %}

        <div class="ai-friday-drops-previous-list-{{ ai_gen_id }}">
          {% for i in (1..3) %}
            {% liquid
              assign drop_name_key = 'previous_drop_' | append: i | append: '_name'
              assign drop_status_key = 'previous_drop_' | append: i | append: '_status'
              assign drop_name = block.settings[drop_name_key]
              assign drop_status = block.settings[drop_status_key]
            %}

            {% if drop_name != blank %}
              <div class="ai-friday-drops-previous-item-{{ ai_gen_id }}">
                <span class="ai-friday-drops-previous-name-{{ ai_gen_id }}">{{ drop_name }}</span>
                <span class="ai-friday-drops-previous-status-{{ ai_gen_id }}">{{ drop_status }}</span>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </div>
</friday-drops-{{ ai_gen_id }}>

<script>
  (function() {
    class FridayDrops{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.targetDate = this.dataset.targetDate;
        this.targetTime = this.dataset.targetTime;
        this.countdownInterval = null;
      }

      connectedCallback() {
        this.initCountdown();
      }

      disconnectedCallback() {
        if (this.countdownInterval) {
          clearInterval(this.countdownInterval);
        }
      }

      initCountdown() {
        if (!this.targetDate || !this.targetTime) {
          return;
        }

        const targetDateTime = new Date(this.targetDate + 'T' + this.targetTime);

        this.updateCountdown(targetDateTime);

        this.countdownInterval = setInterval(() => {
          this.updateCountdown(targetDateTime);
        }, 1000);
      }

      updateCountdown(targetDateTime) {
        const now = new Date().getTime();
        const distance = targetDateTime.getTime() - now;

        if (distance < 0) {
          if (this.countdownInterval) {
            clearInterval(this.countdownInterval);
          }
          this.setCountdownValues(0, 0, 0, 0);
          return;
        }

        const days = Math.floor(distance / (1000 * 60 * 60 * 24));
        const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((distance % (1000 * 60)) / 1000);

        this.setCountdownValues(days, hours, minutes, seconds);
      }

      setCountdownValues(days, hours, minutes, seconds) {
        const daysEl = this.querySelector('[data-countdown-days]');
        const hoursEl = this.querySelector('[data-countdown-hours]');
        const minsEl = this.querySelector('[data-countdown-mins]');
        const secsEl = this.querySelector('[data-countdown-secs]');

        if (daysEl) daysEl.textContent = String(days).padStart(2, '0');
        if (hoursEl) hoursEl.textContent = String(hours).padStart(2, '0');
        if (minsEl) minsEl.textContent = String(minutes).padStart(2, '0');
        if (secsEl) secsEl.textContent = String(seconds).padStart(2, '0');
      }
    }

    customElements.define('friday-drops-{{ ai_gen_id }}', FridayDrops{{ ai_gen_id }});
  })();
</script>

