{% doc %}
  @prompt
    Create a premium dark product grid section with background color #0E0E0E.
    
    The TS-912 should appear first and span two columns so it feels visually dominant, but do not add any badges, labels, or additional text. Keep the product name and description exactly as they are.
    
    All product cards should have:
    
    18px rounded corners
    
    1px solid border rgba(255,255,255,0.05)
    
    Generous spacing between rows (at least 60px gap)
    
    Clean, minimal layout
    
    Typography:
    
    Model name large and bold
    
    Secondary text smaller and lighter weight
    
    Price muted gray (#BFBFBF), not red
    
    Remove large buttons. Instead, show a subtle text link “Build Yours →” on hover.
    
    Hover effects:
    
    Card lifts slightly (translateY -6px)
    
    Image scales smoothly to 1.04
    
    Soft radial glow behind product image
    
    The TS-912 should simply feel more important because of layout and scale, not because of added text.
    
    Keep everything modern, minimal, and premium., need to have 8 product slots
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-premium-grid-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 20px;
  }

  .ai-premium-grid__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-premium-grid__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.row_gap }}px {{ block.settings.column_gap }}px;
  }

  .ai-premium-grid__item-{{ ai_gen_id }} {
    position: relative;
    background-color: transparent;
    border: 1px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .ai-premium-grid__item-{{ ai_gen_id }}--featured {
    grid-column: span 2;
  }

  .ai-premium-grid__item-{{ ai_gen_id }}:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
  }

  .ai-premium-grid__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    background-color: {{ block.settings.background_color }};
  }

  .ai-premium-grid__image-glow-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 80%;
    height: 80%;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(255, 255, 255, 0.08) 0%, transparent 70%);
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .ai-premium-grid__item-{{ ai_gen_id }}:hover .ai-premium-grid__image-glow-{{ ai_gen_id }} {
    opacity: 1;
  }

  .ai-premium-grid__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .ai-premium-grid__item-{{ ai_gen_id }}:hover .ai-premium-grid__image-{{ ai_gen_id }} {
    transform: scale(1.04);
  }

  .ai-premium-grid__content-{{ ai_gen_id }} {
    padding: 24px;
  }

  .ai-premium-grid__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    color: {{ block.settings.title_color }};
    margin: 0 0 8px 0;
    line-height: 1.2;
  }

  .ai-premium-grid__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    font-weight: 300;
    color: {{ block.settings.description_color }};
    margin: 0 0 12px 0;
    line-height: 1.4;
  }

  .ai-premium-grid__price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.price_color }};
    margin: 0 0 16px 0;
    font-weight: 400;
  }

  .ai-premium-grid__link-wrapper-{{ ai_gen_id }} {
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .ai-premium-grid__item-{{ ai_gen_id }}:hover .ai-premium-grid__link-wrapper-{{ ai_gen_id }} {
    opacity: 1;
    transform: translateY(0);
  }

  .ai-premium-grid__link-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.link_color }};
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: gap 0.2s ease;
  }

  .ai-premium-grid__link-{{ ai_gen_id }}:hover {
    gap: 10px;
  }

  @media screen and (max-width: 989px) {
    .ai-premium-grid__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }

    .ai-premium-grid__item-{{ ai_gen_id }}--featured {
      grid-column: span 2;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-premium-grid__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: 40px 16px;
    }

    .ai-premium-grid__item-{{ ai_gen_id }}--featured {
      grid-column: span {{ block.settings.columns_mobile }};
    }

    .ai-premium-grid__content-{{ ai_gen_id }} {
      padding: 20px;
    }

    .ai-premium-grid__title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.85);
    }

    .ai-premium-grid__description-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.description_size }}px * 0.9);
    }
  }
{% endstyle %}

<premium-product-grid-{{ ai_gen_id }} class="ai-premium-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-premium-grid__container-{{ ai_gen_id }}">
    <div class="ai-premium-grid__grid-{{ ai_gen_id }}">
      {% if block.settings.product_1 != blank %}
        <div class="ai-premium-grid__item-{{ ai_gen_id }} ai-premium-grid__item-{{ ai_gen_id }}--featured">
          <div class="ai-premium-grid__image-wrapper-{{ ai_gen_id }}">
            <div class="ai-premium-grid__image-glow-{{ ai_gen_id }}"></div>
            {% if block.settings.product_1.featured_image %}
              <img
                src="{{ block.settings.product_1.featured_image | image_url: width: 1200 }}"
                alt="{{ block.settings.product_1.featured_image.alt | escape }}"
                class="ai-premium-grid__image-{{ ai_gen_id }}"
                loading="lazy"
                width="{{ block.settings.product_1.featured_image.width }}"
                height="{{ block.settings.product_1.featured_image.height }}"
              >
            {% else %}
              <div class="ai-premium-grid__image-placeholder-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
          <div class="ai-premium-grid__content-{{ ai_gen_id }}">
            <h3 class="ai-premium-grid__title-{{ ai_gen_id }}">{{ block.settings.product_1.title }}</h3>
            {% if block.settings.product_1.description != blank %}
              <div class="ai-premium-grid__description-{{ ai_gen_id }}">
                {{ block.settings.product_1.description | strip_html | truncate: 120 }}
              </div>
            {% endif %}
            <div class="ai-premium-grid__price-{{ ai_gen_id }}">
              {{ block.settings.product_1.price | money }}
            </div>
            <div class="ai-premium-grid__link-wrapper-{{ ai_gen_id }}">
              <a href="{{ block.settings.product_1.url }}" class="ai-premium-grid__link-{{ ai_gen_id }}">
                {{ block.settings.link_text }} →
              </a>
            </div>
          </div>
        </div>
      {% endif %}

      {% for i in (2..8) %}
        {% assign product_key = 'product_' | append: i %}
        {% assign product = block.settings[product_key] %}
        {% if product != blank %}
          <div class="ai-premium-grid__item-{{ ai_gen_id }}">
            <div class="ai-premium-grid__image-wrapper-{{ ai_gen_id }}">
              <div class="ai-premium-grid__image-glow-{{ ai_gen_id }}"></div>
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 800 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  class="ai-premium-grid__image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="{{ product.featured_image.width }}"
                  height="{{ product.featured_image.height }}"
                >
              {% else %}
                <div class="ai-premium-grid__image-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            <div class="ai-premium-grid__content-{{ ai_gen_id }}">
              <h3 class="ai-premium-grid__title-{{ ai_gen_id }}">{{ product.title }}</h3>
              {% if product.description != blank %}
                <div class="ai-premium-grid__description-{{ ai_gen_id }}">
                  {{ product.description | strip_html | truncate: 100 }}
                </div>
              {% endif %}
              <div class="ai-premium-grid__price-{{ ai_gen_id }}">
                {{ product.price | money }}
              </div>
              <div class="ai-premium-grid__link-wrapper-{{ ai_gen_id }}">
                <a href="{{ product.url }}" class="ai-premium-grid__link-{{ ai_gen_id }}">
                  {{ block.settings.link_text }} →
                </a>
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</premium-product-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class PremiumProductGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.initializeGrid();
      }

      initializeGrid() {
        const items = this.querySelectorAll('.ai-premium-grid__item-{{ ai_gen_id }}');
        items.forEach((item, index) => {
          item.style.animationDelay = `${index * 0.05}s`;
        });
      }
    }

    customElements.define('premium-product-grid-{{ ai_gen_id }}', PremiumProductGrid{{ ai_gen_id }});
  })();
</script>

