<script>
  (function() {
    class CorporateGifts{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.carousel = null;
        this.isDragging = false;
        this.startPos = 0;
        this.currentTranslate = 0;
        this.prevTranslate = 0;
        this.animationID = 0;
        this.currentIndex = 0;
        this.autoScrollInterval = null;
        this.isPaused = false;
      }

      connectedCallback() {
        this.carousel = this.querySelector('[data-carousel]');
        if (!this.carousel) return;

        this.setupCarousel();
        this.setupSmoothScroll();
      }

      setupCarousel() {
        this.carousel.addEventListener('mousedown', this.handleDragStart.bind(this));
        this.carousel.addEventListener('touchstart', this.handleDragStart.bind(this));
        this.carousel.addEventListener('mouseup', this.handleDragEnd.bind(this));
        this.carousel.addEventListener('touchend', this.handleDragEnd.bind(this));
        this.carousel.addEventListener('mouseleave', this.handleDragEnd.bind(this));
        this.carousel.addEventListener('mousemove', this.handleDragMove.bind(this));
        this.carousel.addEventListener('touchmove', this.handleDragMove.bind(this));
        this.carousel.addEventListener('mouseenter', this.pauseAutoScroll.bind(this));
        this.carousel.addEventListener('mouseleave', this.resumeAutoScroll.bind(this));

        this.startAutoScroll();
      }

      handleDragStart(e) {
        this.isDragging = true;
        this.carousel.classList.add('dragging');
        this.startPos = this.getPositionX(e);
        this.pauseAutoScroll();
      }

      handleDragMove(e) {
        if (!this.isDragging) return;
        e.preventDefault();
        const currentPosition = this.getPositionX(e);
        const diff = currentPosition - this.startPos;
        this.carousel.scrollLeft -= diff;
        this.startPos = currentPosition;
      }

      handleDragEnd() {
        this.isDragging = false;
        this.carousel.classList.remove('dragging');
        this.resumeAutoScroll();
      }

      getPositionX(e) {
        return e.type.includes('mouse') ? e.pageX : e.touches[0].clientX;
      }

      startAutoScroll() {
        this.autoScrollInterval = setInterval(() => {
          if (!this.isPaused) {
            const maxScroll = this.carousel.scrollWidth - this.carousel.clientWidth;
            if (this.carousel.scrollLeft >= maxScroll) {
              this.carousel.scrollLeft = 0;
            } else {
              this.carousel.scrollLeft += 1;
            }
          }
        }, 30);
      }

      pauseAutoScroll() {
        this.isPaused = true;
      }

      resumeAutoScroll() {
        this.isPaused = false;
      }

      setupSmoothScroll() {
        const ctaButton = this.querySelector('.ai-corporate-gifts-cta-{{ ai_gen_id }}');
        if (ctaButton) {
          ctaButton.addEventListener('click', (e) => {
            e.preventDefault();
            const target = this.querySelector('#corporate-form-{{ ai_gen_id }}');
            if (target) {
              target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
          });
        }
      }

      disconnectedCallback() {
        if (this.autoScrollInterval) {
          clearInterval(this.autoScrollInterval);
        }
      }
    }

    customElements.define('corporate-gifts-{{ ai_gen_id }}', CorporateGifts{{ ai_gen_id }});
  })();
</script>

