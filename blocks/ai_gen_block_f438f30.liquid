{% doc %}
  @prompt
    create a section where we can put our reviews in carsel fashion
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-reviews-carousel-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
    overflow: hidden;
  }

  .ai-reviews-carousel__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-reviews-carousel__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-reviews-carousel__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 10px;
    {% if block.settings.title_uppercase %}
      text-transform: uppercase;
    {% endif %}
  }

  .ai-reviews-carousel__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.text_color }};
    opacity: 0.8;
    margin: 0;
  }

  .ai-reviews-carousel__track-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-reviews-carousel__track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.card_gap }}px;
    transition: transform 0.5s ease;
  }

  .ai-reviews-carousel__slide-{{ ai_gen_id }} {
    flex: 0 0 calc(100% - {{ block.settings.card_gap }}px);
    min-width: 0;
  }

  @media screen and (min-width: 750px) {
    .ai-reviews-carousel__slide-{{ ai_gen_id }} {
      flex: 0 0 calc(50% - {{ block.settings.card_gap | divided_by: 2 }}px);
    }
  }

  @media screen and (min-width: 990px) {
    .ai-reviews-carousel__slide-{{ ai_gen_id }} {
      flex: 0 0 calc({{ 100 | divided_by: block.settings.slides_per_view }}% - {{ block.settings.card_gap | times: block.settings.slides_per_view | minus: block.settings.card_gap | divided_by: block.settings.slides_per_view }}px);
    }
  }

  .ai-reviews-carousel__card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-reviews-carousel__stars-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
    color: {{ block.settings.star_color }};
  }

  .ai-reviews-carousel__star-{{ ai_gen_id }} {
    width: {{ block.settings.star_size }}px;
    height: {{ block.settings.star_size }}px;
  }

  .ai-reviews-carousel__review-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.review_text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    flex-grow: 1;
  }

  .ai-reviews-carousel__author-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: auto;
  }

  .ai-reviews-carousel__author-image-{{ ai_gen_id }} {
    width: {{ block.settings.author_image_size }}px;
    height: {{ block.settings.author_image_size }}px;
    border-radius: 50%;
    object-fit: cover;
    background-color: {{ block.settings.card_border_color }};
  }

  .ai-reviews-carousel__author-placeholder-{{ ai_gen_id }} {
    width: {{ block.settings.author_image_size }}px;
    height: {{ block.settings.author_image_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.card_border_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: {{ block.settings.author_image_size | divided_by: 2 }}px;
    color: {{ block.settings.text_color }};
    font-weight: bold;
  }

  .ai-reviews-carousel__author-info-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .ai-reviews-carousel__author-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.author_name_size }}px;
    color: {{ block.settings.text_color }};
    font-weight: 600;
    margin: 0;
  }

  .ai-reviews-carousel__author-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.author_title_size }}px;
    color: {{ block.settings.text_color }};
    opacity: 0.7;
    margin: 0;
  }

  .ai-reviews-carousel__controls-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    margin-top: 40px;
  }

  .ai-reviews-carousel__button-{{ ai_gen_id }} {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 2px solid {{ block.settings.button_color }};
    background-color: transparent;
    color: {{ block.settings.button_color }};
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .ai-reviews-carousel__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
  }

  .ai-reviews-carousel__button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-reviews-carousel__dots-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
  }

  .ai-reviews-carousel__dot-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: {{ block.settings.button_color }};
    opacity: 0.3;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: opacity 0.3s ease;
  }

  .ai-reviews-carousel__dot-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  .ai-reviews-carousel__empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: {{ block.settings.text_color }};
    opacity: 0.6;
  }
{% endstyle %}

<reviews-carousel-{{ ai_gen_id }} class="ai-reviews-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-reviews-carousel__container-{{ ai_gen_id }}">
    {% if block.settings.title != blank or block.settings.subtitle != blank %}
      <div class="ai-reviews-carousel__header-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h2 class="ai-reviews-carousel__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
        {% endif %}
        {% if block.settings.subtitle != blank %}
          <p class="ai-reviews-carousel__subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% assign has_reviews = false %}
    {% for i in (1..6) %}
      {% assign review_text_key = 'review_' | append: i | append: '_text' %}
      {% if block.settings[review_text_key] != blank %}
        {% assign has_reviews = true %}
        {% break %}
      {% endif %}
    {% endfor %}

    {% if has_reviews %}
      <div class="ai-reviews-carousel__track-wrapper-{{ ai_gen_id }}">
        <div class="ai-reviews-carousel__track-{{ ai_gen_id }}" data-track>
          {% for i in (1..6) %}
            {% assign review_text_key = 'review_' | append: i | append: '_text' %}
            {% assign author_name_key = 'review_' | append: i | append: '_author_name' %}
            {% assign author_title_key = 'review_' | append: i | append: '_author_title' %}
            {% assign author_image_key = 'review_' | append: i | append: '_author_image' %}
            {% assign rating_key = 'review_' | append: i | append: '_rating' %}

            {% assign review_text = block.settings[review_text_key] %}
            {% assign author_name = block.settings[author_name_key] %}
            {% assign author_title = block.settings[author_title_key] %}
            {% assign author_image = block.settings[author_image_key] %}
            {% assign rating = block.settings[rating_key] %}

            {% if review_text != blank %}
              <div class="ai-reviews-carousel__slide-{{ ai_gen_id }}">
                <div class="ai-reviews-carousel__card-{{ ai_gen_id }}">
                  <div class="ai-reviews-carousel__stars-{{ ai_gen_id }}">
                    {% for star in (1..5) %}
                      <svg class="ai-reviews-carousel__star-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="{% if star <= rating %}currentColor{% else %}none{% endif %}" stroke="currentColor" stroke-width="2">
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                      </svg>
                    {% endfor %}
                  </div>

                  <div class="ai-reviews-carousel__review-text-{{ ai_gen_id }}">
                    {{ review_text }}
                  </div>

                  {% if author_name != blank %}
                    <div class="ai-reviews-carousel__author-{{ ai_gen_id }}">
                      {% if author_image != blank %}
                        <img
                          src="{{ author_image | image_url: width: 100 }}"
                          alt="{{ author_name }}"
                          class="ai-reviews-carousel__author-image-{{ ai_gen_id }}"
                          width="100"
                          height="100"
                          loading="lazy"
                        >
                      {% else %}
                        <div class="ai-reviews-carousel__author-placeholder-{{ ai_gen_id }}">
                          {{ author_name | slice: 0 }}
                        </div>
                      {% endif %}
                      <div class="ai-reviews-carousel__author-info-{{ ai_gen_id }}">
                        <p class="ai-reviews-carousel__author-name-{{ ai_gen_id }}">{{ author_name }}</p>
                        {% if author_title != blank %}
                          <p class="ai-reviews-carousel__author-title-{{ ai_gen_id }}">{{ author_title }}</p>
                        {% endif %}
                      </div>
                    </div>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      <div class="ai-reviews-carousel__controls-{{ ai_gen_id }}">
        <button class="ai-reviews-carousel__button-{{ ai_gen_id }}" data-prev aria-label="Previous review">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <div class="ai-reviews-carousel__dots-{{ ai_gen_id }}" data-dots></div>
        <button class="ai-reviews-carousel__button-{{ ai_gen_id }}" data-next aria-label="Next review">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    {% else %}
      <div class="ai-reviews-carousel__empty-state-{{ ai_gen_id }}">
        <p>Add your first review to get started</p>
      </div>
    {% endif %}
  </div>
</reviews-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class ReviewsCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.slidesPerView = 1;
      }

      connectedCallback() {
        this.track = this.querySelector('[data-track]');
        this.slides = this.querySelectorAll('.ai-reviews-carousel__slide-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('[data-prev]');
        this.nextButton = this.querySelector('[data-next]');
        this.dotsContainer = this.querySelector('[data-dots]');

        if (!this.track || this.slides.length === 0) return;

        this.updateSlidesPerView();
        this.createDots();
        this.setupEventListeners();
        this.updateCarousel();

        window.addEventListener('resize', () => {
          this.updateSlidesPerView();
          this.createDots();
          this.updateCarousel();
        });
      }

      updateSlidesPerView() {
        if (window.innerWidth >= 990) {
          this.slidesPerView = {{ block.settings.slides_per_view }};
        } else if (window.innerWidth >= 750) {
          this.slidesPerView = 2;
        } else {
          this.slidesPerView = 1;
        }
      }

      createDots() {
        if (!this.dotsContainer) return;
        this.dotsContainer.innerHTML = '';
        const totalDots = Math.ceil(this.slides.length / this.slidesPerView);

        for (let i = 0; i < totalDots; i++) {
          const dot = document.createElement('button');
          dot.className = 'ai-reviews-carousel__dot-{{ ai_gen_id }}';
          dot.setAttribute('aria-label', 'Go to slide ' + (i + 1));
          if (i === 0) dot.classList.add('active');
          dot.addEventListener('click', () => this.goToSlide(i));
          this.dotsContainer.appendChild(dot);
        }
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.prev());
        }
        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.next());
        }
      }

      prev() {
        if (this.currentIndex > 0) {
          this.currentIndex--;
          this.updateCarousel();
        }
      }

      next() {
        const maxIndex = Math.ceil(this.slides.length / this.slidesPerView) - 1;
        if (this.currentIndex < maxIndex) {
          this.currentIndex++;
          this.updateCarousel();
        }
      }

      goToSlide(index) {
        this.currentIndex = index;
        this.updateCarousel();
      }

      updateCarousel() {
        const slideWidth = this.slides[0].offsetWidth;
        const gap = {{ block.settings.card_gap }};
        const offset = -(this.currentIndex * this.slidesPerView * (slideWidth + gap));
        this.track.style.transform = 'translateX(' + offset + 'px)';

        const maxIndex = Math.ceil(this.slides.length / this.slidesPerView) - 1;
        if (this.prevButton) {
          this.prevButton.disabled = this.currentIndex === 0;
        }
        if (this.nextButton) {
          this.nextButton.disabled = this.currentIndex >= maxIndex;
        }

        const dots = this.querySelectorAll('.ai-reviews-carousel__dot-{{ ai_gen_id }}');
        dots.forEach((dot, index) => {
          if (index === this.currentIndex) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }
    }

    customElements.define('reviews-carousel-{{ ai_gen_id }}', ReviewsCarousel{{ ai_gen_id }});
  })();
</script>

