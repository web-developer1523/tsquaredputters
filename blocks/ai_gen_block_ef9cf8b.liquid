{% doc %}
  @prompt
    Perfect. We’ll have Shopify AI generate a LAB × Apple section — minimal, engineered, calm authority.
    
    Go to Add Section → Generate with AI and paste this exactly:
    
    SHOPIFY AI PROMPT (copy/paste)
    
    Create a full-width split section with a minimal, engineered aesthetic inspired by a blend of LAB Golf authority and Apple-level restraint.
    
    Layout:
    
    Two-column split.
    
    Left side: text block.
    
    Right side: single close-up image of a precision-milled putter head.
    
    Large white space around all elements.
    
    No borders. No shadows. No background graphics.
    
    Warm off-white background (not pure white).
    
    Tone:
    Quiet confidence. Engineered precision. No marketing hype. No long paragraphs.
    
    Content:
    
    Small eyebrow text above headline:
    “100% USA Milled”
    
    Headline:
    “Engineered to your stroke.”
    
    Subtext (stacked lines, not paragraph):
    Milled in our U.S. shop.
    Balanced for control.
    Finished your way.
    
    Primary button:
    “Begin Custom”
    Style: Outline button, thin border, no color fill.
    
    Design rules:
    
    Thin, modern typography.
    
    No red buttons.
    
    No heavy overlays.
    
    Plenty of spacing above and below.
    
    Image should feel industrial but clean.
    
    Section should feel calm and authoritative, not promotional.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-split-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-split-section__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 {{ block.settings.horizontal_padding }}px;
    align-items: center;
  }

  .ai-split-section__text-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.text_spacing }}px;
    padding-right: {{ block.settings.text_padding_right }}px;
  }

  .ai-split-section__eyebrow-{{ ai_gen_id }} {
    font-size: {{ block.settings.eyebrow_size }}px;
    font-weight: {{ block.settings.eyebrow_weight }};
    letter-spacing: {{ block.settings.eyebrow_spacing }}px;
    text-transform: uppercase;
    color: {{ block.settings.eyebrow_color }};
    margin: 0;
  }

  .ai-split-section__headline-{{ ai_gen_id }} {
    font-size: {{ block.settings.headline_size }}px;
    font-weight: {{ block.settings.headline_weight }};
    line-height: {{ block.settings.headline_line_height }};
    letter-spacing: {{ block.settings.headline_spacing }}px;
    color: {{ block.settings.headline_color }};
    margin: 0;
  }

  .ai-split-section__subtext-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.subtext_line_gap }}px;
    font-size: {{ block.settings.subtext_size }}px;
    font-weight: {{ block.settings.subtext_weight }};
    line-height: {{ block.settings.subtext_line_height }};
    letter-spacing: {{ block.settings.subtext_spacing }}px;
    color: {{ block.settings.subtext_color }};
  }

  .ai-split-section__subtext-line-{{ ai_gen_id }} {
    margin: 0;
  }

  .ai-split-section__button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    letter-spacing: {{ block.settings.button_letter_spacing }}px;
    text-transform: uppercase;
    text-decoration: none;
    color: {{ block.settings.button_text_color }};
    background-color: {{ block.settings.button_background }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    transition: all 0.3s ease;
    cursor: pointer;
    margin-top: {{ block.settings.button_margin_top }}px;
    align-self: flex-start;
  }

  .ai-split-section__button-{{ ai_gen_id }}:hover {
    color: {{ block.settings.button_hover_text_color }};
    background-color: {{ block.settings.button_hover_background }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  .ai-split-section__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: {{ block.settings.image_min_height }}px;
  }

  .ai-split-section__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-split-section__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    min-height: {{ block.settings.image_min_height }}px;
    background-color: #f5f5f5;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-split-section__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 400px;
    max-height: 400px;
  }

  .ai-split-section__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 14px;
    color: #999;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-split-section__container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-split-section__text-{{ ai_gen_id }} {
      padding-right: 0;
      order: {{ block.settings.mobile_text_order }};
    }

    .ai-split-section__image-wrapper-{{ ai_gen_id }} {
      order: {{ block.settings.mobile_image_order }};
    }

    .ai-split-section__headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_size | times: 0.7 }}px;
    }

    .ai-split-section__eyebrow-{{ ai_gen_id }} {
      font-size: {{ block.settings.eyebrow_size | times: 0.85 }}px;
    }

    .ai-split-section__subtext-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtext_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<split-section-{{ ai_gen_id }}
  class="ai-split-section-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-split-section__container-{{ ai_gen_id }}">
    <div class="ai-split-section__text-{{ ai_gen_id }}">
      {% if block.settings.eyebrow_text != blank %}
        <p class="ai-split-section__eyebrow-{{ ai_gen_id }}">
          {{ block.settings.eyebrow_text }}
        </p>
      {% endif %}

      {% if block.settings.headline_text != blank %}
        <h2 class="ai-split-section__headline-{{ ai_gen_id }}">
          {{ block.settings.headline_text }}
        </h2>
      {% endif %}

      {% if block.settings.subtext_line_1 != blank or block.settings.subtext_line_2 != blank or block.settings.subtext_line_3 != blank %}
        <div class="ai-split-section__subtext-{{ ai_gen_id }}">
          {% if block.settings.subtext_line_1 != blank %}
            <p class="ai-split-section__subtext-line-{{ ai_gen_id }}">
              {{ block.settings.subtext_line_1 }}
            </p>
          {% endif %}
          {% if block.settings.subtext_line_2 != blank %}
            <p class="ai-split-section__subtext-line-{{ ai_gen_id }}">
              {{ block.settings.subtext_line_2 }}
            </p>
          {% endif %}
          {% if block.settings.subtext_line_3 != blank %}
            <p class="ai-split-section__subtext-line-{{ ai_gen_id }}">
              {{ block.settings.subtext_line_3 }}
            </p>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.button_text != blank %}
        <a
          href="{{ block.settings.button_link }}"
          class="ai-split-section__button-{{ ai_gen_id }}"
        >
          {{ block.settings.button_text }}
        </a>
      {% endif %}
    </div>

    <div class="ai-split-section__image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.image %}
        <img
          src="{{ block.settings.image | image_url: width: 1200 }}"
          alt="{{ block.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
          class="ai-split-section__image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-split-section__image-placeholder-{{ ai_gen_id }}">
          {{ 'product-1' | placeholder_svg_tag }}
          <div class="ai-split-section__empty-state-{{ ai_gen_id }}">
            Add a close-up image of a precision-milled putter head
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</split-section-{{ ai_gen_id }}>

<script>
  (function() {
    class SplitSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('split-section-{{ ai_gen_id }}', SplitSection{{ ai_gen_id }});
  })();
</script>

