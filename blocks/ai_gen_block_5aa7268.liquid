              value="{{ form.first_name }}"
              {% if form.errors %}
                aria-invalid="true"
              {% endif %}
            >
          </div>

          <div class="tsq-form-row-{{ ai_gen_id }}">
            <input
              type="email"
              name="contact[email]"
              class="tsq-input-{{ ai_gen_id }}"
              placeholder="{{ block.settings.email_placeholder }}"
              value="{{ form.email }}"
              required
              aria-required="true"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              {% if form.errors %}
                aria-invalid="true"
                aria-describedby="tsq-form-error-{{ ai_gen_id }}"
