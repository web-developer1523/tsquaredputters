    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
    text-align: center;
    position: relative;
    overflow: hidden;
    width: {{ block.settings.desktop_width_percent }}%;
  }

  .tsq-drops-wrap-{{ ai_gen_id }} *,
  .tsq-drops-wrap-{{ ai_gen_id }} *::before,
  .tsq-drops-wrap-{{ ai_gen_id }} *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  {% if block.settings.show_noise_texture %}
  .tsq-drops-wrap-{{ ai_gen_id }}::before {
    content: '';
