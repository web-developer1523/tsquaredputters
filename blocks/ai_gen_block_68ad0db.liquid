{% doc %}
  @prompt
    Good. That’s clean and fast.
    
    If we’re letting Shopify AI generate the section, the key is the prompt.
    If you just say “make a hero banner,” it’ll give you something generic.
    
    You need to tell it:
    
    Minimal
    
    Cinematic
    
    No heavy overlays
    
    No bold sales copy
    
    Masters morning tone
    
    Quiet and premium
    
    🛠 What To Do
    
    Go to:
    
    Online Store → Themes → Customize
    Click Add Section
    Choose “Image banner”
    Then hit Generate with AI
    
    Paste this prompt exactly:
    
    SHOPIFY AI PROMPT
    
    Create a full-width hero banner section with a single background image.
    
    Style:
    Minimal, cinematic, peaceful early-morning golf tone. Inspired by a Masters morning — soft light, calm, inviting, refined.
    
    Design rules:
    
    No heavy gradient overlays.
    
    No bold fonts.
    
    Thin, elegant typography.
    
    Lots of negative space.
    
    Text centered horizontally and placed slightly lower than center vertically.
    
    Transparent header over the image.
    
    Content:
    Heading: “Before anything else.”
    Subheading: “Built from the ground up.”
    Primary button: “Build Yours” (outline style, subtle, not dominant)
    
    Spacing:
    Large vertical spacing.
    No secondary buttons.
    No additional blocks.
    
    Mood:
    Quiet confidence. Premium. Intentional. Not salesy.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-banner-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    min-height: {{ block.settings.min_height_desktop }}vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .ai-hero-banner__image-wrapper-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .ai-hero-banner__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ block.settings.image_position }};
  }

  .ai-hero-banner__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #e8f4ea 0%, #d4e7d7 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-hero-banner__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 400px;
    max-height: 400px;
    opacity: 0.3;
  }

  .ai-hero-banner__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 2;
  }

  .ai-hero-banner__content-{{ ai_gen_id }} {
    position: relative;
    z-index: 3;
    text-align: center;
    max-width: {{ block.settings.content_max_width }}px;
    padding: 40px 20px;
    margin-top: {{ block.settings.vertical_offset }}px;
  }

  .ai-hero-banner__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    color: {{ block.settings.text_color }};
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    letter-spacing: {{ block.settings.heading_letter_spacing }}px;
    line-height: 1.2;
    text-shadow: {{ block.settings.text_shadow_strength }}px {{ block.settings.text_shadow_strength }}px {{ block.settings.text_shadow_strength | times: 2 }}px rgba(0, 0, 0, {{ block.settings.text_shadow_opacity | divided_by: 100.0 }});
  }

  .ai-hero-banner__subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    font-weight: {{ block.settings.subheading_weight }};
    color: {{ block.settings.text_color }};
    margin: 0 0 {{ block.settings.button_spacing }}px;
    letter-spacing: {{ block.settings.subheading_letter_spacing }}px;
    line-height: 1.5;
    opacity: 0.9;
    text-shadow: {{ block.settings.text_shadow_strength }}px {{ block.settings.text_shadow_strength }}px {{ block.settings.text_shadow_strength | times: 2 }}px rgba(0, 0, 0, {{ block.settings.text_shadow_opacity | divided_by: 100.0 }});
  }

  .ai-hero-banner__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    letter-spacing: {{ block.settings.button_letter_spacing }}px;
    text-decoration: none;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .ai-hero-banner__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
    transform: translateY(-2px);
  }

  @media screen and (max-width: 749px) {
    .ai-hero-banner-{{ ai_gen_id }} {
      min-height: {{ block.settings.min_height_mobile }}vh;
    }

    .ai-hero-banner__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.6);
    }

    .ai-hero-banner__subheading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subheading_size }}px * 0.75);
    }

    .ai-hero-banner__button-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.button_font_size }}px * 0.9);
      padding: calc({{ block.settings.button_padding_vertical }}px * 0.8) calc({{ block.settings.button_padding_horizontal }}px * 0.8);
    }

    .ai-hero-banner__content-{{ ai_gen_id }} {
      margin-top: calc({{ block.settings.vertical_offset }}px * 0.5);
    }
  }
{% endstyle %}

<div class="ai-hero-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-hero-banner__image-wrapper-{{ ai_gen_id }}">
    {% if block.settings.image %}
      <img
        src="{{ block.settings.image | image_url: width: 2400 }}"
        srcset="{{ block.settings.image | image_url: width: 750 }} 750w,
                {{ block.settings.image | image_url: width: 1500 }} 1500w,
                {{ block.settings.image | image_url: width: 2400 }} 2400w"
        sizes="100vw"
        alt="{{ block.settings.image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.image.width }}"
        height="{{ block.settings.image.height }}"
        class="ai-hero-banner__image-{{ ai_gen_id }}"
      >
    {% else %}
      <div class="ai-hero-banner__image-placeholder-{{ ai_gen_id }}">
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>

  {% if block.settings.overlay_opacity > 0 %}
    <div class="ai-hero-banner__overlay-{{ ai_gen_id }}"></div>
  {% endif %}

  <div class="ai-hero-banner__content-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h1 class="ai-hero-banner__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h1>
    {% endif %}

    {% if block.settings.subheading != blank %}
      <p class="ai-hero-banner__subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
    {% endif %}

    {% if block.settings.button_text != blank %}
      <a
        href="{{ block.settings.button_link }}"
        class="ai-hero-banner__button-{{ ai_gen_id }}"
      >
        {{ block.settings.button_text }}
      </a>
    {% endif %}
  </div>
</div>

