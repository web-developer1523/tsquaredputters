{% doc %}
  @prompt
    Add a small text section directly under the customization area on this product page. Keep the same font, color, and style as the rest of the page, but make the text slightly smaller than the main body copy.
    
    Use this exact wording for the text:
    
    Customizer Disclaimer
    All selected colors will appear during the section of customization where they are chosen. When you switch to another section, some visual changes may not carry over in the preview. All of your selections are saved and will appear in the itemized list at checkout. Your putter will be built exactly to the specifications you choose.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-disclaimer-{{ ai_gen_id }} {
    margin-top: {{ block.settings.spacing_top }}px;
    margin-bottom: {{ block.settings.spacing_bottom }}px;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-disclaimer-heading-{{ ai_gen_id }} {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-style: var(--font-heading-style);
    letter-spacing: {{ settings.type_header_spacing | divided_by: 1000.0 }}em;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.3;
    margin: 0 0 {{ block.settings.text_spacing }}px 0;
    {% if settings.type_header_capitalize %}
      text-transform: uppercase;
    {% endif %}
  }

  .ai-disclaimer-text-{{ ai_gen_id }} {
    font-family: var(--font-body-family);
    font-weight: var(--font-body-weight);
    font-style: var(--font-body-style);
    letter-spacing: {{ settings.type_base_spacing | divided_by: 1000.0 }}em;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: {{ settings.type_base_line_height }};
    margin: 0;
  }
{% endstyle %}

<div class="ai-disclaimer-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h3 class="ai-disclaimer-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h3>
  {% endif %}
  {% if block.settings.text != blank %}
    <div class="ai-disclaimer-text-{{ ai_gen_id }}">{{ block.settings.text }}</div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Customizer disclaimer",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Customizer Disclaimer"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "All selected colors will appear during the section of customization where they are chosen. When you switch to another section, some visual changes may not carry over in the preview. All of your selections are saved and will appear in the itemized list at checkout. Your putter will be built exactly to the specifications you choose."
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 12,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Heading size",
      "default": 16
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Text size",
      "default": 14
    },
    {
      "type": "range",
      "id": "text_spacing",
      "min": 4,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Space between heading and text",
      "default": 8
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f5f5f5"
    },
    {
      "type": "range",
      "id": "padding",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 4
    },
    {
      "type": "range",
      "id": "spacing_top",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Space above",
      "default": 20
    },
    {
      "type": "range",
      "id": "spacing_bottom",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Space below",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Customizer disclaimer"
    }
  ]
}
{% endschema %}
