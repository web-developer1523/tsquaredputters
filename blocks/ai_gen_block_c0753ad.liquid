{% doc %}
  @prompt
    Two-column layout.
    
    Left side: headline, short body copy, key bullet points, and a CTA button that scrolls to the form.
    
    Right side: a horizontal scrolling image carousel (auto-scroll + draggable) showing 8–12 images (product photos, lifestyle shots, and corporate/outings style images). Use rounded corners and a subtle shadow. Pause on hover.
    
    Layout (mobile):
    
    Stack vertically: headline and copy first, then the carousel, then the form.
    
    Copy requirements:
    
    Headline ideas: “Corporate Gifts & Custom Programs” or “Premium Corporate Gifting”
    
    Body copy should explain this is ideal for client gifts, employee recognition, tournaments, outings, and special events.
    
    Clearly state that all corporate orders are custom quoted based on quantity, customization, and timeline.
    
    Add a reassurance line: “Our team will confirm pricing, options, and delivery timeline within 1 business day.”
    
    Key bullet points (with small icons):
    
    Custom quoting for every order
    
    Branding and customization options available
    
    Production and delivery timeline support
    
    Dedicated account support
    
    CTA button:
    
    “Request a Custom Quote” (scrolls to form)
    
    Inquiry form requirements:
    Build a clean, professional inquiry form with the following fields:
    
    Full Name (required)
    
    Company / Organization (required)
    
    Email (required)
    
    Phone (optional)
    
    Estimated Quantity Needed (required)
    
    Date Needed (required)
    
    Customization Interest (checkboxes): Logo engraving, Color options, Unsure
    
    Notes / Details (textarea)
    
    Required checkbox: “I understand this is a custom quote request, not an order”
    
    Form behavior:
    
    Show a success message on submit.
    
    Send submissions to the store contact email.
    
    Use spam protection (honeypot or built-in Shopify protection).
    
    Design details:
    
    Keep spacing clean and premium.
    
    Use existing fonts and buttons.
    
    Match overall site aesthetic.
    
    Section below the form:
    Add a simple “How It Works” section with 3 steps:
    
    Submit your request
    
    We confirm pricing, options, and timeline
    
    Approve de
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-corporate-gifts-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 20px;
  }

  .ai-corporate-gifts-container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }

  .ai-corporate-gifts-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
    margin-bottom: 80px;
  }

  .ai-corporate-gifts-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .ai-corporate-gifts-headline-{{ ai_gen_id }} {
    font-size: {{ block.settings.headline_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.2;
  }

  .ai-corporate-gifts-body-{{ ai_gen_id }} {
    font-size: {{ block.settings.body_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin: 0;
  }

  .ai-corporate-gifts-bullets-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 8px 0;
  }

  .ai-corporate-gifts-bullet-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: {{ block.settings.body_size }}px;
    color: {{ block.settings.text_color }};
  }

  .ai-corporate-gifts-bullet-icon-{{ ai_gen_id }} {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    color: {{ block.settings.accent_color }};
  }

  .ai-corporate-gifts-cta-{{ ai_gen_id }} {
    display: inline-block;
    padding: 16px 32px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    font-size: {{ block.settings.button_size }}px;
    cursor: pointer;
    transition: background-color 0.3s ease;
    border: none;
    font-weight: 600;
  }

  .ai-corporate-gifts-cta-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-corporate-gifts-carousel-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
  }

  .ai-corporate-gifts-carousel-{{ ai_gen_id }} {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    cursor: grab;
    user-select: none;
  }

  .ai-corporate-gifts-carousel-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-corporate-gifts-carousel-{{ ai_gen_id }}.dragging {
    cursor: grabbing;
    scroll-behavior: auto;
  }

  .ai-corporate-gifts-carousel-{{ ai_gen_id }}.paused {
    animation-play-state: paused;
  }

  .ai-corporate-gifts-carousel-item-{{ ai_gen_id }} {
    flex: 0 0 auto;
    width: {{ block.settings.carousel_image_width }}px;
    height: {{ block.settings.carousel_image_height }}px;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
  }

  .ai-corporate-gifts-carousel-item-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
  }

  .ai-corporate-gifts-carousel-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-corporate-gifts-carousel-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-corporate-gifts-form-section-{{ ai_gen_id }} {
    background-color: {{ block.settings.form_background_color }};
    padding: 60px 40px;
    border-radius: {{ block.settings.form_border_radius }}px;
    margin-bottom: 60px;
  }

  .ai-corporate-gifts-form-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.form_title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 32px;
    text-align: center;
  }

  .ai-corporate-gifts-form-{{ ai_gen_id }} {
    max-width: 800px;
    margin: 0 auto;
  }

  .ai-corporate-gifts-form-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 20px;
  }

  .ai-corporate-gifts-form-field-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-corporate-gifts-form-field-full-{{ ai_gen_id }} {
    grid-column: 1 / -1;
  }

  .ai-corporate-gifts-form-label-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
  }

  .ai-corporate-gifts-form-required-{{ ai_gen_id }} {
    color: {{ block.settings.accent_color }};
  }

  .ai-corporate-gifts-form-input-{{ ai_gen_id }},
  .ai-corporate-gifts-form-textarea-{{ ai_gen_id }},
  .ai-corporate-gifts-form-select-{{ ai_gen_id }} {
    padding: 12px 16px;
    border: 1px solid {{ block.settings.input_border_color }};
    border-radius: 4px;
    font-size: 16px;
    font-family: inherit;
    background-color: #ffffff;
  }

  .ai-corporate-gifts-form-textarea-{{ ai_gen_id }} {
    min-height: 120px;
    resize: vertical;
  }

  .ai-corporate-gifts-form-checkboxes-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-corporate-gifts-form-checkbox-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ai-corporate-gifts-form-checkbox-{{ ai_gen_id }} {
    width: 18px;
    height: 18px;
    cursor: pointer;
  }

  .ai-corporate-gifts-form-checkbox-label-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.text_color }};
    cursor: pointer;
  }

  .ai-corporate-gifts-form-submit-{{ ai_gen_id }} {
    width: 100%;
    padding: 16px 32px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    font-size: {{ block.settings.button_size }}px;
    cursor: pointer;
    transition: background-color 0.3s ease;
    font-weight: 600;
    margin-top: 20px;
  }

  .ai-corporate-gifts-form-submit-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-corporate-gifts-form-success-{{ ai_gen_id }} {
    background-color: #d4edda;
    color: #155724;
    padding: 16px;
    border-radius: 4px;
    margin-bottom: 20px;
    text-align: center;
  }

  .ai-corporate-gifts-form-error-{{ ai_gen_id }} {
    background-color: #f8d7da;
    color: #721c24;
    padding: 16px;
    border-radius: 4px;
    margin-bottom: 20px;
    text-align: center;
  }

  .ai-corporate-gifts-honeypot-{{ ai_gen_id }} {
    position: absolute;
    left: -9999px;
    opacity: 0;
    pointer-events: none;
  }

  .ai-corporate-gifts-how-it-works-{{ ai_gen_id }} {
    padding: 60px 20px;
    background-color: {{ block.settings.how_it_works_bg }};
  }

  .ai-corporate-gifts-how-it-works-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.form_title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 48px;
    text-align: center;
  }

  .ai-corporate-gifts-steps-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-corporate-gifts-step-{{ ai_gen_id }} {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .ai-corporate-gifts-step-number-{{ ai_gen_id }} {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background-color: {{ block.settings.accent_color }};
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 28px;
    font-weight: 700;
  }

  .ai-corporate-gifts-step-title-{{ ai_gen_id }} {
    font-size: 20px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-corporate-gifts-step-description-{{ ai_gen_id }} {
    font-size: 16px;
    color: {{ block.settings.text_color }};
    line-height: 1.5;
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .ai-corporate-gifts-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .ai-corporate-gifts-headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_size | times: 0.8 }}px;
    }

    .ai-corporate-gifts-carousel-item-{{ ai_gen_id }} {
      width: {{ block.settings.carousel_image_width | times: 0.8 }}px;
      height: {{ block.settings.carousel_image_height | times: 0.8 }}px;
    }

    .ai-corporate-gifts-form-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-corporate-gifts-steps-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .ai-corporate-gifts-form-section-{{ ai_gen_id }} {
      padding: 40px 24px;
    }
  }
{% endstyle %}

<corporate-gifts-{{ ai_gen_id }} class="ai-corporate-gifts-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-corporate-gifts-container-{{ ai_gen_id }}">
    <div class="ai-corporate-gifts-grid-{{ ai_gen_id }}">
      <div class="ai-corporate-gifts-content-{{ ai_gen_id }}">
        {% if block.settings.headline != blank %}
          <h1 class="ai-corporate-gifts-headline-{{ ai_gen_id }}">{{ block.settings.headline }}</h1>
        {% endif %}

        {% if block.settings.body_copy != blank %}
          <div class="ai-corporate-gifts-body-{{ ai_gen_id }}">{{ block.settings.body_copy }}</div>
        {% endif %}

        <div class="ai-corporate-gifts-bullets-{{ ai_gen_id }}">
          {% if block.settings.bullet_1 != blank %}
            <div class="ai-corporate-gifts-bullet-{{ ai_gen_id }}">
              <svg class="ai-corporate-gifts-bullet-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>{{ block.settings.bullet_1 }}</span>
            </div>
          {% endif %}

          {% if block.settings.bullet_2 != blank %}
            <div class="ai-corporate-gifts-bullet-{{ ai_gen_id }}">
              <svg class="ai-corporate-gifts-bullet-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>{{ block.settings.bullet_2 }}</span>
            </div>
          {% endif %}

          {% if block.settings.bullet_3 != blank %}
            <div class="ai-corporate-gifts-bullet-{{ ai_gen_id }}">
              <svg class="ai-corporate-gifts-bullet-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>{{ block.settings.bullet_3 }}</span>
            </div>
          {% endif %}

          {% if block.settings.bullet_4 != blank %}
            <div class="ai-corporate-gifts-bullet-{{ ai_gen_id }}">
              <svg class="ai-corporate-gifts-bullet-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>{{ block.settings.bullet_4 }}</span>
            </div>
          {% endif %}
        </div>

        {% if block.settings.reassurance_text != blank %}
          <div class="ai-corporate-gifts-body-{{ ai_gen_id }}">{{ block.settings.reassurance_text }}</div>
        {% endif %}

        <div>
          <button class="ai-corporate-gifts-cta-{{ ai_gen_id }}" data-scroll-to-form>
            {{ block.settings.cta_text }}
          </button>
        </div>
      </div>

      <div class="ai-corporate-gifts-carousel-wrapper-{{ ai_gen_id }}">
        <div class="ai-corporate-gifts-carousel-{{ ai_gen_id }}" data-carousel>
          {% for i in (1..12) %}
            {% assign image_key = 'carousel_image_' | append: i %}
            {% assign image = block.settings[image_key] %}
            
            {% if image != blank %}
              <div class="ai-corporate-gifts-carousel-item-{{ ai_gen_id }}">
                <img
                  src="{{ image | image_url: width: 800 }}"
                  alt="{{ image.alt | escape }}"
                  loading="lazy"
                  width="800"
                  height="600"
                >
              </div>
            {% elsif i <= 3 %}
              <div class="ai-corporate-gifts-carousel-item-{{ ai_gen_id }}">
                <div class="ai-corporate-gifts-carousel-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>

    <div class="ai-corporate-gifts-form-section-{{ ai_gen_id }}" id="corporate-quote-form-{{ ai_gen_id }}">
      <h3 class="ai-corporate-gifts-form-title-{{ ai_gen_id }}">{{ block.settings.form_title }}</h3>

      {%- form 'contact' -%}
        <input type="hidden" name="contact[form_type]" value="Corporate Quote Request">
        
        <div class="ai-corporate-gifts-honeypot-{{ ai_gen_id }}">
          <input type="text" name="contact[honeypot]" tabindex="-1" autocomplete="off">
        </div>

        <div class="ai-corporate-gifts-form-{{ ai_gen_id }}">
          {%- if form.posted_successfully? -%}
            <div class="ai-corporate-gifts-form-success-{{ ai_gen_id }}">
              {{ block.settings.success_message }}
            </div>
          {%- endif -%}

          {%- if form.errors -%}
            <div class="ai-corporate-gifts-form-error-{{ ai_gen_id }}">
              Please correct the errors below and try again.
            </div>
          {%- endif -%}

          <div class="ai-corporate-gifts-form-grid-{{ ai_gen_id }}">
            <div class="ai-corporate-gifts-form-field-{{ ai_gen_id }}">
              <label class="ai-corporate-gifts-form-label-{{ ai_gen_id }}">
                Full Name <span class="ai-corporate-gifts-form-required-{{ ai_gen_id }}">*</span>
              </label>
              <input
                type="text"
                name="contact[full_name]"
                class="ai-corporate-gifts-form-input-{{ ai_gen_id }}"
                required
                value="{{ form.full_name }}"
              >
            </div>

            <div class="ai-corporate-gifts-form-field-{{ ai_gen_id }}">
              <label class="ai-corporate-gifts-form-label-{{ ai_gen_id }}">
                Company / Organization <span class="ai-corporate-gifts-form-required-{{ ai_gen_id }}">*</span>
              </label>
              <input
                type="text"
                name="contact[company]"
                class="ai-corporate-gifts-form-input-{{ ai_gen_id }}"
                required
                value="{{ form.company }}"
              >
            </div>

            <div class="ai-corporate-gifts-form-field-{{ ai_gen_id }}">
              <label class="ai-corporate-gifts-form-label-{{ ai_gen_id }}">
                Email <span class="ai-corporate-gifts-form-required-{{ ai_gen_id }}">*</span>
              </label>
              <input
                type="email"
                name="contact[email]"
                class="ai-corporate-gifts-form-input-{{ ai_gen_id }}"
                required
                value="{{ form.email }}"
              >
            </div>

            <div class="ai-corporate-gifts-form-field-{{ ai_gen_id }}">
              <label class="ai-corporate-gifts-form-label-{{ ai_gen_id }}">
                Phone
              </label>
              <input
                type="tel"
                name="contact[phone]"
                class="ai-corporate-gifts-form-input-{{ ai_gen_id }}"
                value="{{ form.phone }}"
              >
            </div>

            <div class="ai-corporate-gifts-form-field-{{ ai_gen_id }}">
              <label class="ai-corporate-gifts-form-label-{{ ai_gen_id }}">
                Estimated Quantity Needed <span class="ai-corporate-gifts-form-required-{{ ai_gen_id }}">*</span>
              </label>
              <input
                type="text"
                name="contact[quantity]"
                class="ai-corporate-gifts-form-input-{{ ai_gen_id }}"
                required
                value="{{ form.quantity }}"
              >
            </div>

            <div class="ai-corporate-gifts-form-field-{{ ai_gen_id }}">
              <label class="ai-corporate-gifts-form-label-{{ ai_gen_id }}">
                Date Needed <span class="ai-corporate-gifts-form-required-{{ ai_gen_id }}">*</span>
              </label>
              <input
                type="text"
                name="contact[date_needed]"
                class="ai-corporate-gifts-form-input-{{ ai_gen_id }}"
                placeholder="MM/DD/YYYY"
                required
                value="{{ form.date_needed }}"
              >
            </div>

            <div class="ai-corporate-gifts-form-field-{{ ai_gen_id }} ai-corporate-gifts-form-field-full-{{ ai_gen_id }}">
              <label class="ai-corporate-gifts-form-label-{{ ai_gen_id }}">
                Customization Interest
              </label>
              <div class="ai-corporate-gifts-form-checkboxes-{{ ai_gen_id }}">
                <div class="ai-corporate-gifts-form-checkbox-wrapper-{{ ai_gen_id }}">
                  <input
                    type="checkbox"
                    name="contact[customization_logo]"
                    id="customization-logo-{{ ai_gen_id }}"
                    class="ai-corporate-gifts-form-checkbox-{{ ai_gen_id }}"
                    value="Logo engraving"
                  >
                  <label for="customization-logo-{{ ai_gen_id }}" class="ai-corporate-gifts-form-checkbox-label-{{ ai_gen_id }}">
                    Logo engraving
                  </label>
                </div>
                <div class="ai-corporate-gifts-form-checkbox-wrapper-{{ ai_gen_id }}">
                  <input
                    type="checkbox"
                    name="contact[customization_color]"
                    id="customization-color-{{ ai_gen_id }}"
                    class="ai-corporate-gifts-form-checkbox-{{ ai_gen_id }}"
                    value="Color options"
                  >
                  <label for="customization-color-{{ ai_gen_id }}" class="ai-corporate-gifts-form-checkbox-label-{{ ai_gen_id }}">
                    Color options
                  </label>
                </div>
                <div class="ai-corporate-gifts-form-checkbox-wrapper-{{ ai_gen_id }}">
                  <input
                    type="checkbox"
                    name="contact[customization_unsure]"
                    id="customization-unsure-{{ ai_gen_id }}"
                    class="ai-corporate-gifts-form-checkbox-{{ ai_gen_id }}"
                    value="Unsure"
                  >
                  <label for="customization-unsure-{{ ai_gen_id }}" class="ai-corporate-gifts-form-checkbox-label-{{ ai_gen_id }}">
                    Unsure
                  </label>
                </div>
              </div>
            </div>

            <div class="ai-corporate-gifts-form-field-{{ ai_gen_id }} ai-corporate-gifts-form-field-full-{{ ai_gen_id }}">
              <label class="ai-corporate-gifts-form-label-{{ ai_gen_id }}">
                Notes / Details
              </label>
              <textarea
                name="contact[notes]"
                class="ai-corporate-gifts-form-textarea-{{ ai_gen_id }}"
              >{{ form.notes }}</textarea>
            </div>

            <div class="ai-corporate-gifts-form-field-{{ ai_gen_id }} ai-corporate-gifts-form-field-full-{{ ai_gen_id }}">
              <div class="ai-corporate-gifts-form-checkbox-wrapper-{{ ai_gen_id }}">
                <input
                  type="checkbox"
                  name="contact[acknowledgement]"
                  id="acknowledgement-{{ ai_gen_id }}"
                  class="ai-corporate-gifts-form-checkbox-{{ ai_gen_id }}"
                  required
                  value="I understand this is a custom quote request, not an order"
                >
                <label for="acknowledgement-{{ ai_gen_id }}" class="ai-corporate-gifts-form-checkbox-label-{{ ai_gen_id }}">
                  I understand this is a custom quote request, not an order <span class="ai-corporate-gifts-form-required-{{ ai_gen_id }}">*</span>
                </label>
              </div>
            </div>
          </div>

          <button type="submit" class="ai-corporate-gifts-form-submit-{{ ai_gen_id }}">
            {{ block.settings.form_submit_text }}
          </button>
        </div>
      {%- endform -%}
    </div>

