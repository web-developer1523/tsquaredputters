<script>
  (function() {
    class CorporateGifts{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.carousel = null;
        this.isDragging = false;
        this.startX = 0;
        this.scrollLeft = 0;
        this.autoScrollInterval = null;
      }

      connectedCallback() {
        this.carousel = this.querySelector('[data-carousel]');
        this.ctaButton = this.querySelector('[data-scroll-to-form]');
        
        if (this.carousel) {
          this.setupCarousel();
        }
        
        if (this.ctaButton) {
          this.setupScrollButton();
        }
      }

      setupCarousel() {
        this.carousel.addEventListener('mousedown', this.handleDragStart.bind(this));
        this.carousel.addEventListener('mousemove', this.handleDragMove.bind(this));
        this.carousel.addEventListener('mouseup', this.handleDragEnd.bind(this));
        this.carousel.addEventListener('mouseleave', this.handleDragEnd.bind(this));
        this.carousel.addEventListener('mouseenter', this.pauseAutoScroll.bind(this));
        this.carousel.addEventListener('mouseleave', this.resumeAutoScroll.bind(this));

        this.carousel.addEventListener('touchstart', this.handleDragStart.bind(this));
        this.carousel.addEventListener('touchmove', this.handleDragMove.bind(this));
        this.carousel.addEventListener('touchend', this.handleDragEnd.bind(this));

        this.startAutoScroll();
      }

      handleDragStart(e) {
        this.isDragging = true;
        this.carousel.classList.add('dragging');
        this.startX = e.type.includes('mouse') ? e.pageX : e.touches[0].pageX;
        this.scrollLeft = this.carousel.scrollLeft;
        this.pauseAutoScroll();
      }

      handleDragMove(e) {
        if (!this.isDragging) return;
        e.preventDefault();
        const x = e.type.includes('mouse') ? e.pageX : e.touches[0].pageX;
        const walk = (x - this.startX) * 2;
        this.carousel.scrollLeft = this.scrollLeft - walk;
      }

      handleDragEnd() {
        this.isDragging = false;
        this.carousel.classList.remove('dragging');
        this.resumeAutoScroll();
      }

      startAutoScroll() {
        this.autoScrollInterval = setInterval(() => {
          if (this.carousel.scrollLeft >= this.carousel.scrollWidth - this.carousel.clientWidth) {
            this.carousel.scrollLeft = 0;
          } else {
            this.carousel.scrollLeft += 1;
          }
        }, 30);
      }

      pauseAutoScroll() {
        if (this.autoScrollInterval) {
          clearInterval(this.autoScrollInterval);
          this.autoScrollInterval = null;
        }
      }

      resumeAutoScroll() {
        if (!this.autoScrollInterval && !this.isDragging) {
          this.startAutoScroll();
        }
      }

      setupScrollButton() {
        this.ctaButton.addEventListener('click', (e) => {
          e.preventDefault();
          const formSection = this.querySelector('.ai-corporate-gifts-form-section-{{ ai_gen_id }}');
          if (formSection) {
            formSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
      }

      disconnectedCallback() {
        this.pauseAutoScroll();
      }
    }

    customElements.define('corporate-gifts-{{ ai_gen_id }}', CorporateGifts{{ ai_gen_id }});
  })();
</script>

