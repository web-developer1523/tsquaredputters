{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-tzero-block-{{ ai_gen_id }} {
    display: block;
    position: relative;
    max-width: {{ block.settings.max_width }}px;
    width: {{ block.settings.desktop_width_percent }}%;
    margin: 0 auto;
    background: {{ block.settings.background_color }};
    border: 1px solid {{ block.settings.border_color }};
    overflow: hidden;
  }

  .ai-tzero-block-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: {{ block.settings.accent_line_width }}px;
    height: 100%;
    background: linear-gradient(180deg, {{ block.settings.accent_color }} 0%, {{ block.settings.accent_color_mid }} 50%, {{ block.settings.accent_color }} 100%);
    z-index: 1;
  }

  .ai-tzero-block-{{ ai_gen_id }}::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 1;
    opacity: {{ block.settings.grain_opacity }};
  }

  .ai-tzero-inner-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_vertical }}px calc({{ block.settings.padding_horizontal }}px + {{ block.settings.accent_line_width }}px);
    display: grid;
    grid-template-columns: 1fr auto;
    gap: {{ block.settings.grid_gap }}px;
    align-items: start;
  }

  .ai-tzero-badge-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: {{ block.settings.badge_bg_color }};
    border: 1px solid {{ block.settings.badge_border_color }};
    padding: 4px 12px;
    margin-bottom: 20px;
  }

  .ai-tzero-badge-dot-{{ ai_gen_id }} {
    width: 7px;
    height: 7px;
    background: {{ block.settings.accent_color }};
    border-radius: 50%;
  }

  .ai-tzero-badge-text-{{ ai_gen_id }} {
    font-weight: 600;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: {{ block.settings.accent_color }};
  }

  .ai-tzero-headline-{{ ai_gen_id }} {
    font-size: {{ block.settings.headline_size }}px;
    line-height: {{ block.settings.headline_line_height }};
    letter-spacing: 0.02em;
    color: {{ block.settings.headline_color }};
    margin-bottom: 4px;
  }

  .ai-tzero-headline-{{ ai_gen_id }} span {
    color: {{ block.settings.accent_color }};
  }

  .ai-tzero-subhead-{{ ai_gen_id }} {
    font-weight: 300;
    font-style: italic;
    font-size: {{ block.settings.subhead_size }}px;
    color: {{ block.settings.subhead_color }};
    letter-spacing: 0.04em;
    margin-bottom: 28px;
  }

  .ai-tzero-divider-{{ ai_gen_id }} {
    width: {{ block.settings.divider_width }}px;
    height: 1px;
    background: linear-gradient(90deg, {{ block.settings.accent_color }}, transparent);
    margin-bottom: 24px;
  }

  .ai-tzero-body-{{ ai_gen_id }} {
    font-size: {{ block.settings.body_size }}px;
    line-height: {{ block.settings.body_line_height }};
    color: {{ block.settings.body_color }};
    font-weight: 300;
    max-width: 460px;
  }

  .ai-tzero-body-{{ ai_gen_id }} strong {
    color: {{ block.settings.accent_color_mid }};
    font-weight: 600;
  }

  .ai-tzero-stat-box-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border: 1px solid {{ block.settings.border_color }};
    padding: {{ block.settings.stat_padding }}px 28px;
    min-width: {{ block.settings.stat_min_width }}px;
    text-align: center;
    position: relative;
    flex-shrink: 0;
    align-self: stretch;
    background: {{ block.settings.stat_bg_color }};
  }

  .ai-tzero-stat-box-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: {{ block.settings.accent_color }};
  }

  .ai-tzero-stat-number-{{ ai_gen_id }} {
    font-size: {{ block.settings.stat_number_size }}px;
    line-height: 1;
    color: {{ block.settings.accent_color }};
    letter-spacing: 0.02em;
  }

  .ai-tzero-stat-label-{{ ai_gen_id }} {
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: {{ block.settings.stat_label_color }};
    font-weight: 600;
    margin-top: 6px;
    line-height: 1.4;
  }

  .ai-tzero-stat-unit-{{ ai_gen_id }} {
    font-size: 12px;
    color: {{ block.settings.subhead_color }};
    font-weight: 300;
    font-style: italic;
    margin-top: 8px;
  }

  .ai-tzero-strip-{{ ai_gen_id }} {
    border-top: 1px solid {{ block.settings.strip_border_color }};
    padding: 14px calc({{ block.settings.padding_horizontal }}px + {{ block.settings.accent_line_width }}px);
    display: flex;
    align-items: center;
    gap: 12px;
    position: relative;
    z-index: 2;
  }

  .ai-tzero-strip-icon-{{ ai_gen_id }} {
    width: 16px;
    height: 16px;
    border: 1px solid {{ block.settings.accent_color }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .ai-tzero-strip-icon-{{ ai_gen_id }} svg {
    width: 8px;
    height: 8px;
    fill: {{ block.settings.accent_color }};
  }

  .ai-tzero-strip-text-{{ ai_gen_id }} {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: {{ block.settings.strip_text_color }};
    font-weight: 600;
  }

  .ai-tzero-strip-text-{{ ai_gen_id }} em {
    color: {{ block.settings.accent_color }};
    font-style: normal;
  }

  @media screen and (max-width: 749px) {
    .ai-tzero-inner-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      padding: {{ block.settings.padding_vertical | times: 0.7 }}px {{ block.settings.padding_horizontal | times: 0.7 }}px {{ block.settings.padding_vertical | times: 0.7 }}px calc({{ block.settings.padding_horizontal | times: 0.7 }}px + {{ block.settings.accent_line_width }}px);
    }

    .ai-tzero-stat-box-{{ ai_gen_id }} {
      flex-direction: row;
      gap: 16px;
      padding: 20px 24px;
      min-width: auto;
    }

    .ai-tzero-headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_size | times: 0.7 }}px;
    }

    .ai-tzero-stat-number-{{ ai_gen_id }} {
      font-size: {{ block.settings.stat_number_size | times: 0.8 }}px;
    }

    .ai-tzero-strip-{{ ai_gen_id }} {
      padding: 14px calc({{ block.settings.padding_horizontal | times: 0.7 }}px + {{ block.settings.accent_line_width }}px);
    }
  }
{% endstyle %}

<div class="ai-tzero-block-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-tzero-inner-{{ ai_gen_id }}">
    <div>
      {% if block.settings.show_badge %}
        <div class="ai-tzero-badge-{{ ai_gen_id }}">
          <span class="ai-tzero-badge-dot-{{ ai_gen_id }}"></span>
          <span class="ai-tzero-badge-text-{{ ai_gen_id }}">{{ block.settings.badge_text }}</span>
        </div>
      {% endif %}

      {% if block.settings.headline != blank %}
        <h2 class="ai-tzero-headline-{{ ai_gen_id }}">{{ block.settings.headline }}</h2>
      {% endif %}

      {% if block.settings.subhead != blank %}
        <div class="ai-tzero-subhead-{{ ai_gen_id }}">{{ block.settings.subhead }}</div>
      {% endif %}

      {% if block.settings.show_divider %}
        <div class="ai-tzero-divider-{{ ai_gen_id }}"></div>
      {% endif %}

      {% if block.settings.body_text != blank %}
        <div class="ai-tzero-body-{{ ai_gen_id }}">{{ block.settings.body_text }}</div>
      {% endif %}
    </div>

    {% if block.settings.show_stat %}
      <div class="ai-tzero-stat-box-{{ ai_gen_id }}">
        <div class="ai-tzero-stat-number-{{ ai_gen_id }}">{{ block.settings.stat_number }}</div>
        <div class="ai-tzero-stat-label-{{ ai_gen_id }}">{{ block.settings.stat_label }}</div>
        {% if block.settings.stat_unit != blank %}
          <div class="ai-tzero-stat-unit-{{ ai_gen_id }}">{{ block.settings.stat_unit }}</div>
        {% endif %}
      </div>
    {% endif %}
  </div>

  {% if block.settings.show_strip %}
    <div class="ai-tzero-strip-{{ ai_gen_id }}">
      <div class="ai-tzero-strip-icon-{{ ai_gen_id }}">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
          <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
        </svg>
      </div>
      <div class="ai-tzero-strip-text-{{ ai_gen_id }}">{{ block.settings.strip_text }}</div>
    </div>
  {% endif %}
</div>

