      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    
      body {
        background: #0a0a0a;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        padding: 2rem;
        font-family: 'Barlow', sans-serif;
      }
    
      .block {
        position: relative;
        max-width: 780px;
        width: 100%;
        background: #0d0d0d;
        border: 1px solid #2a2a2a;
        overflow: hidden;
      }
    
      /* Diagonal accent line */
      .block::before {
        content: '';
        position: absolute;
        top: 0; left: 0;
        width: 4px;
        height: 100%;
        background: linear-gradient(180deg, #cc1111 0%, #ff2222 50%, #cc1111 100%);
      }
    
      /* Grain texture overlay */
      .block::after {
        content: '';
        position: absolute;
        inset: 0;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
        pointer-events: none;
        z-index: 1;
        opacity: 0.4;
      }
    
      .inner {
        position: relative;
        z-index: 2;
        padding: 3rem 3rem 3rem 3.5rem;
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 2rem;
        align-items: start;
      }
    
      .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: #cc111118;
        border: 1px solid #cc111155;
        padding: 0.25rem 0.75rem;
        margin-bottom: 1.25rem;
      }
    
      .badge-dot {
        width: 7px;
        height: 7px;
        background: #cc1111;
        border-radius: 50%;
        animation: pulse 2s ease-in-out infinite;
      }
    
      @keyframes pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.4; transform: scale(0.7); }
      }
    
      .badge-text {
        font-family: 'Barlow', sans-serif;
        font-weight: 600;
        font-size: 0.6rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: #cc1111;
      }
    
      .headline {
        font-family: 'Bebas Neue', sans-serif;
        font-size: clamp(2.8rem, 6vw, 4.2rem);
        line-height: 0.92;
        letter-spacing: 0.02em;
        color: #f5f0e8;
        margin-bottom: 0.25rem;
      }
    
      .headline span {
        color: #cc1111;
      }
    
      .subhead {
        font-family: 'Barlow', sans-serif;
        font-weight: 300;
        font-style: italic;
        font-size: 0.95rem;
        color: #888;
        letter-spacing: 0.04em;
        margin-bottom: 1.75rem;
      }
    
      .divider {
        width: 48px;
        height: 1px;
        background: linear-gradient(90deg, #cc1111, transparent);
        margin-bottom: 1.5rem;
      }
    
      .body-text {
        font-size: 0.95rem;
        line-height: 1.7;
        color: #bbb;
        font-weight: 300;
        max-width: 460px;
      }
    
      .body-text strong {
        color: #ff3333;
        font-weight: 600;
      }
    
    
    
      .stat-box {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        border: 1px solid #2a2a2a;
        padding: 2rem 1.75rem;
        min-width: 140px;
        text-align: center;
        position: relative;
        flex-shrink: 0;
        align-self: stretch;
        background: #080808;
      }
    
      .stat-box::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 2px;
        background: #cc1111;
      }
    
      .stat-number {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 3.8rem;
        line-height: 1;
        color: #cc1111;
        letter-spacing: 0.02em;
      }
    
      .stat-label {
        font-size: 0.6rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: #555;
        font-weight: 600;
        margin-top: 0.4rem;
        line-height: 1.4;
      }
    
      .stat-unit {
        font-family: 'Barlow', sans-serif;
        font-size: 0.75rem;
        color: #888;
        font-weight: 300;
        font-style: italic;
        margin-top: 0.5rem;
      }
    
      /* Bottom strip */
      .strip {
        border-top: 1px solid #1e1e1e;
        padding: 0.9rem 3.5rem;
        display: flex;
        align-items: center;
