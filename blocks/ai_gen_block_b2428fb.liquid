{% doc %}
  @prompt
    I would like to add a new section on each product page that explains customization options. Specifically, I want an area that tells customers we can alter colors if they provide a reference image, and another area where they can reach out for custom engravings or logo work. Please add a clearly visible customization block beneath the main product details with a short description and a contact button/form for these requests.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-customization-options-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    padding: 40px 20px;
    margin: 40px 0;
    border-radius: {{ block.settings.border_radius }}px;
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
  }

  .ai-customization-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-customization-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 30px;
  }

  .ai-customization-title-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 10px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .ai-customization-subtitle-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.subtitle_size }}px;
    margin: 0;
  }

  .ai-customization-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: 30px;
    margin-bottom: 30px;
  }

  @media screen and (min-width: 750px) {
    .ai-customization-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr 1fr;
    }
  }

  .ai-customization-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    padding: 30px;
    border-radius: {{ block.settings.card_border_radius }}px;
    border: 1px solid {{ block.settings.card_border_color }};
  }

  .ai-customization-card-icon-{{ ai_gen_id }} {
    width: 50px;
    height: 50px;
    margin-bottom: 15px;
    color: {{ block.settings.icon_color }};
  }

  .ai-customization-card-title-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.card_title_size }}px;
    margin: 0 0 10px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-customization-card-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
    margin: 0;
  }

  .ai-customization-form-wrapper-{{ ai_gen_id }} {
    background-color: {{ block.settings.form_background }};
    padding: 30px;
    border-radius: {{ block.settings.card_border_radius }}px;
    border: 1px solid {{ block.settings.card_border_color }};
  }

  .ai-customization-form-title-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.card_title_size }}px;
    margin: 0 0 20px;
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-customization-form-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .ai-customization-form-group-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .ai-customization-label-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: 14px;
    font-weight: 600;
  }

  .ai-customization-input-{{ ai_gen_id }},
  .ai-customization-textarea-{{ ai_gen_id }} {
    padding: 12px 15px;
    border: 1px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    font-size: 16px;
    font-family: inherit;
    background-color: #ffffff;
  }

  .ai-customization-textarea-{{ ai_gen_id }} {
    min-height: 120px;
    resize: vertical;
  }

  .ai-customization-submit-{{ ai_gen_id }} {
    padding: 15px 30px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .ai-customization-submit-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-customization-message-{{ ai_gen_id }} {
    padding: 15px;
    border-radius: {{ block.settings.input_border_radius }}px;
    margin-top: 15px;
    text-align: center;
  }

  .ai-customization-success-{{ ai_gen_id }} {
    background-color: #d4edda;
    color: #155724;
    border: 1px solid #c3e6cb;
  }

  .ai-customization-error-{{ ai_gen_id }} {
    background-color: #f8d7da;
    color: #721c24;
    border: 1px solid #f5c6cb;
  }

  @media screen and (max-width: 749px) {
    .ai-customization-options-{{ ai_gen_id }} {
      padding: 30px 15px;
      margin: 30px 0;
    }

    .ai-customization-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-customization-card-{{ ai_gen_id }},
    .ai-customization-form-wrapper-{{ ai_gen_id }} {
      padding: 20px;
    }
  }
{% endstyle %}

<customization-options-{{ ai_gen_id }}
  class="ai-customization-options-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-customization-container-{{ ai_gen_id }}">
    <div class="ai-customization-header-{{ ai_gen_id }}">
      {%- if block.settings.heading != blank -%}
        <h1 class="ai-customization-title-{{ ai_gen_id }}">{{ block.settings.heading }}</h1>
      {%- endif -%}
      {%- if block.settings.subtitle != blank -%}
        <p class="ai-customization-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    <div class="ai-customization-grid-{{ ai_gen_id }}">
      <div class="ai-customization-card-{{ ai_gen_id }}">
        <svg
          class="ai-customization-card-icon-{{ ai_gen_id }}"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="13.5" cy="6.5" r=".5"></circle>
          <circle cx="17.5" cy="10.5" r=".5"></circle>
          <circle cx="8.5" cy="7.5" r=".5"></circle>
          <circle cx="6.5" cy="12.5" r=".5"></circle>
          <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"></path>
        </svg>
        <h3 class="ai-customization-card-title-{{ ai_gen_id }}">{{ block.settings.color_title }}</h3>
        <div class="ai-customization-card-text-{{ ai_gen_id }}">
          {{ block.settings.color_description }}
        </div>
      </div>

      <div class="ai-customization-card-{{ ai_gen_id }}">
        <svg
          class="ai-customization-card-icon-{{ ai_gen_id }}"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M12 20h9"></path>
          <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
        </svg>
        <h3 class="ai-customization-card-title-{{ ai_gen_id }}">{{ block.settings.engraving_title }}</h3>
        <div class="ai-customization-card-text-{{ ai_gen_id }}">
          {{ block.settings.engraving_description }}
        </div>
      </div>
    </div>

    <div class="ai-customization-form-wrapper-{{ ai_gen_id }}">
      <h3 class="ai-customization-form-title-{{ ai_gen_id }}">{{ block.settings.form_title }}</h3>
      {%- form 'contact' -%}
        <input
          type="hidden"
          name="contact[customization_product]"
          value="{{ product.title }}"
        >
        <input
          type="hidden"
          name="contact[customization_product_id]"
          value="{{ product.id }}"
        >
        <div class="ai-customization-form-{{ ai_gen_id }}">
          <div class="ai-customization-form-group-{{ ai_gen_id }}">
            <label
              for="ai-customization-name-{{ ai_gen_id }}"
              class="ai-customization-label-{{ ai_gen_id }}"
            >
              Name
            </label>
            <input
              type="text"
              id="ai-customization-name-{{ ai_gen_id }}"
              name="contact[name]"
              class="ai-customization-input-{{ ai_gen_id }}"
              required
              aria-required="true"
            >
          </div>

          <div class="ai-customization-form-group-{{ ai_gen_id }}">
            <label
              for="ai-customization-email-{{ ai_gen_id }}"
              class="ai-customization-label-{{ ai_gen_id }}"
            >
              Email
            </label>
            <input
              type="email"
              id="ai-customization-email-{{ ai_gen_id }}"
              name="contact[email]"
              class="ai-customization-input-{{ ai_gen_id }}"
              autocomplete="email"
              required
              aria-required="true"
              {% if form.errors %}
                aria-invalid="true"
                aria-describedby="ai-customization-error-{{ ai_gen_id }}"
              {% endif %}
              {% if form.posted_successfully? %}
                aria-describedby="ai-customization-success-{{ ai_gen_id }}"
              {% endif %}
            >
          </div>

          <div class="ai-customization-form-group-{{ ai_gen_id }}">
            <label
              for="ai-customization-phone-{{ ai_gen_id }}"
              class="ai-customization-label-{{ ai_gen_id }}"
            >
              Phone (optional)
            </label>
            <input
              type="tel"
              id="ai-customization-phone-{{ ai_gen_id }}"
              name="contact[phone]"
              class="ai-customization-input-{{ ai_gen_id }}"
              autocomplete="tel"
            >
          </div>

          <div class="ai-customization-form-group-{{ ai_gen_id }}">
            <label
              for="ai-customization-message-{{ ai_gen_id }}"
              class="ai-customization-label-{{ ai_gen_id }}"
            >
              Customization details
            </label>
            <textarea
              id="ai-customization-message-{{ ai_gen_id }}"
              name="contact[body]"
              class="ai-customization-textarea-{{ ai_gen_id }}"
              placeholder="{{ block.settings.message_placeholder }}"
              required
              aria-required="true"
            ></textarea>
          </div>

          <button
            type="submit"
            class="ai-customization-submit-{{ ai_gen_id }}"
          >
            {{ block.settings.button_text }}
          </button>

          {%- if form.errors -%}
            <div
              id="ai-customization-error-{{ ai_gen_id }}"
              class="ai-customization-message-{{ ai_gen_id }} ai-customization-error-{{ ai_gen_id }}"
            >
              {{ form.errors.messages.email }}
            </div>
          {%- endif -%}

          {%- if form.posted_successfully? -%}
            <div
              id="ai-customization-success-{{ ai_gen_id }}"
              class="ai-customization-message-{{ ai_gen_id }} ai-customization-success-{{ ai_gen_id }}"
            >
              {{ block.settings.success_message }}
            </div>
          {%- endif -%}
        </div>
      {%- endform -%}
    </div>
  </div>
</customization-options-{{ ai_gen_id }}>

<script>
  (function() {
    class CustomizationOptions{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.form = this.querySelector('form');
        if (this.form) {
          this.form.addEventListener('submit', this.handleSubmit.bind(this));
        }
      }

      handleSubmit(event) {
        const textarea = this.querySelector('.ai-customization-textarea-{{ ai_gen_id }}');
        if (textarea && textarea.value.trim() === '') {
          event.preventDefault();
          textarea.focus();
        }
      }
    }

    customElements.define('customization-options-{{ ai_gen_id }}', CustomizationOptions{{ ai_gen_id }});
  })();
</script>

