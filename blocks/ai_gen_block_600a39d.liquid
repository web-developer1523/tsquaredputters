    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    
      :root {
        --black: #0a0a0a;
        --red: #c8102e;
        --white: #f5f5f5;
        --gray: #1a1a1a;
        --border: #2a2a2a;
      }
    
      body {
        background: var(--black);
        color: var(--white);
        font-family: 'Barlow', sans-serif;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
      }
    
      .container {
        width: 100%;
        max-width: 960px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0;
        border: 1px solid var(--border);
        animation: fadeUp 0.8s ease forwards;
      }
    
      @keyframes fadeUp {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
      }
    
      /* LEFT: Image Side */
      .image-side {
        background: var(--gray);
        position: relative;
        min-height: 600px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        border-right: 1px solid var(--border);
        overflow: hidden;
        cursor: pointer;
      }
    
      .image-side::before {
        content: '';
        position: absolute;
        bottom: 0; left: 0; right: 0;
        height: 120px;
        background: linear-gradient(to top, var(--black), transparent);
        z-index: 2;
        pointer-events: none;
      }
    
      .drop-zone {
        width: 100%;
        height: 100%;
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 12px;
        transition: background 0.2s;
        z-index: 1;
      }
    
      .drop-zone.has-image { background: transparent; }
      .drop-zone.dragging { background: rgba(200,16,46,0.08); }
    
      .drop-icon {
        width: 52px;
        height: 52px;
        border: 2px dashed #444;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: border-color 0.2s;
      }
    
      .drop-zone.has-image .drop-icon,
      .drop-zone.has-image .drop-text { display: none; }
    
      .drop-icon svg { stroke: #555; }
      .drop-text { color: #555; font-size: 13px; font-weight: 300; letter-spacing: 0.05em; text-align: center; }
    
      .drop-input { display: none; }
    
      #preview-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        position: absolute;
        inset: 0;
        display: none;
      }
    
      .image-label {
        position: absolute;
        bottom: 20px;
        left: 20px;
        z-index: 3;
      }
    
      .image-label span {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 13px;
        letter-spacing: 0.2em;
        color: var(--red);
      }
    
      /* RIGHT: Form Side */
      .form-side {
        background: var(--black);
        padding: 52px 44px;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }
    
      .badge {
        display: inline-block;
        background: var(--red);
        color: #fff;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.2em;
        padding: 4px 10px;
        margin-bottom: 20px;
        text-transform: uppercase;
      }
    
      h1 {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 58px;
        line-height: 0.95;
        letter-spacing: 0.02em;
        color: var(--white);
        margin-bottom: 6px;
      }
    
      h1 span { color: var(--red); }
    
      .subtitle {
        font-size: 13px;
        font-weight: 300;
        color: #888;
        letter-spacing: 0.05em;
        margin-bottom: 32px;
        border-left: 2px solid var(--red);
        padding-left: 12px;
      }
    
      .form-group {
        margin-bottom: 16px;
      }
    
      label {
        display: block;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.15em;
        color: #666;
        text-transform: uppercase;
        margin-bottom: 6px;
      }
    
      input, select {
        width: 100%;
        background: var(--gray);
        border: 1px solid var(--border);
        border-radius: 0;
        color: var(--white);
        font-family: 'Barlow', sans-serif;
        font-size: 14px;
        font-weight: 300;
        padding: 12px 16px;
        outline: none;
        transition: border-color 0.2s;
        appearance: none;
      }
    
      input:focus, select:focus { border-color: var(--red); }
      input::placeholder { color: #444; }
    
      select option { background: var(--gray); }
    
      .select-wrap { position: relative; }
      .select-wrap::after {
        content: '▾';
        position: absolute;
        right: 16px;
        top: 50%;
        transform: translateY(-50%);
        color: #555;
        pointer-events: none;
        font-size: 12px;
      }
    
      .benefits {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 8px;
        margin-bottom: 28px;
      }
    
      .benefit {
        background: var(--gray);
        border: 1px solid var(--border);
        padding: 10px 8px;
        text-align: center;
      }
    
      .benefit-icon { color: var(--red); font-size: 16px; margin-bottom: 4px; }
