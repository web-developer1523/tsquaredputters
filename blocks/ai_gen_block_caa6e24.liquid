{% doc %}
  @prompt
    Create a minimalist “Proof” section that matches a premium engineered aesthetic (LAB × Apple).
    Use warm off-white background, lots of whitespace, thin typography, no bold marketing tone.
    
    Add:
    
    Eyebrow: “Proof”
    
    Heading: “Trusted on the green.”
    
    Small subtext: “Real feedback from real players.”
    
    Below the text, insert an App block area for my reviews app to render.
    Ensure the reviews appear centered, with generous padding above and below, and no visible borders around the block.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-proof-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
  }

  .ai-proof-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
    text-align: center;
  }

  .ai-proof-eyebrow-{{ ai_gen_id }} {
    font-size: {{ block.settings.eyebrow_size }}px;
    font-weight: {{ block.settings.eyebrow_weight }};
    letter-spacing: {{ block.settings.eyebrow_spacing }}px;
    text-transform: uppercase;
    color: {{ block.settings.eyebrow_color }};
    margin: 0 0 {{ block.settings.eyebrow_margin }}px;
  }

  .ai-proof-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    letter-spacing: {{ block.settings.heading_spacing }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_margin }}px;
    line-height: 1.2;
  }

  .ai-proof-subtext-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtext_size }}px;
    font-weight: {{ block.settings.subtext_weight }};
    letter-spacing: {{ block.settings.subtext_spacing }}px;
    color: {{ block.settings.subtext_color }};
    margin: 0 0 {{ block.settings.subtext_margin }}px;
    line-height: 1.5;
  }

  .ai-proof-reviews-{{ ai_gen_id }} {
    margin-top: {{ block.settings.reviews_margin_top }}px;
    padding: 0;
    border: none;
  }

  @media screen and (max-width: 749px) {
    .ai-proof-section-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.6 }}px 0 {{ block.settings.padding_bottom | times: 0.6 }}px;
    }

    .ai-proof-eyebrow-{{ ai_gen_id }} {
      font-size: {{ block.settings.eyebrow_size | times: 0.9 }}px;
    }

    .ai-proof-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-proof-subtext-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtext_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-proof-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-proof-container-{{ ai_gen_id }}">
    {% if block.settings.eyebrow != blank %}
      <div class="ai-proof-eyebrow-{{ ai_gen_id }}">
        {{ block.settings.eyebrow }}
      </div>
    {% endif %}

    {% if block.settings.heading != blank %}
      <h2 class="ai-proof-heading-{{ ai_gen_id }}">
        {{ block.settings.heading }}
      </h2>
    {% endif %}

    {% if block.settings.subtext != blank %}
      <p class="ai-proof-subtext-{{ ai_gen_id }}">
        {{ block.settings.subtext }}
      </p>
    {% endif %}

    <div class="ai-proof-reviews-{{ ai_gen_id }}">
      {% for app_block in block.settings.app_blocks %}
        {% render app_block %}
      {% endfor %}
    </div>
  </div>
</div>

