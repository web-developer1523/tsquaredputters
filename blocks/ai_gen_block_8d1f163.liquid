{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-founders-drop-{{ ai_gen_id }} {
    display: block;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_mobile }}px {{ block.settings.padding_horizontal_mobile }}px;
    margin: 0;
    text-align: center;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-founders-drop__eyebrow-{{ ai_gen_id }} {
    margin: 0 0 10px;
    font-size: {{ block.settings.eyebrow_size }}px;
    font-weight: 700;
    color: {{ block.settings.eyebrow_color }};
    letter-spacing: {{ block.settings.eyebrow_spacing }}px;
    text-transform: uppercase;
  }

  .ai-founders-drop__headline-{{ ai_gen_id }} {
    margin: 0 0 4px;
    font-size: {{ block.settings.headline_size_mobile }}px;
    font-weight: 700;
    color: {{ block.settings.headline_color }};
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .ai-founders-drop__subheadline-{{ ai_gen_id }} {
    margin: 0 0 20px;
    font-size: {{ block.settings.subheadline_size_mobile }}px;
    font-weight: 300;
    font-style: italic;
    color: {{ block.settings.subheadline_color }};
  }

  .ai-founders-drop__divider-{{ ai_gen_id }} {
    width: {{ block.settings.divider_width }}px;
    height: {{ block.settings.divider_height }}px;
    background-color: {{ block.settings.divider_color }};
    margin: 0 auto {{ block.settings.divider_margin }}px;
  }

  .ai-founders-drop__description-{{ ai_gen_id }} {
    margin: 0 0 28px;
    font-size: {{ block.settings.description_size }}px;
    font-weight: 400;
    color: {{ block.settings.description_color }};
    line-height: 1.8;
  }

  .ai-founders-drop__image-wrapper-{{ ai_gen_id }} {
    margin: 0 auto 32px;
    max-width: {{ block.settings.image_max_width }}px;
  }

  .ai-founders-drop__image-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: auto;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-founders-drop__image-placeholder-{{ ai_gen_id }} {
    background-color: #1a1a1a;
    width: 100%;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
    position: relative;
  }

  .ai-founders-drop__image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-founders-drop__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-founders-drop__specs-box-{{ ai_gen_id }} {
    margin: 0 auto 32px;
    background-color: {{ block.settings.specs_bg_color }};
    border: 1px solid {{ block.settings.specs_border_color }};
    max-width: {{ block.settings.specs_max_width }}px;
    width: 100%;
    padding: {{ block.settings.specs_padding }}px;
    border-radius: {{ block.settings.specs_border_radius }}px;
  }

  .ai-founders-drop__specs-title-{{ ai_gen_id }} {
    margin: 0 0 14px;
    font-size: {{ block.settings.specs_title_size }}px;
    font-weight: 700;
    color: {{ block.settings.specs_title_color }};
    letter-spacing: 3px;
    text-transform: uppercase;
    text-align: center;
  }

  .ai-founders-drop__specs-table-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-founders-drop__specs-row-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    padding: 6px 0;
    border-bottom: 1px solid {{ block.settings.specs_row_border_color }};
  }

  .ai-founders-drop__specs-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.specs_text_size }}px;
    color: {{ block.settings.specs_label_color }};
  }

  .ai-founders-drop__specs-value-{{ ai_gen_id }} {
    font-size: {{ block.settings.specs_text_size }}px;
    color: {{ block.settings.specs_value_color }};
    font-weight: 700;
    text-align: right;
  }

  .ai-founders-drop__specs-note-{{ ai_gen_id }} {
    padding: 8px 0 0;
    font-size: {{ block.settings.specs_note_size }}px;
    color: {{ block.settings.specs_note_color }};
  }

  .ai-founders-drop__badge-{{ ai_gen_id }} {
    display: inline-block;
    background-color: {{ block.settings.badge_bg_color }};
    border: 1px solid {{ block.settings.badge_border_color }};
    padding: {{ block.settings.badge_padding_vertical }}px {{ block.settings.badge_padding_horizontal }}px;
    margin: 0 auto 28px;
    border-radius: {{ block.settings.badge_border_radius }}px;
  }

  .ai-founders-drop__badge-text-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.badge_text_size }}px;
    font-weight: 600;
    color: {{ block.settings.badge_text_color }};
    letter-spacing: 3px;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .ai-founders-drop__badge-dot-{{ ai_gen_id }} {
    display: inline-block;
    width: {{ block.settings.badge_dot_size }}px;
    height: {{ block.settings.badge_dot_size }}px;
    background-color: {{ block.settings.badge_dot_color }};
    border-radius: 50%;
  }

  .ai-founders-drop__cta-{{ ai_gen_id }} {
    display: inline-block;
    background-color: {{ block.settings.cta_bg_color }};
    color: {{ block.settings.cta_text_color }};
    padding: {{ block.settings.cta_padding_vertical }}px {{ block.settings.cta_padding_horizontal }}px;
    font-size: {{ block.settings.cta_text_size }}px;
    font-weight: 700;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 2px;
    border-radius: {{ block.settings.cta_border_radius }}px;
    transition: all 0.3s ease;
    border: {{ block.settings.cta_border_width }}px solid {{ block.settings.cta_border_color }};
  }

  .ai-founders-drop__cta-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.cta_hover_bg_color }};
    color: {{ block.settings.cta_hover_text_color }};
    border-color: {{ block.settings.cta_hover_border_color }};
  }

  @media screen and (min-width: 750px) {
    .ai-founders-drop-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_desktop }}px {{ block.settings.padding_horizontal_desktop }}px;
    }

    .ai-founders-drop__headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_size_desktop }}px;
    }

    .ai-founders-drop__subheadline-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheadline_size_desktop }}px;
    }
  }
{% endstyle %}

<div class="ai-founders-drop-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.eyebrow_text != blank %}
    <p class="ai-founders-drop__eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow_text }}</p>
  {% endif %}

  {% if block.settings.headline_text != blank %}
    <p class="ai-founders-drop__headline-{{ ai_gen_id }}">{{ block.settings.headline_text }}</p>
  {% endif %}

  {% if block.settings.subheadline_text != blank %}
    <p class="ai-founders-drop__subheadline-{{ ai_gen_id }}">{{ block.settings.subheadline_text }}</p>
  {% endif %}

  {% if block.settings.show_divider %}
    <div class="ai-founders-drop__divider-{{ ai_gen_id }}"></div>
  {% endif %}

  {% if block.settings.description_text != blank %}
    <div class="ai-founders-drop__description-{{ ai_gen_id }}">{{ block.settings.description_text }}</div>
  {% endif %}

  <div class="ai-founders-drop__image-wrapper-{{ ai_gen_id }}">
    {% if block.settings.product_image %}
      <img
        src="{{ block.settings.product_image | image_url: width: 800 }}"
        alt="{{ block.settings.product_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.product_image.width }}"
        height="{{ block.settings.product_image.height }}"
        class="ai-founders-drop__image-{{ ai_gen_id }}"
      >
    {% else %}
      <div class="ai-founders-drop__image-placeholder-{{ ai_gen_id }}">
        {{ 'product-1' | placeholder_svg_tag }}
        <div class="ai-founders-drop__empty-state-{{ ai_gen_id }}">
          Next, add a product image
        </div>
      </div>
    {% endif %}
  </div>

  {% if block.settings.show_specs %}
    <div class="ai-founders-drop__specs-box-{{ ai_gen_id }}">
      {% if block.settings.specs_title != blank %}
        <p class="ai-founders-drop__specs-title-{{ ai_gen_id }}">{{ block.settings.specs_title }}</p>
      {% endif %}

      <div class="ai-founders-drop__specs-table-{{ ai_gen_id }}">
        {% if block.settings.spec_1_label != blank %}
          <div class="ai-founders-drop__specs-row-{{ ai_gen_id }}">
            <span class="ai-founders-drop__specs-label-{{ ai_gen_id }}">{{ block.settings.spec_1_label }}</span>
            <span class="ai-founders-drop__specs-value-{{ ai_gen_id }}">{{ block.settings.spec_1_value }}</span>
          </div>
        {% endif %}

        {% if block.settings.spec_2_label != blank %}
          <div class="ai-founders-drop__specs-row-{{ ai_gen_id }}">
            <span class="ai-founders-drop__specs-label-{{ ai_gen_id }}">{{ block.settings.spec_2_label }}</span>
            <span class="ai-founders-drop__specs-value-{{ ai_gen_id }}">{{ block.settings.spec_2_value }}</span>
          </div>
        {% endif %}

        {% if block.settings.spec_3_label != blank %}
          <div class="ai-founders-drop__specs-row-{{ ai_gen_id }}">
            <span class="ai-founders-drop__specs-label-{{ ai_gen_id }}">{{ block.settings.spec_3_label }}</span>
            <span class="ai-founders-drop__specs-value-{{ ai_gen_id }}">{{ block.settings.spec_3_value }}</span>
          </div>
        {% endif %}

        {% if block.settings.spec_4_label != blank %}
          <div class="ai-founders-drop__specs-row-{{ ai_gen_id }}">
            <span class="ai-founders-drop__specs-label-{{ ai_gen_id }}">{{ block.settings.spec_4_label }}</span>
            <span class="ai-founders-drop__specs-value-{{ ai_gen_id }}">{{ block.settings.spec_4_value }}</span>
          </div>
        {% endif %}

        {% if block.settings.spec_5_label != blank %}
          <div class="ai-founders-drop__specs-row-{{ ai_gen_id }}">
            <span class="ai-founders-drop__specs-label-{{ ai_gen_id }}">{{ block.settings.spec_5_label }}</span>
            <span class="ai-founders-drop__specs-value-{{ ai_gen_id }}">{{ block.settings.spec_5_value }}</span>
          </div>
        {% endif %}

        {% if block.settings.spec_6_label != blank %}
          <div class="ai-founders-drop__specs-row-{{ ai_gen_id }}">
            <span class="ai-founders-drop__specs-label-{{ ai_gen_id }}">{{ block.settings.spec_6_label }}</span>
            <span class="ai-founders-drop__specs-value-{{ ai_gen_id }}">{{ block.settings.spec_6_value }}</span>
          </div>
        {% endif %}

        {% if block.settings.specs_note != blank %}
          <div class="ai-founders-drop__specs-note-{{ ai_gen_id }}">{{ block.settings.specs_note }}</div>
        {% endif %}
      </div>
    </div>
  {% endif %}

  {% if block.settings.show_badge and block.settings.badge_text != blank %}
    <div class="ai-founders-drop__badge-{{ ai_gen_id }}">
      <p class="ai-founders-drop__badge-text-{{ ai_gen_id }}">
        {% if block.settings.show_badge_dot %}
          <span class="ai-founders-drop__badge-dot-{{ ai_gen_id }}"></span>
        {% endif %}
        {{ block.settings.badge_text }}
      </p>
    </div>
  {% endif %}

  {% if block.settings.cta_text != blank %}
    <a
      href="{{ block.settings.cta_link }}"
      class="ai-founders-drop__cta-{{ ai_gen_id }}"
    >
      {{ block.settings.cta_text }}
    </a>
  {% endif %}
</div>

