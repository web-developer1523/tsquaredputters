    },
    {
      "type": "header",
      "content": "Subheadline"
    },
    {
      "type": "text",
      "id": "subheadline_text",
      "label": "Text",
      "default": "Founder's Edition"
    },
    {
      "type": "range",
      "id": "subheadline_size_desktop",
      "label": "Font size (desktop)",
      "min": 14,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "subheadline_size_mobile",
      "label": "Font size (mobile)",
      "min": 14,
