{% doc %}
  @prompt
    T Squared Access — Reserve Your Spot
    Friday
    Drops.
    Every Friday at noon, the drop opens to our email list.
    
    Sign up below and your spot is reserved for 2 hours. At 2PM, any unclaimed spots open to everyone else. Once it's gone, it's gone.
    
    Every Friday at 12:00 PM EST — Reserved spots held until 2:00 PM
    Reserve Your Spot
    Full Name
    Email Address
    Phone Number
    Reserve My Spot
    Reserved spots are held for 2 hours. Unclaimed spots open to all at 2:00 PM EST.
    Previous Drops
    T-Zero Putter — 001–025
    Closed
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-drops-access-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    padding: {{ block.settings.padding }}px;
  }

  .ai-drops-access__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-drops-access__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: 40px;
  }

  .ai-drops-access__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    margin: 0 0 16px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: {{ block.settings.title_color }};
  }

  .ai-drops-access__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    font-weight: 600;
    margin: 0 0 24px;
    color: {{ block.settings.subtitle_color }};
  }

  .ai-drops-access__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    line-height: 1.6;
    margin: 0 0 16px;
    color: {{ block.settings.text_color }};
  }

  .ai-drops-access__timing-{{ ai_gen_id }} {
    display: inline-block;
    background-color: {{ block.settings.timing_bg_color }};
    color: {{ block.settings.timing_text_color }};
    padding: 12px 24px;
    border-radius: {{ block.settings.border_radius }}px;
    font-size: {{ block.settings.timing_size }}px;
    font-weight: 600;
    margin-bottom: 32px;
  }

  .ai-drops-access__form-section-{{ ai_gen_id }} {
    background-color: {{ block.settings.form_bg_color }};
    padding: 40px;
    border-radius: {{ block.settings.border_radius }}px;
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    margin-bottom: 32px;
  }

  .ai-drops-access__form-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.form_title_size }}px;
    font-weight: 600;
    margin: 0 0 24px;
    text-align: center;
    color: {{ block.settings.form_title_color }};
  }

  .ai-drops-access__field-{{ ai_gen_id }} {
    margin-bottom: 20px;
  }

  .ai-drops-access__label-{{ ai_gen_id }} {
    display: block;
    font-size: {{ block.settings.label_size }}px;
    font-weight: 500;
    margin-bottom: 8px;
    color: {{ block.settings.label_color }};
  }

  .ai-drops-access__input-{{ ai_gen_id }} {
    width: 100%;
    padding: 14px 16px;
    font-size: {{ block.settings.input_size }}px;
    border: {{ block.settings.input_border_width }}px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    background-color: {{ block.settings.input_bg_color }};
    color: {{ block.settings.input_text_color }};
    transition: border-color 0.3s ease;
  }

  .ai-drops-access__input-{{ ai_gen_id }}:focus {
    outline: none;
    border-color: {{ block.settings.input_focus_color }};
  }

  .ai-drops-access__button-{{ ai_gen_id }} {
    width: 100%;
    padding: 16px 32px;
    font-size: {{ block.settings.button_size }}px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.2s ease;
  }

  .ai-drops-access__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    transform: translateY(-2px);
  }

  .ai-drops-access__disclaimer-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.disclaimer_size }}px;
    color: {{ block.settings.disclaimer_color }};
    margin-top: 16px;
    font-style: italic;
  }

  .ai-drops-access__success-{{ ai_gen_id }} {
    background-color: {{ block.settings.success_bg_color }};
    color: {{ block.settings.success_text_color }};
    padding: 16px;
    border-radius: {{ block.settings.border_radius }}px;
    text-align: center;
    margin-bottom: 16px;
  }

  .ai-drops-access__error-{{ ai_gen_id }} {
    background-color: {{ block.settings.error_bg_color }};
    color: {{ block.settings.error_text_color }};
    padding: 16px;
    border-radius: {{ block.settings.border_radius }}px;
    text-align: center;
    margin-bottom: 16px;
  }

  .ai-drops-access__previous-{{ ai_gen_id }} {
    margin-top: 48px;
  }

  .ai-drops-access__previous-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.previous_title_size }}px;
    font-weight: 600;
    margin: 0 0 24px;
    text-align: {{ block.settings.text_alignment }};
    color: {{ block.settings.title_color }};
  }

  .ai-drops-access__drop-item-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 20px;
    background-color: {{ block.settings.drop_item_bg_color }};
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    margin-bottom: 12px;
  }

  .ai-drops-access__drop-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.drop_name_size }}px;
    font-weight: 500;
    color: {{ block.settings.text_color }};
  }

  .ai-drops-access__drop-status-{{ ai_gen_id }} {
    font-size: {{ block.settings.drop_status_size }}px;
    font-weight: 600;
    color: {{ block.settings.drop_status_color }};
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  @media screen and (max-width: 749px) {
    .ai-drops-access-{{ ai_gen_id }} {
      padding: {{ block.settings.padding | times: 0.6 }}px;
    }

    .ai-drops-access__form-section-{{ ai_gen_id }} {
      padding: 24px;
    }

    .ai-drops-access__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.7 }}px;
    }

    .ai-drops-access__subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<drops-access-{{ ai_gen_id }}
  class="ai-drops-access-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-drops-access__container-{{ ai_gen_id }}">
    <div class="ai-drops-access__header-{{ ai_gen_id }}">
      {%- if block.settings.title != blank -%}
        <h2 class="ai-drops-access__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {%- endif -%}

      {%- if block.settings.subtitle != blank -%}
        <div class="ai-drops-access__subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</div>
      {%- endif -%}

      {%- if block.settings.description != blank -%}
        <div class="ai-drops-access__description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
      {%- endif -%}

      {%- if block.settings.timing_text != blank -%}
        <div class="ai-drops-access__timing-{{ ai_gen_id }}">{{ block.settings.timing_text }}</div>
      {%- endif -%}
    </div>

    <div class="ai-drops-access__form-section-{{ ai_gen_id }}">
      {%- form 'contact' -%}
        <input type="hidden" name="contact[drop_reservation]" value="true">
        <input type="hidden" name="contact[drop_date]" value="{{ block.settings.drop_date }}">

        {%- if form.posted_successfully? -%}
          <div
            id="ai-drops-access-success-{{ ai_gen_id }}"
            class="ai-drops-access__success-{{ ai_gen_id }}"
          >
            {{ block.settings.success_message }}
          </div>
        {%- endif -%}

        {%- if form.errors -%}
          <div
            id="ai-drops-access-error-{{ ai_gen_id }}"
            class="ai-drops-access__error-{{ ai_gen_id }}"
          >
            {%- for field in form.errors -%}
              {{ form.errors.messages[field] }}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if block.settings.form_title != blank -%}
          <h3 class="ai-drops-access__form-title-{{ ai_gen_id }}">{{ block.settings.form_title }}</h3>
        {%- endif -%}

        <div class="ai-drops-access__field-{{ ai_gen_id }}">
          <label class="ai-drops-access__label-{{ ai_gen_id }}" for="ai-drops-name-{{ ai_gen_id }}">
            {{ block.settings.name_label }}
          </label>
          <input
            type="text"
            id="ai-drops-name-{{ ai_gen_id }}"
            name="contact[name]"
            class="ai-drops-access__input-{{ ai_gen_id }}"
            placeholder="{{ block.settings.name_placeholder }}"
            required
            {% if form.errors %}
              aria-invalid="true"
            {% endif %}
          >
        </div>

        <div class="ai-drops-access__field-{{ ai_gen_id }}">
          <label class="ai-drops-access__label-{{ ai_gen_id }}" for="ai-drops-email-{{ ai_gen_id }}">
            {{ block.settings.email_label }}
          </label>
          <input
            type="email"
            id="ai-drops-email-{{ ai_gen_id }}"
            name="contact[email]"
            class="ai-drops-access__input-{{ ai_gen_id }}"
            placeholder="{{ block.settings.email_placeholder }}"
            autocomplete="email"
            required
            {% if form.errors %}
              aria-invalid="true"
            {% endif %}
          >
        </div>

        <div class="ai-drops-access__field-{{ ai_gen_id }}">
          <label class="ai-drops-access__label-{{ ai_gen_id }}" for="ai-drops-phone-{{ ai_gen_id }}">
            {{ block.settings.phone_label }}
          </label>
          <input
            type="tel"
            id="ai-drops-phone-{{ ai_gen_id }}"
            name="contact[phone]"
            class="ai-drops-access__input-{{ ai_gen_id }}"
            placeholder="{{ block.settings.phone_placeholder }}"
            autocomplete="tel"
          >
        </div>

        <button type="submit" class="ai-drops-access__button-{{ ai_gen_id }}">
          {{ block.settings.button_text }}
        </button>

        {%- if block.settings.disclaimer != blank -%}
          <div class="ai-drops-access__disclaimer-{{ ai_gen_id }}">{{ block.settings.disclaimer }}</div>
        {%- endif -%}
      {%- endform -%}
    </div>

    {%- if block.settings.show_previous_drops -%}
      <div class="ai-drops-access__previous-{{ ai_gen_id }}">
        {%- if block.settings.previous_title != blank -%}
          <h3 class="ai-drops-access__previous-title-{{ ai_gen_id }}">{{ block.settings.previous_title }}</h3>
        {%- endif -%}

        {%- if block.settings.drop_1_name != blank -%}
          <div class="ai-drops-access__drop-item-{{ ai_gen_id }}">
            <span class="ai-drops-access__drop-name-{{ ai_gen_id }}">{{ block.settings.drop_1_name }}</span>
            <span class="ai-drops-access__drop-status-{{ ai_gen_id }}">{{ block.settings.drop_1_status }}</span>
          </div>
        {%- endif -%}

        {%- if block.settings.drop_2_name != blank -%}
          <div class="ai-drops-access__drop-item-{{ ai_gen_id }}">
            <span class="ai-drops-access__drop-name-{{ ai_gen_id }}">{{ block.settings.drop_2_name }}</span>
            <span class="ai-drops-access__drop-status-{{ ai_gen_id }}">{{ block.settings.drop_2_status }}</span>
          </div>
        {%- endif -%}

        {%- if block.settings.drop_3_name != blank -%}
          <div class="ai-drops-access__drop-item-{{ ai_gen_id }}">
            <span class="ai-drops-access__drop-name-{{ ai_gen_id }}">{{ block.settings.drop_3_name }}</span>
            <span class="ai-drops-access__drop-status-{{ ai_gen_id }}">{{ block.settings.drop_3_status }}</span>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</drops-access-{{ ai_gen_id }}>

<script>
  (function() {
    class DropsAccess{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.form = this.querySelector('form');
        if (this.form) {
          this.setupFormValidation();
        }
      }

      setupFormValidation() {
        this.form.addEventListener('submit', (event) => {
          const nameInput = this.querySelector('#ai-drops-name-{{ ai_gen_id }}');
          const emailInput = this.querySelector('#ai-drops-email-{{ ai_gen_id }}');

          if (!nameInput.value.trim()) {
            event.preventDefault();
            nameInput.focus();
            return false;
          }

          if (!emailInput.value.trim() || !this.isValidEmail(emailInput.value)) {
            event.preventDefault();
            emailInput.focus();
            return false;
          }
        });
      }

      isValidEmail(email) {
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        return emailRegex.test(email);
      }
    }

    customElements.define('drops-access-{{ ai_gen_id }}', DropsAccess{{ ai_gen_id }});
  })();
</script>

