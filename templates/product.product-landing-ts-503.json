rap' + (isFc ? ' tsgs-fc' : '');\n    document.getElementById('tsgs-trigger-img').src = img;\n    document.getElementById('tsgs-dropdown').classList.remove('tsgs-open');\n    document.getElementById('tsgs-trigger').classList.remove('tsgs-open');\n    var ymqSelect = document.querySelector('select[name=\"ymq[GRIP STYLE ]\"]') || document.querySelector('select[name=\"ymq[GRIP STYLE]\"]');\n    if (ymqSelect) {\n      for (var i = 0; i < ymqSelect.options.length; i++) {\n        var t = ymqSelect.options[i].text.trim().toLowerCase();\n        if (t === value.toLowerCase() || t.indexOf(value.toLowerCase()) !== -1 || value.toLowerCase().indexOf(t) !== -1) { ymqSelect.selectedIndex = i; break; }\n      }\n      ymqSelect.dispatchEvent(new Event('change', { bubbles: true }));\n      ymqSelect.dispatchEvent(new Event('input', { bubbles: true }));\n    }\n    var hi = document.querySelector('input[name=\"properties[GRIP STYLE ]\"]') || document.querySelector('input[name=\"properties[GRIP STYLE]\"]') || document.querySelector('input[name=\"empty-properties[GRIP STYLE ]\"]') || document.querySelector('input[name=\"empty-properties[GRIP STYLE]\"]');\n    if (hi) { hi.value = value; hi.dispatchEvent(new Event('change', { bubbles: true })); }\n  }\n\n  function tsgsHcToggle() {\n    var trigger = document.getElementById('tsgs-hc-trigger');\n    var dropdown = document.getElementById('tsgs-hc-dropdown');\n    var isOpen = dropdown.classList.contains('tsgs-open');\n    document.getElementById('tsgs-dropdown').classList.remove('tsgs-open');\n    document.getElementById('tsgs-trigger').classList.remove('tsgs-open');\n    if (isOpen) { dropdown.classList.remove('tsgs-open'); trigger.classList.remove('tsgs-open'); }\n    else { dropdown.classList.add('tsgs-open'); trigger.classList.add('tsgs-open'); }\n  }\n\n  function tsgsHcSelect(el) {\n    var value = el.getAttribute('data-value');\n    var img   = el.getAttribute('data-img');\n    var name  = el.querySelector('.tsgs-opt-name').textContent;\n    document.querySelectorAll('#tsgs-hc-dropdown .tsgs-option').forEach(function(o) { o.classList.remove('tsgs-selected'); });\n    el.classList.add('tsgs-selected');\n    document.getElementById('tsgs-hc-name').innerHTML = name;\n    var isFlip = el.getAttribute('data-flip') === '1';\n    var wrap = document.getElementById('tsgs-hc-trigger-img-wrap');\n    wrap.style.display = 'flex';\n    wrap.className = 'tsgs-trigger-img-wrap tsgs-hc' + (isFlip ? ' tsgs-flip' : '');\n    document.getElementById('tsgs-hc-trigger-img').src = img;\n    document.getElementById('tsgs-hc-dropdown').classList.remove('tsgs-open');\n    document.getElementById('tsgs-hc-trigger').classList.remove('tsgs-open');\n    var hcSel = document.querySelector('select[name=\"ymq[HEADCOVER ]\"]') || document.querySelector('select[name=\"ymq[HEADCOVER]\"]');\n    if (hcSel) {\n      for (var i = 0; i < hcSel.options.length; i++) {\n        if (hcSel.options[i].text.trim().toLowerCase().indexOf(value.toLowerCase().substring(0,8)) !== -1) { hcSel.selectedIndex = i; break; }\n      }\n      hcSel.dispatchEvent(new Event('change', { bubbles: true }));\n      hcSel.dispatchEvent(new Event('input', { bubbles: true }));\n    }\n    var hcIn = document.querySelector('input[name=\"properties[HEADCOVER ]\"]') || document.querySelector('input[name=\"properties[HEADCOVER]\"]') || document.querySelector('input[name=\"empty-properties[HEADCOVER ]\"]') || document.querySelector('input[name=\"empty-properties[HEADCOVER]\"]');\n    if (hcIn) { hcIn.value = value; hcIn.dispatchEvent(new Event('change', { bubbles: true })); }\n  }\n\n  document.addEventListener('click', function(e) {\n    var wrap = document.getElementById('tsgs-wrap');\n    if (wrap && !wrap.contains(e.target)) {\n      document.getElementById('tsgs-dropdown').classList.remove('tsgs-open');\n      document.getElementById('tsgs-trigger').classList.remove('tsgs-open');\n      var hcD = document.getElementById('tsgs-hc-dropdown'); if(hcD) hcD.classList.remove('tsgs-open');\n      var hcT = document.getElementById('tsgs-hc-trigger'); if(hcT) hcT.classList.remove('tsgs-open');\n    }\n  });\n</script>"
