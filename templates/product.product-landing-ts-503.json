    "shogun_custom_html_fFFzmi": {
      "type": "shogun-custom-html",
      "name": "Shogun Custom HTML",
      "settings": {
        "html": "<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Bebas+Neue&amp;family=Oswald:wght@400;500;600&amp;display=swap\" rel=\"stylesheet\">\n\n<style>\n  .ts-guide {\n    background: #000 !important;\n    color: #fff !important;\n    font-family: 'Oswald', sans-serif;\n    width: 100%;\n  }\n  .ts-guide *, .ts-guide *::before, .ts-guide *::after {\n    box-sizing: border-box;\n    margin: 0;\n    padding: 0;\n  }\n\n  /* NAV */\n  .ts-nav {\n    position: sticky;\n    top: 0;\n    z-index: 90;\n    background: #000 !important;\n    border-top: 3px solid #cc0000;\n    border-bottom: 1px solid #222;\n    display: flex;\n    align-items: stretch;\n    justify-content: center;\n    overflow-x: auto;\n    scrollbar-width: none;\n  }\n  .ts-nav::-webkit-scrollbar { display: none; }\n  .ts-nav-btn {\n    background: none;\n    border: none;\n    border-bottom: 3px solid transparent;\n    color: #666;\n    padding: 0 24px;\n    height: 48px;\n    cursor: pointer;\n    font-family: 'Oswald', sans-serif;\n    font-weight: 500;\n    letter-spacing: 3px;\n    font-size: 11px;\n    text-transform: uppercase;\n    transition: all .18s;\n    white-space: nowrap;\n  }\n  .ts-nav-btn:hover { color: #ccc; }\n  .ts-nav-btn.ts-on { color: #cc0000; border-bottom-color: #cc0000; }\n\n  /* LAYOUT */\n  .ts-wrap { max-width: 1060px; margin: 0 auto; padding: 0 28px; background: #000 !important; }\n  .ts-section { padding: 64px 0; background: #000 !important; }\n  .ts-divider { height: 1px; background: #222; }\n\n  /* SECTION HEADER */\n  .ts-eyebrow { display: flex; align-items: center; gap: 16px; margin-bottom: 12px; }\n  .ts-eyebrow-label {\n    font-family: 'Oswald', sans-serif;\n    font-weight: 500;\n    letter-spacing: 5px;\n    font-size: 10px;\n    color: #cc0000;\n    white-space: nowrap;\n    text-transform: uppercase;\n  }\n  .ts-eyebrow-rule { flex: 1; height: 1px; background: #222; }\n  .ts-section-title {\n    font-family: 'Bebas Neue', sans-serif;\n    letter-spacing: 5px;\n    font-size: clamp(32px, 5vw, 56px);\n    line-height: 1;\n    margin-bottom: 16px;\n    color: #fff !important;\n  }\n  .ts-section-sub {\n    font-family: 'Oswald', sans-serif;\n    font-weight: 400;\n    color: #bbb !important;\n    font-size: 16px;\n    line-height: 1.75;\n    max-width: 540px;\n    margin-bottom: 36px;\n  }\n\n  /* HEIGHT CHART */\n  .ts-chart { border: 1px solid #222; overflow: hidden; }\n  .ts-chart-head {\n    display: grid;\n    grid-template-columns: 1.8fr 1fr 1.5fr 2fr;\n    background: #111 !important;\n    border-bottom: 1px solid #222;\n  }\n  .ts-chart-hc {\n    font-family: 'Oswald', sans-serif;\n    font-weight: 600;\n    letter-spacing: 3px;\n    font-size: 10px;\n    color: #888 !important;\n    padding: 10px 16px;\n    text-transform: uppercase;\n  }\n  .ts-chart-row {\n    display: grid;\n    grid-template-columns: 1.8fr 1fr 1.5fr 2fr;\n    border-bottom: 1px solid #111;\n    background: #000 !important;\n    transition: background .15s;\n  }\n  .ts-chart-row:hover { background: #0f0f0f !important; }\n  .ts-chart-row:last-child { border-bottom: none; }\n  .ts-chart-cell {\n    padding: 12px 16px;\n    font-family: 'Oswald', sans-serif;\n    font-weight: 400;\n    font-size: 15px;\n    color: #bbb !important;\n  }\n  .ts-chart-rec {\n    font-family: 'Bebas Neue', sans-serif;\n    font-size: 22px;\n    letter-spacing: 2px;\n    color: #cc0000 !important;\n  }\n  .ts-chart-note { color: #888 !important; font-size: 13px; font-weight: 400; }\n  @media (max-width: 580px) {\n    .ts-chart-head { grid-template-columns: 1fr 1fr; }\n    .ts-chart-row  { grid-template-columns: 1fr 1fr; }\n    .ts-hide-sm    { display: none !important; }\n  }\n\n  /* GRIP QUICK PICK */\n  .ts-qpick-label-top {\n    font-family: 'Oswald', sans-serif;\n    font-weight: 600;\n    letter-spacing: 4px;\n    font-size: 10px;\n    color: #888 !important;\n    margin-bottom: 8px;\n    text-transform: uppercase;\n  }\n  .ts-qpick {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 1px;\n    background: #222;\n    margin-bottom: 32px;\n  }\n  .ts-qpick-btn {\n    background: #0a0a0a !important;\n    border: none;\n    padding: 16px 18px;\n    cursor: pointer;\n    text-align: left;\n    border-bottom: 3px solid transparent;\n    transition: all .18s;\n  }\n  .ts-qpick-btn:hover { background: #111 !important; }\n  .ts-qpick-btn.ts-on { background: #111 !important; border-bottom-color: #cc0000; }\n  .ts-qpick-q {\n    font-family: 'Oswald', sans-serif;\n    font-weight: 400;\n    color: #bbb !important;\n    font-size: 13px;\n    margin-bottom: 6px;\n    line-height: 1.4;\n  }\n  .ts-qpick-rec {\n    font-family: 'Bebas Neue', sans-serif;\n    letter-spacing: 3px;\n    font-size: 13px;\n    color: #666 !important;\n  }\n  .ts-qpick-btn.ts-on .ts-qpick-rec { color: #cc0000 !important; }\n  @media (max-width: 500px) { .ts-qpick { grid-template-columns: 1fr; } }\n\n  /* GRIP FAMILY TABS */\n  .ts-fam-tabs {\n    display: flex;\n    border-bottom: 1px solid #222;\n    overflow-x: auto;\n    scrollbar-width: none;\n    background: #000 !important;\n  }\n  .ts-fam-tabs::-webkit-scrollbar { display: none; }\n  .ts-fam-tab {\n    background: none;\n    border: none;\n    border-bottom: 3px solid transparent;\n    color: #666 !important;\n    padding: 12px 24px 9px;\n    cursor: pointer;\n    font-family: 'Bebas Neue', sans-serif;\n    letter-spacing: 3px;\n    font-size: 14px;\n    transition: all .18s;\n    white-space: nowrap;\n    margin-bottom: -1px;\n  }\n  .ts-fam-tab:hover:not(.ts-on) { color: #ccc !important; }\n  .ts-fam-tab.ts-on { color: #fff !important; border-bottom-color: #cc0000; }\n\n  /* GRIP FAMILY DESC */\n  .ts-fam-desc {\n    padding: 20px 24px;\n    background: #111 !important;\n    border: 1px solid #222;\n    border-top: none;\n    margin-bottom: 1px;\n  }\n  .ts-fam-tagline {\n    font-family: 'Oswald', sans-serif;\n    font-weight: 600;\n    letter-spacing: 3px;\n    font-size: 10px;\n    color: #cc0000 !important;\n    margin-bottom: 8px;\n    text-transform: uppercase;\n  }\n  .ts-fam-body {\n    font-family: 'Oswald', sans-serif;\n    font-weight: 400;\n    color: #bbb !important;\n    font-size: 15px;\n    line-height: 1.7;\n    max-width: 640px;\n  }\n\n  /* GRIP CARDS */\n  .ts-grip-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));\n    gap: 1px;\n    background: #222;\n  }\n  .ts-grip-hidden {\n    position: absolute !important;\n    visibility: hidden !important;\n    pointer-events: none !important;\n    height: 0 !important;\n    overflow: hidden !important;\n    opacity: 0 !important;\n  }\n  .ts-grip-card {\n    background: #0a0a0a !important;\n    display: flex;\n    flex-direction: column;\n  }\n  .ts-grip-img {\n    width: 100%;\n    aspect-ratio: 3 / 2;\n    object-fit: cover;\n    object-position: center;\n    background: #111 !important;\n    display: block;\n    border-bottom: 1px solid #222;\n  }\n  .ts-grip-body { padding: 16px 18px 18px; flex: 1; background: #0a0a0a !important; }\n  .ts-grip-name {\n    font-family: 'Bebas Neue', sans-serif;\n    letter-spacing: 3px;\n    font-size: 17px;\n    margin-bottom: 8px;\n    line-height: 1.1;\n    color: #fff !important;\n  }\n  .ts-grip-who {\n    font-family: 'Oswald', sans-serif;\n    font-weight: 400;\n    color: #bbb !important;\n    font-size: 14px;\n    line-height: 1.65;\n    margin-bottom: 12px;\n  }\n  .ts-grip-tags { display: flex; flex-wrap: wrap; gap: 5px; }\n  .ts-grip-tag {\n    display: inline-block;\n    font-family: 'Oswald', sans-serif;\n    font-weight: 500;\n    letter-spacing: 2px;\n    font-size: 9px;\n    color: #888 !important;\n    border: 1px solid #333;\n    padding: 3px 8px;\n    text-transform: uppercase;\n  }\n  .ts-pop-badge {\n    background: #cc0000;\n    color: #fff !important;\n    font-family: 'Oswald', sans-serif;\n    font-weight: 600;\n    letter-spacing: 2px;\n    font-size: 8px;\n    padding: 3px 8px;\n    text-transform: uppercase;\n  }\n\n  /* SPECS */\n  .ts-spec-grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 1px;\n    background: #222;\n    border: 1px solid #222;\n  }\n  .ts-spec-cell { background: #0a0a0a !important; padding: 20px 22px; }\n  .ts-spec-k {\n    font-family: 'Oswald', sans-serif;\n    font-weight: 600;\n    letter-spacing: 3px;\n    font-size: 9px;\n    color: #666 !important;\n    margin-bottom: 7px;\n    text-transform: uppercase;\n  }\n  .ts-spec-v {\n    font-family: 'Oswald', sans-serif;\n    font-weight: 400;\n    font-size: 16px;\n    color: #ddd !important;\n  }\n  @media (max-width: 600px) { .ts-spec-grid { grid-template-columns: 1fr 1fr; } }\n\n  /* FAQ */\n  .ts-faq-wrap { max-width: 760px; }\n  .ts-faq-item { border-top: 1px solid #1a1a1a; }\n  .ts-faq-item:last-child { border-bottom: 1px solid #1a1a1a; }\n  .ts-faq-q {\n    width: 100%;\n    background: none !important;\n    border: none;\n    color: #ddd !important;\n    padding: 18px 0;\n    cursor: pointer;\n    text-align: left;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    gap: 20px;\n    font-family: 'Oswald', sans-serif;\n    font-weight: 500;\n    font-size: 15px;\n    letter-spacing: 1px;\n    text-transform: uppercase;\n    transition: color .15s;\n  }\n  .ts-faq-q:hover { color: #cc0000 !important; }\n  .ts-faq-icon {\n    color: #cc0000;\n    font-size: 22px;\n    flex-shrink: 0;\n    transition: transform .2s;\n    display: inline-block;\n    font-style: normal;\n    font-family: monospace;\n    line-height: 1;\n  }\n  .ts-faq-a {\n    font-family: 'Oswald', sans-serif;\n    font-weight: 400;\n    font-size: 15px;\n    color: #bbb !important;\n    line-height: 1.8;\n    padding-bottom: 20px;\n    display: none;\n  }\n  .ts-faq-a.ts-open { display: block; }\n</style>\n\n<div class=\"ts-guide\" id=\"ts-guide\">\n\n  <nav class=\"ts-nav\" id=\"ts-nav\">\n    <button class=\"ts-nav-btn ts-on\" onclick=\"tsScrollTo('ts-fit')\">FIT GUIDE</button>\n    <button class=\"ts-nav-btn\" onclick=\"tsScrollTo('ts-grips')\">GRIPS</button>\n    <button class=\"ts-nav-btn\" onclick=\"tsScrollTo('ts-specs')\">SPECS</button>\n    <button class=\"ts-nav-btn\" onclick=\"tsScrollTo('ts-faq')\">FAQ</button>\n  </nav>\n\n  <!-- FIT GUIDE -->\n  <div id=\"ts-fit\" style=\"scroll-margin-top:52px;\">\n    <div class=\"ts-divider\"></div>\n    <div class=\"ts-wrap ts-section\">\n      <div class=\"ts-eyebrow\">\n<span class=\"ts-eyebrow-label\">Fit Guide</span><div class=\"ts-eyebrow-rule\"></div>\n</div>\n      <div class=\"ts-section-title\">SHAFT LENGTH BY HEIGHT</div>\n      <div class=\"ts-section-sub\">At address, your eyes should sit over the ball with your arms hanging naturally — not reaching, not crouching. Use your height as a starting point, then fine-tune based on your posture.</div>\n      <div class=\"ts-chart\">\n        <div class=\"ts-chart-head\">\n          <div class=\"ts-chart-hc\">Height</div>\n          <div class=\"ts-chart-hc\">Recommended</div>\n          <div class=\"ts-chart-hc ts-hide-sm\">Acceptable Range</div>\n          <div class=\"ts-chart-hc ts-hide-sm\">Notes</div>\n        </div>\n        <div class=\"ts-chart-row\">\n<div class=\"ts-chart-cell\">Under 5'0\"</div>\n<div class=\"ts-chart-cell ts-chart-rec\">33\"</div>\n<div class=\"ts-chart-cell ts-hide-sm\" style=\"color:#666;\">33\" – 33.5\"</div>\n<div class=\"ts-chart-cell ts-chart-note ts-hide-sm\">Shorter = more control</div>\n</div>\n        <div class=\"ts-chart-row\">\n<div class=\"ts-chart-cell\">5'0\" – 5'3\"</div>\n<div class=\"ts-chart-cell ts-chart-rec\">33\"</div>\n<div class=\"ts-chart-cell ts-hide-sm\" style=\"color:#666;\">33\" – 34\"</div>\n<div class=\"ts-chart-cell ts-chart-note ts-hide-sm\">—</div>\n</div>\n        <div class=\"ts-chart-row\">\n<div class=\"ts-chart-cell\">5'4\" – 5'6\"</div>\n<div class=\"ts-chart-cell ts-chart-rec\">33.5\"</div>\n<div class=\"ts-chart-cell ts-hide-sm\" style=\"color:#666;\">33\" – 34\"</div>\n<div class=\"ts-chart-cell ts-chart-note ts-hide-sm\">—</div>\n</div>\n        <div class=\"ts-chart-row\">\n<div class=\"ts-chart-cell\">5'7\" – 5'9\"</div>\n<div class=\"ts-chart-cell ts-chart-rec\">34\"</div>\n<div class=\"ts-chart-cell ts-hide-sm\" style=\"color:#666;\">33.5\" – 34.5\"</div>\n<div class=\"ts-chart-cell ts-chart-note ts-hide-sm\">Most common length</div>\n</div>\n        <div class=\"ts-chart-row\">\n<div class=\"ts-chart-cell\">5'10\" – 6'0\"</div>\n<div class=\"ts-chart-cell ts-chart-rec\">34.5\"</div>\n<div class=\"ts-chart-cell ts-hide-sm\" style=\"color:#666;\">34\" – 35\"</div>\n<div class=\"ts-chart-cell ts-chart-note ts-hide-sm\">—</div>\n</div>\n        <div class=\"ts-chart-row\">\n<div class=\"ts-chart-cell\">6'1\" – 6'3\"</div>\n<div class=\"ts-chart-cell ts-chart-rec\">35\"</div>\n<div class=\"ts-chart-cell ts-hide-sm\" style=\"color:#666;\">34.5\" – 35.5\"</div>\n<div class=\"ts-chart-cell ts-chart-note ts-hide-sm\">—</div>\n</div>\n        <div class=\"ts-chart-row\">\n<div class=\"ts-chart-cell\">6'4\" – 6'6\"</div>\n<div class=\"ts-chart-cell ts-chart-rec\">35.5\"</div>\n<div class=\"ts-chart-cell ts-hide-sm\" style=\"color:#666;\">35\" – 36\"</div>\n<div class=\"ts-chart-cell ts-chart-note ts-hide-sm\">—</div>\n</div>\n        <div class=\"ts-chart-row\">\n<div class=\"ts-chart-cell\">6'7\"+</div>\n<div class=\"ts-chart-cell ts-chart-rec\">36\"</div>\n<div class=\"ts-chart-cell ts-hide-sm\" style=\"color:#666;\">35.5\" – 36.5\"</div>\n<div class=\"ts-chart-cell ts-chart-note ts-hide-sm\">—</div>\n</div>\n      </div>\n    </div>\n  </div>\n\n  <!-- GRIP GUIDE -->\n  <div id=\"ts-grips\" style=\"scroll-margin-top:52px;\">\n    <div class=\"ts-divider\"></div>\n    <div class=\"ts-wrap ts-section\">\n      <div class=\"ts-eyebrow\">\n<span class=\"ts-eyebrow-label\">Grip Guide</span><div class=\"ts-eyebrow-rule\"></div>\n</div>\n      <div class=\"ts-section-title\">CHOOSE YOUR GRIP</div>\n      <div class=\"ts-section-sub\">Every TS-503 ships with your chosen grip installed at no extra charge. 12 options across three shape families. Find yours below.</div>\n\n      <div class=\"ts-qpick-label-top\">Not sure? Start here —</div>\n      <div class=\"ts-qpick\">\n        <button class=\"ts-qpick-btn ts-on\" onclick=\"tsPickFam('standard', this)\"><div class=\"ts-qpick-q\">No strong preference</div>\n<div class=\"ts-qpick-rec\">→ Standard</div></button>\n        <button class=\"ts-qpick-btn\" onclick=\"tsPickFam('pistol', this)\"><div class=\"ts-qpick-q\">I grip the putter too tight</div>\n<div class=\"ts-qpick-rec\">→ Pistol Oversize</div></button>\n        <button class=\"ts-qpick-btn\" onclick=\"tsPickFam('flatcat', this)\"><div class=\"ts-qpick-q\">My wrists flip or rotate</div>\n<div class=\"ts-qpick-rec\">→ Flat Cat</div></button>\n      </div>\n\n      <div class=\"ts-fam-tabs\">\n        <button class=\"ts-fam-tab ts-on\" id=\"ts-tab-standard\" onclick=\"tsPickFam('standard', null)\">STANDARD</button>\n        <button class=\"ts-fam-tab\" id=\"ts-tab-pistol\" onclick=\"tsPickFam('pistol', null)\">PISTOL OVERSIZE</button>\n        <button class=\"ts-fam-tab\" id=\"ts-tab-flatcat\" onclick=\"tsPickFam('flatcat', null)\">FLAT CAT</button>\n      </div>\n\n      <div id=\"ts-desc-standard\" class=\"ts-fam-desc\">\n<div class=\"ts-fam-tagline\">Round — neutral, no top-side preference</div>\n<div class=\"ts-fam-body\">The classic cylindrical shape. No preferred orientation — works equally well with conventional, cross-handed, or claw putting styles. The right starting point if you don't have a strong preference.</div>\n</div>\n      <div id=\"ts-desc-pistol\" class=\"ts-fam-desc\" style=\"display:none;\">\n<div class=\"ts-fam-tagline\">Contoured back + larger diameter</div>\n<div class=\"ts-fam-body\">A raised ridge registers your trail thumb in the same position every time. The oversized diameter reduces grip pressure — the leading cause of tension-driven missed putts.</div>\n</div>\n      <div id=\"ts-desc-flatcat\" class=\"ts-fam-desc\" style=\"display:none;\">\n<div class=\"ts-fam-tagline\">Wide flat top — locks wrists square</div>\n<div class=\"ts-fam-body\">Both thumbs rest on a wide flat surface side by side. This physically prevents wrist rotation through impact — the root cause of most pulled and pushed putts.</div>\n</div>\n\n      <div id=\"ts-grips-standard\" class=\"ts-grip-grid\">\n        <div class=\"ts-grip-card\">\n<img class=\"ts-grip-img\" src=\"https://cdn.shopify.com/s/files/1/0597/8855/8523/files/BlackStandard_151ea53b-d1ff-4da7-846a-638ae5359e68.png?v=1772475242\" alt=\"Black Standard Grip\"><div class=\"ts-grip-body\">\n<div class=\"ts-grip-name\">BLACK STANDARD <span class=\"ts-pop-badge\">Most Popular</span>\n</div>\n<div class=\"ts-grip-who\">Our most popular grip. Neutral round profile — no handedness preference. Works with every putting style from conventional to claw. The reliable, no-gimmick choice.</div>\n<div class=\"ts-grip-tags\">\n<span class=\"ts-grip-tag\">Standard Size</span><span class=\"ts-grip-tag\">67g</span><span class=\"ts-grip-tag\">Smooth Rubber</span>\n</div>\n</div>\n</div>\n        <div class=\"ts-grip-card\">\n<img class=\"ts-grip-img\" src=\"https://cdn.shopify.com/s/files/1/0597/8855/8523/files/RedStandard_4bd8f9eb-c3f4-4c35-b0e8-0ec2a53a7e4a.png?v=1772475242\" alt=\"Red Standard Grip\"><div class=\"ts-grip-body\">\n<div class=\"ts-grip-name\">RED STANDARD</div>\n<div class=\"ts-grip-who\">Identical performance to Black Standard. Red colorway adds a sharp contrast against the Matte Silver head.</div>\n<div class=\"ts-grip-tags\">\n<span class=\"ts-grip-tag\">Standard Size</span><span class=\"ts-grip-tag\">67g</span><span class=\"ts-grip-tag\">Smooth Rubber</span>\n</div>\n</div>\n</div>\n      </div>\n\n      <div id=\"ts-grips-pistol\" class=\"ts-grip-grid ts-grip-hidden\">\n        <div class=\"ts-grip-card\">\n<img class=\"ts-grip-img\" src=\"https://cdn.shopify.com/s/files/1/0597/8855/8523/files/BlackMidsize_1800x1800_0a4560eb-30db-4888-8c86-cc6add5e541f.webp?v=1771501318\" alt=\"Black Pistol Oversize Grip\"><div class=\"ts-grip-body\">\n<div class=\"ts-grip-name\">BLACK PISTOL OVERSIZE</div>\n<div class=\"ts-grip-who\">For players who grip too tightly or have arthritis. The larger diameter naturally relaxes the hands, letting your shoulders — not your wrists — control the stroke.</div>\n<div class=\"ts-grip-tags\">\n<span class=\"ts-grip-tag\">Oversize</span><span class=\"ts-grip-tag\">97g</span><span class=\"ts-grip-tag\">Textured Rubber</span>\n</div>\n</div>\n</div>\n        <div class=\"ts-grip-card\">\n<img class=\"ts-grip-img\" src=\"https://cdn.shopify.com/s/files/1/0597/8855/8523/files/RedMidsize_04cfd170-6ea6-4322-9b78-06435ec4bfb5.png?v=1772475242\" alt=\"Red Pistol Oversize Grip\"><div class=\"ts-grip-body\">\n<div class=\"ts-grip-name\">RED PISTOL OVERSIZE</div>\n<div class=\"ts-grip-who\">Same as Black Pistol Oversize. Red colorway.</div>\n<div class=\"ts-grip-tags\">\n<span class=\"ts-grip-tag\">Oversize</span><span class=\"ts-grip-tag\">97g</span><span class=\"ts-grip-tag\">Textured Rubber</span>\n</div>\n</div>\n</div>\n      </div>\n\n      <div id=\"ts-grips-flatcat\" class=\"ts-grip-grid ts-grip-hidden\">\n        <div class=\"ts-grip-card\">\n<img class=\"ts-grip-img\" src=\"https://cdn.shopify.com/s/files/1/0597/8855/8523/files/8708NT-app-photo-2-sq.jpg?v=1772475242\" alt=\"Fat Original Grip\"><div class=\"ts-grip-body\">\n<div class=\"ts-grip-name\">FAT ORIGINAL</div>\n<div class=\"ts-grip-who\">Maximum stability. Widest flat-top profile in the lineup. Heaviest grip option.</div>\n<div class=\"ts-grip-tags\">\n<span class=\"ts-grip-tag\">Fat / Oversize</span><span class=\"ts-grip-tag\">80g</span><span class=\"ts-grip-tag\">Smooth Rubber</span>\n</div>\n</div>\n</div>\n        <div class=\"ts-grip-card\">\n<img class=\"ts-grip-img\" src=\"https://cdn.shopify.com/s/files/1/0597/8855/8523/files/8707NT-app-photo-2-sq.jpg?v=1772475242\" alt=\"Standard Original Grip\"><div class=\"ts-grip-body\">\n<div class=\"ts-grip-name\">STANDARD ORIGINAL</div>\n<div class=\"ts-grip-who\">The entry-point flat-top. Non-tacky, reliable in all weather. Best starting point for players new to flat-top grips.</div>\n<div class=\"ts-grip-tags\">\n<span class=\"ts-grip-tag\">Standard</span><span class=\"ts-grip-tag\">60g</span><span class=\"ts-grip-tag\">Smooth Rubber</span>\n</div>\n</div>\n</div>\n        <div class=\"ts-grip-card\">\n<img class=\"ts-grip-img\" src=\"https://cdn.shopify.com/s/files/1/0597/8855/8523/files/8727-app-photo-2-sq.jpg?v=1772475242\" alt=\"Standard Tak Grip\"><div class=\"ts-grip-body\">\n<div class=\"ts-grip-name\">STANDARD TAK</div>\n<div class=\"ts-grip-who\">Standard flat-top with extra-grippy tacky compound. Good for humid conditions or players who prefer more hand feel.</div>\n<div class=\"ts-grip-tags\">\n<span class=\"ts-grip-tag\">Standard</span><span class=\"ts-grip-tag\">92g</span><span class=\"ts-grip-tag\">Tacky Rubber</span>\n</div>\n</div>\n</div>\n        <div class=\"ts-grip-card\">\n<img class=\"ts-grip-img\" src=\"https://cdn.shopify.com/s/files/1/0597/8855/8523/files/8726-app-photo-2-sq.jpg?v=1772475242\" alt=\"Svelte Tak Grip\"><div class=\"ts-grip-body\">\n<div class=\"ts-grip-name\">SVELTE TAK</div>\n<div class=\"ts-grip-who\">Slim flat-top with tacky compound. Good for humid conditions or players who prefer a narrower diameter with extra grip.</div>\n<div class=\"ts-grip-tags\">\n<span class=\"ts-grip-tag\">Slim</span><span class=\"ts-grip-tag\">75g</span><span class=\"ts-grip-tag\">Tacky Rubber</span>\n</div>\n</div>\n</div>\n        <div class=\"ts-grip-card\">\n<img class=\"ts-grip-img\" src=\"https://cdn.shopify.com/s/files/1/0597/8855/8523/files/8718NT-app-photo-2-sq.jpg?v=1772475242\" alt=\"Original Svelte Grip\"><div class=\"ts-grip-body\">\n<div class=\"ts-grip-name\">ORIGINAL SVELTE</div>\n<div class=\"ts-grip-who\">Slim flat-top, non-tacky smooth rubber. For players who want the flat-top wrist benefit with a classic grip feel and diameter.</div>\n<div class=\"ts-grip-tags\">\n<span class=\"ts-grip-tag\">Slim</span><span class=\"ts-grip-tag\">50g</span><span class=\"ts-grip-tag\">Smooth Rubber</span>\n</div>\n</div>\n</div>\n        <div class=\"ts-grip-card\">\n<img class=\"ts-grip-img\" src=\"https://cdn.shopify.com/s/files/1/0597/8855/8523/files/8722-app-photo-2-sq.jpg?v=1772475242\" alt=\"Standard Solution Grip\"><div class=\"ts-grip-body\">\n<div class=\"ts-grip-name\">STANDARD SOLUTION ⚖</div>\n<div class=\"ts-grip-who\">Internal counterweight slows the stroke to a natural pendulum tempo. Great for players who rush their putts.</div>\n<div class=\"ts-grip-tags\">\n<span class=\"ts-grip-tag\">Standard + Weight</span><span class=\"ts-grip-tag\">170g</span><span class=\"ts-grip-tag\">Smooth Rubber</span>\n</div>\n</div>\n</div>\n        <div class=\"ts-grip-card\">\n<img class=\"ts-grip-img\" src=\"https://cdn.shopify.com/s/files/1/0597/8855/8523/files/8733-app-photo-2-sq.jpg?v=1772475242\" alt=\"Pistol Grip\"><div class=\"ts-grip-body\">\n<div class=\"ts-grip-name\">PISTOL</div>\n<div class=\"ts-grip-who\">Flat Cat's take on a pistol grip — slight thumb ridge without going full oversize. The middle ground between Standard and Pistol Oversize.</div>\n<div class=\"ts-grip-tags\">\n<span class=\"ts-grip-tag\">Std / Pistol</span><span class=\"ts-grip-tag\">79g</span><span class=\"ts-grip-tag\">Smooth Rubber</span>\n</div>\n</div>\n</div>\n        <div class=\"ts-grip-card\">\n<img class=\"ts-grip-img\" src=\"https://cdn.shopify.com/s/files/1/0597/8855/8523/files/8725-app-photo-2-sq.jpg?v=1772475242\" alt=\"Slim Svelte Grip\"><div class=\"ts-grip-body\">\n<div class=\"ts-grip-name\">SLIM SVELTE</div>\n<div class=\"ts-grip-who\">The slimmest profile in the Flat Cat lineup. Flat-top wrist stability in the narrowest possible diameter.</div>\n<div class=\"ts-grip-tags\">\n<span class=\"ts-grip-tag\">Slim</span><span class=\"ts-grip-tag\">64g</span><span class=\"ts-grip-tag\">Smooth Rubber</span>\n</div>\n</div>\n</div>\n      </div>\n    </div>\n  </div>\n\n  <!-- SPECS -->\n  <div id=\"ts-specs\" style=\"scroll-margin-top:52px;\">\n    <div class=\"ts-divider\"></div>\n    <div class=\"ts-wrap ts-section\">\n      <div class=\"ts-eyebrow\">\n<span class=\"ts-eyebrow-label\">Specifications</span><div class=\"ts-eyebrow-rule\"></div>\n</div>\n      <div class=\"ts-section-title\">TECH SPECS</div>\n      <div class=\"ts-spec-grid\">\n        <div class=\"ts-spec-cell\">\n<div class=\"ts-spec-k\">Construction</div>\n<div class=\"ts-spec-v\">303 Stainless Steel</div>\n</div>\n        <div class=\"ts-spec-cell\">\n<div class=\"ts-spec-k\">Finish</div>\n<div class=\"ts-spec-v\">Matte Silver</div>\n</div>\n        <div class=\"ts-spec-cell\">\n<div class=\"ts-spec-k\">Loft</div>\n<div class=\"ts-spec-v\">4°</div>\n</div>\n        <div class=\"ts-spec-cell\">\n<div class=\"ts-spec-k\">Lie Angle</div>\n<div class=\"ts-spec-v\">70°</div>\n</div>\n        <div class=\"ts-spec-cell\">\n<div class=\"ts-spec-k\">Head Weight</div>\n<div class=\"ts-spec-v\">340g</div>\n</div>\n<div class=\"ts-spec-cell\">\n<div class=\"ts-spec-k\">Style</div>\n<div class=\"ts-spec-v\">Traditional Blade</div>\n</div>\n        <div class=\"ts-spec-cell\">\n<div class=\"ts-spec-k\">Face</div>\n<div class=\"ts-spec-v\">Precision Milled</div>\n</div>\n        <div class=\"ts-spec-cell\">\n<div class=\"ts-spec-k\">Origin</div>\n<div class=\"ts-spec-v\">Made in USA</div>\n</div>\n        <div class=\"ts-spec-cell\">\n<div class=\"ts-spec-k\">Included</div>\n<div class=\"ts-spec-v\">Grip + Headcover</div>\n</div>\n      </div>\n    </div>\n  </div>\n\n  <!-- FAQ -->\n  <div id=\"ts-faq\" style=\"scroll-margin-top:52px;\">\n    <div class=\"ts-divider\"></div>\n    <div class=\"ts-wrap ts-section\">\n      <div class=\"ts-eyebrow\">\n<span class=\"ts-eyebrow-label\">Common Questions</span><div class=\"ts-eyebrow-rule\"></div>\n</div>\n      <div class=\"ts-section-title\">FAQ</div>\n      <div class=\"ts-faq-wrap\">\n        <div class=\"ts-faq-item\">\n<button class=\"ts-faq-q\" onclick=\"tsFaqToggle(this)\"><span>What makes the TS-503 different from other blade putters?</span><i class=\"ts-faq-icon\">+</i></button><div class=\"ts-faq-a\">The TS-503 is a traditional blade putter CNC-milled from 303 stainless steel in the USA. The face is precision milled, giving you pure, unfiltered feedback at impact. At 340g, it rewards players with a consistent, repeatable arc stroke and precise feel on every putt.</div>\n</div>\n        <div class=\"ts-faq-item\">\n<button class=\"ts-faq-q\" onclick=\"tsFaqToggle(this)\"><span>Is the grip included, or is it extra?</span><i class=\"ts-faq-icon\">+</i></button><div class=\"ts-faq-a\">Every TS-503 ships with your chosen grip installed at no extra charge. Choose from any of the 12 options in the grip guide above.</div>\n</div>\n        <div class=\"ts-faq-item\">\n<button class=\"ts-faq-q\" onclick=\"tsFaqToggle(this)\"><span>How do I choose the right shaft length?</span><i class=\"ts-faq-icon\">+</i></button><div class=\"ts-faq-a\">Use the height chart above as a starting point. At address, your eyes should sit over or just inside the ball with your arms hanging naturally. When in doubt, order the length that matches your height — it's correct for most golfers.</div>\n</div>\n        <div class=\"ts-faq-item\">\n<button class=\"ts-faq-q\" onclick=\"tsFaqToggle(this)\"><span>How durable is the Matte Silver finish?</span><i class=\"ts-faq-icon\">+</i></button><div class=\"ts-faq-a\">The Matte Silver finish is machined directly into the 303 stainless steel — no coating, no plating. 303 stainless steel is inherently corrosion-resistant and the matte surface develops a natural patina over time.</div>\n</div>\n        <div class=\"ts-faq-item\">\n<button class=\"ts-faq-q\" onclick=\"tsFaqToggle(this)\"><span>What are the loft and lie specs?</span><i class=\"ts-faq-icon\">+</i></button><div class=\"ts-faq-a\">4° loft, 70° lie — standard USGA-conforming specs.</div>\n</div>\n        <div class=\"ts-faq-item\">\n<button class=\"ts-faq-q\" onclick=\"tsFaqToggle(this)\"><span>Does it come with a headcover?</span><i class=\"ts-faq-icon\">+</i></button><div class=\"ts-faq-a\">Yes — a fitted headcover is included with every TS-503.</div>\n</div>\n      </div>\n    </div>\n  </div>\n\n</div>\n\n<script>\n  (function() {\n    var sections = ['ts-fit','ts-grips','ts-specs','ts-faq'];\n    var btns = document.querySelectorAll('#ts-nav .ts-nav-btn');\n    function onScroll() {\n      var scrollY = window.scrollY + 120;\n      var active = sections[0];\n      sections.forEach(function(id) {\n        var el = document.getElementById(id);\n        if (el && el.getBoundingClientRect().top + window.scrollY <= scrollY) active = id;\n      });\n      btns.forEach(function(btn, i) { btn.classList.toggle('ts-on', sections[i] === active); });\n    }\n    window.addEventListener('scroll', onScroll, { passive: true });\n  })();\n\n  function tsScrollTo(id) {\n    var el = document.getElementById(id);\n    if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });\n  }\n\n  var tsFams = ['standard','pistol','flatcat'];\n  function tsPickFam(fam, qpickBtn) {\n    document.querySelectorAll('.ts-qpick-btn').forEach(function(b) { b.classList.remove('ts-on'); });\n    if (qpickBtn) qpickBtn.classList.add('ts-on');\n    tsFams.forEach(function(f) {\n      var tab  = document.getElementById('ts-tab-' + f);\n      var desc = document.getElementById('ts-desc-' + f);\n      var grid = document.getElementById('ts-grips-' + f);\n      var show = f === fam;\n      if (tab) tab.classList.toggle('ts-on', show);\n      if (desc) desc.style.display = show ? 'block' : 'none';\n      if (grid) {\n        if (show) { grid.classList.remove('ts-grip-hidden'); grid.style.display = 'grid'; }\n        else { grid.classList.add('ts-grip-hidden'); grid.style.display = ''; }\n      }\n    });\n  }\n\n  function tsFaqToggle(btn) {\n    var answer = btn.nextElementSibling;\n    var icon = btn.querySelector('.ts-faq-icon');\n    var isOpen = answer.classList.contains('ts-open');\n    document.querySelectorAll('.ts-faq-a').forEach(function(a) { a.classList.remove('ts-open'); });\n    document.querySelectorAll('.ts-faq-icon').forEach(function(i) { i.style.transform = 'none'; });\n    if (!isOpen) { answer.classList.add('ts-open'); icon.style.transform = 'rotate(45deg)'; }\n  }\n</script>"
      }
    },
