    "shogun_custom_html_3mgfix": {
      "type": "shogun-custom-html",
      "disabled": true,
      "name": "Shogun Custom HTML",
      "settings": {
        "html": "<!-- T Squared — TS-905 Drop Block (Homepage + Drops Page) -->\n<div style=\"background-color:#0a0a0a;padding:48px 32px;margin:0;font-family:Arial,sans-serif;text-align:center;\">\n\n  <!-- Eyebrow -->\n  <p style=\"margin:0 0 10px;font-size:10px;font-weight:700;color:#aaa9a0;letter-spacing:4px;text-transform:uppercase;font-family:Arial,sans-serif;\">This Friday at Noon</p>\n\n  <!-- Headline -->\n  <p style=\"margin:0 0 4px;font-size:42px;font-weight:700;color:#ffffff;line-height:1.05;letter-spacing:-0.02em;font-family:Arial,sans-serif;\">First 10 Orders.</p>\n  <p style=\"margin:0 0 20px;font-size:42px;font-weight:700;color:#ffffff;line-height:1.05;letter-spacing:-0.02em;font-family:Arial,sans-serif;\">TS-905 at <span style=\"color:#e31b1b;\">$299.</span></p>\n\n  <!-- Divider -->\n  <table cellpadding=\"0\" cellspacing=\"0\" border=\"0\" align=\"center\" style=\"margin:0 auto 24px;\">\n    <tbody>\n<tr><td style=\"width:40px;height:2px;background-color:#e31b1b;font-size:0;line-height:0;\"> </td></tr>\n  </tbody>\n</table>\n\n  <!-- Description -->\n  <p style=\"margin:0 auto 16px;font-size:16px;font-weight:400;color:#b0aca3;line-height:1.8;font-family:Arial,sans-serif;max-width:480px;\">The first 10 orders on the TS-905 Mid-Mallet this Friday get it at <strong style=\"color:#ffffff;\">$299 — $50 off the regular price.</strong></p>\n  <p style=\"margin:0 auto 32px;font-size:16px;font-weight:400;color:#b0aca3;line-height:1.8;font-family:Arial,sans-serif;max-width:480px;\">Once those 10 are gone the price goes back to $349. No code needed. First come first served.</p>\n\n  <!-- Image -->\n  <div style=\"margin:0 auto 32px;max-width:320px;\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0597/8855/8523/files/TS-905_Back_Silver_Short.webp?v=1771494925\" alt=\"TS-905 Mid-Mallet\" style=\"display:block;width:100%;height:auto;\">\n  </div>\n\n  <!-- Details box -->\n  <table cellpadding=\"0\" cellspacing=\"0\" border=\"0\" align=\"center\" style=\"margin:0 auto 32px;background-color:#161616;border:1px solid #2a2a2a;max-width:400px;width:100%;\">\n    <tbody>\n<tr>\n      <td style=\"padding:24px 28px;\">\n        <p style=\"margin:0 0 14px;font-size:10px;font-weight:700;color:#666660;letter-spacing:3px;text-transform:uppercase;font-family:Arial,sans-serif;text-align:center;\">Drop Details</p>\n        <table cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\">\n          <tbody>\n<tr>\n            <td style=\"padding:6px 0;border-bottom:1px solid #222222;font-size:13px;color:#888880;font-family:Arial,sans-serif;\">Model</td>\n            <td style=\"padding:6px 0;border-bottom:1px solid #222222;font-size:13px;color:#ffffff;font-weight:700;font-family:Arial,sans-serif;text-align:right;\">TS-905 Mid-Mallet</td>\n          </tr>\n          <tr>\n            <td style=\"padding:6px 0;border-bottom:1px solid #222222;font-size:13px;color:#888880;font-family:Arial,sans-serif;\">Drop Price</td>\n            <td style=\"padding:6px 0;border-bottom:1px solid #222222;font-size:13px;color:#e31b1b;font-weight:700;font-family:Arial,sans-serif;text-align:right;\">$299</td>\n          </tr>\n          <tr>\n            <td style=\"padding:6px 0;border-bottom:1px solid #222222;font-size:13px;color:#888880;font-family:Arial,sans-serif;\">Regular Price</td>\n            <td style=\"padding:6px 0;border-bottom:1px solid #222222;font-size:13px;color:#ffffff;font-weight:700;font-family:Arial,sans-serif;text-align:right;\">$349</td>\n          </tr>\n          <tr>\n            <td style=\"padding:6px 0;border-bottom:1px solid #222222;font-size:13px;color:#888880;font-family:Arial,sans-serif;\">Available To</td>\n            <td style=\"padding:6px 0;border-bottom:1px solid #222222;font-size:13px;color:#ffffff;font-weight:700;font-family:Arial,sans-serif;text-align:right;\">First 10 Orders Only</td>\n          </tr>\n          <tr>\n            <td style=\"padding:6px 0;font-size:13px;color:#888880;font-family:Arial,sans-serif;\">Drops</td>\n            <td style=\"padding:6px 0;font-size:13px;color:#ffffff;font-weight:700;font-family:Arial,sans-serif;text-align:right;\">Friday at 12:00 PM EST</td>\n          </tr>\n        </tbody>\n</table>\n      </td>\n    </tr>\n  </tbody>\n</table>\n\n  <!-- Drop badge -->\n  <table cellpadding=\"0\" cellspacing=\"0\" border=\"0\" align=\"center\" style=\"margin:0 auto 28px;\">\n    <tbody>\n<tr>\n      <td style=\"background-color:#161616;border:1px solid #2a2a2a;padding:10px 20px;\">\n        <p style=\"margin:0;font-size:11px;font-weight:600;color:#888880;letter-spacing:3px;text-transform:uppercase;font-family:Arial,sans-serif;\">\n          <span style=\"display:inline-block;width:7px;height:7px;background-color:#e31b1b;border-radius:50%;margin-right:8px;vertical-align:middle;\"></span>\n          Friday 12:00 PM EST — First 10 Orders at $299\n        </p>\n      </td>\n    </tr>\n  </tbody>\n</table>\n\n  <!-- CTA -->\n  <table cellpadding=\"0\" cellspacing=\"0\" border=\"0\" align=\"center\">\n    <tbody>\n<tr>\n      <td align=\"center\" style=\"background-color:#e31b1b;\">\n        <a href=\"https://tsquaredputters.com/products/ts-905\" style=\"display:inline-block;background-color:#e31b1b;color:#ffffff;font-family:Arial,sans-serif;font-size:12px;font-weight:700;letter-spacing:3px;text-transform:uppercase;text-decoration:none;padding:18px 48px;\">SHOP THE TS-905 →</a>\n      </td>\n    </tr>\n  </tbody>\n</table>\n\n  <!-- Fine print -->\n  <p style=\"margin:16px 0 0;font-size:11px;color:#555550;letter-spacing:1px;font-family:Arial,sans-serif;\">First 10 orders only. Price returns to $349 after. No code needed.</p>\n\n</div>"
      }
