    "shogun_custom_html_rwfPia": {
      "type": "shogun-custom-html",
      "name": "Shogun Custom HTML",
      "settings": {
        "html": "<meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>T Squared — Putters</title>\n  <link href=\"https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800;900&amp;family=Barlow:wght@400;500&amp;display=swap\" rel=\"stylesheet\">\n  <style>\n    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\n\n    :root {\n      --bg:        #0d0d0d;\n      --card-bg:   #141414;\n      --accent:    #c8102e;   /* T Squared red */\n      --text:      #ffffff;\n      --muted:     rgba(255,255,255,0.55);\n      --card-w:    300px;\n      --card-h:    400px;\n    }\n\n    body {\n      background: var(--bg);\n      font-family: 'Barlow', sans-serif;\n      color: var(--text);\n    }\n\n    /* ── Section ── */\n    .products-section {\n      padding: 60px 0 80px;\n    }\n\n    .section-header {\n      padding: 0 48px 32px;\n      display: flex;\n      align-items: baseline;\n      gap: 16px;\n    }\n    .section-title {\n      font-family: 'Barlow Condensed', sans-serif;\n      font-size: 13px;\n      font-weight: 700;\n      letter-spacing: .2em;\n      text-transform: uppercase;\n      color: var(--muted);\n    }\n    .section-title span {\n      color: var(--accent);\n      margin-right: 6px;\n    }\n\n    /* ── Scroll wrapper ── */\n    .scroll-wrapper {\n      position: relative;\n    }\n\n    .scroll-track {\n      display: flex;\n      gap: 2px;\n      overflow-x: auto;\n      scroll-behavior: smooth;\n      padding: 0 48px 28px;\n      scrollbar-width: none;\n      -ms-overflow-style: none;\n      cursor: grab;\n      user-select: none;\n    }\n    .scroll-track:active { cursor: grabbing; }\n    .scroll-track::-webkit-scrollbar { display: none; }\n\n    /* ── Arrows ── */\n    .arrow {\n      position: absolute;\n      top: calc(50% - 14px);\n      transform: translateY(-50%);\n      z-index: 10;\n      width: 40px;\n      height: 40px;\n      border: 1px solid rgba(255,255,255,0.2);\n      background: rgba(13,13,13,0.9);\n      color: #fff;\n      font-size: 20px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      cursor: pointer;\n      transition: border-color .2s, background .2s;\n    }\n    .arrow:hover { border-color: var(--accent); background: rgba(200,16,46,.12); color: var(--accent); }\n    .arrow.prev { left: 4px; }\n    .arrow.next { right: 4px; }\n\n    /* ── Card ── */\n    .product-card {\n      flex: 0 0 var(--card-w);\n      height: var(--card-h);\n      position: relative;\n      overflow: hidden;\n      background: var(--card-bg);\n      cursor: pointer;\n    }\n\n    /* Red left-border accent on hover */\n    .product-card::before {\n      content: '';\n      position: absolute;\n      left: 0; top: 0; bottom: 0;\n      width: 2px;\n      background: var(--accent);\n      transform: scaleY(0);\n      transform-origin: bottom;\n      transition: transform .35s ease;\n      z-index: 4;\n    }\n    .product-card:hover::before { transform: scaleY(1); }\n\n    /* category tag */\n    .card-category {\n      position: absolute;\n      top: 14px;\n      left: 14px;\n      z-index: 3;\n      font-family: 'Barlow', sans-serif;\n      font-size: 10px;\n      font-weight: 500;\n      letter-spacing: .18em;\n      color: var(--muted);\n      text-transform: uppercase;\n      display: flex;\n      align-items: center;\n      gap: 6px;\n    }\n    .card-category::before {\n      content: '';\n      width: 6px; height: 6px;\n      border-radius: 50%;\n      background: var(--accent);\n      display: inline-block;\n    }\n\n    /* image layers */\n    .card-img-wrap {\n      position: absolute;\n      inset: 0;\n    }\n    .card-img-wrap img {\n      position: absolute;\n      inset: 0;\n      width: 100%;\n      height: 100%;\n      object-fit: cover;\n      transition: opacity .55s cubic-bezier(.4,0,.2,1);\n    }\n    /* Default image: slightly zoomed out, centered */\n    .card-img-wrap .img-default { opacity: 1; }\n    .card-img-wrap .img-hover   { opacity: 0; }\n\n    .product-card:hover .img-default { opacity: 0; }\n    .product-card:hover .img-hover   { opacity: 1; }\n\n    /* bottom info overlay */\n    .card-info {\n      position: absolute;\n      bottom: 0; left: 0; right: 0;\n      z-index: 3;\n      padding: 0 18px 20px;\n      background: linear-gradient(to top,\n        rgba(13,13,13,.97) 0%,\n        rgba(13,13,13,.8) 55%,\n        rgba(13,13,13,0) 100%);\n    }\n\n    /* buttons — hidden until hover */\n    .card-actions {\n      display: flex;\n      gap: 8px;\n      margin-bottom: 14px;\n      opacity: 0;\n      transform: translateY(8px);\n      transition: opacity .3s ease, transform .3s ease;\n    }\n    .product-card:hover .card-actions {\n      opacity: 1;\n      transform: translateY(0);\n    }\n\n    .btn {\n      flex: 1;\n      padding: 9px 4px;\n      font-family: 'Barlow Condensed', sans-serif;\n      font-size: 11px;\n      font-weight: 700;\n      letter-spacing: .18em;\n      text-transform: uppercase;\n      text-align: center;\n      border: 1px solid rgba(255,255,255,.35);\n      cursor: pointer;\n      transition: background .2s, color .2s, border-color .2s;\n      text-decoration: none;\n      display: block;\n    }\n    .btn-outline { background: transparent; color: #fff; }\n    .btn-outline:hover { background: #fff; color: #000; border-color: #fff; }\n    .btn-fill   { background: var(--accent); color: #fff; border-color: var(--accent); }\n    .btn-fill:hover { background: #a00d24; border-color: #a00d24; }\n\n    .card-name {\n      font-family: 'Barlow Condensed', sans-serif;\n      font-size: 22px;\n      font-weight: 900;\n      letter-spacing: .04em;\n      text-transform: uppercase;\n      line-height: 1.1;\n      margin-bottom: 5px;\n    }\n    .card-desc {\n      font-size: 12px;\n      line-height: 1.5;\n      color: var(--muted);\n      margin-bottom: 8px;\n      display: -webkit-box;\n      -webkit-line-clamp: 2;\n      -webkit-box-orient: vertical;\n      overflow: hidden;\n    }\n    .card-price {\n      font-family: 'Barlow Condensed', sans-serif;\n      font-size: 15px;\n      font-weight: 700;\n      letter-spacing: .05em;\n      color: var(--accent);\n    }\n  </style>\n\n\n\n<section class=\"products-section\">\n\n  <div class=\"section-header\">\n    <p class=\"section-title\"><span>//</span> Our Putters</p>\n  </div>\n\n  <div class=\"scroll-wrapper\">\n    <button class=\"arrow prev\" id=\"prevBtn\">‹</button>\n    <button class=\"arrow next\" id=\"nextBtn\">›</button>\n\n    <div class=\"scroll-track\" id=\"track\">\n\n      <!-- ══════════════════════════════════════\n           CARD 1 — TS-1029 MALLET\n           img-default: front/address view\n           img-hover:   different angle of same putter\n      ══════════════════════════════════════ -->\n      <div class=\"product-card\">\n        <span class=\"card-category\">Mallet</span>\n        <div class=\"card-img-wrap\">\n          <img class=\"img-default\" src=\"https://cdn.shopify.com/s/files/1/0597/8855/8523/files/IMG_0770.jpg?v=1774461129\" alt=\"TS-1029 Mallet\">\n          <img class=\"img-hover\" src=\"https://cdn.shopify.com/s/files/1/0597/8855/8523/files/TS-1029-Hero_Center.webp?v=1771563611\" alt=\"TS-1029 Mallet alternate angle\">\n        </div>\n        <div class=\"card-info\">\n          <div class=\"card-actions\">\n            <a href=\"https://tsquaredputters.com/products/ts-1029-mallet\" class=\"btn btn-outline\">Shop Now</a>\n            <a href=\"https://tsquaredputters.com/products/ts-1029-mallet\" class=\"btn btn-fill\">Learn More</a>\n          </div>\n          <div class=\"card-name\">TS-1029 Mallet</div>\n          <div class=\"card-desc\">Engineered for ultimate forgiveness, built from a full aerospace-grade aluminum body.</div>\n          <div class=\"card-price\">$349.00</div>\n        </div>\n      </div>\n\n      <!-- ══════════════════════════════════════\n           CARD 2 — TS-912 MID-MALLET (TOUR)\n      ══════════════════════════════════════ -->\n      <div class=\"product-card\">\n        <span class=\"card-category\">Mid-Mallet</span>\n        <div class=\"card-img-wrap\">\n          <img class=\"img-default\" src=\"https://cdn.shopify.com/s/files/1/0597/8855/8523/files/IMG_0757.jpg?v=1774460564\" alt=\"TS-912 Mid-Mallet Tour\">\n          <img class=\"img-hover\" src=\"https://cdn.shopify.com/s/files/1/0597/8855/8523/files/TS-912_Silver_Short_v2.png?v=1736350780\" alt=\"TS-912 Mid-Mallet Tour alternate angle\">\n        </div>\n        <div class=\"card-info\">\n          <div class=\"card-actions\">\n            <a href=\"https://tsquaredputters.com/products/ts-912-mid-mallet-tour\" class=\"btn btn-outline\">Shop Now</a>\n            <a href=\"https://tsquaredputters.com/products/ts-912-mid-mallet-tour\" class=\"btn btn-fill\">Learn More</a>\n          </div>\n          <div class=\"card-name\">TS-912 Mid-Mallet (Tour)</div>\n          <div class=\"card-desc\">A square mid-mallet with soft subtle sloping lines and a refined curved sole.</div>\n          <div class=\"card-price\">$349.00</div>\n        </div>\n      </div>\n\n      <!-- ══════════════════════════════════════\n           CARD 3 — TS-1106+ MALLET\n      ══════════════════════════════════════ -->\n      <div class=\"product-card\">\n        <span class=\"card-category\">Mallet</span>\n        <div class=\"card-img-wrap\">\n          <img class=\"img-default\" src=\"https://cdn.shopify.com/s/files/1/0597/8855/8523/files/IMG_0773_2.jpg?v=1774461129\" alt=\"TS-1106+ Mallet\">\n          <img class=\"img-hover\" src=\"https://cdn.shopify.com/s/files/1/0597/8855/8523/files/TS-1106__TH_Silver_Hero.webp?v=1771565910\" alt=\"TS-1106+ Mallet alternate angle\">\n        </div>\n        <div class=\"card-info\">\n          <div class=\"card-actions\">\n            <a href=\"https://tsquaredputters.com/products/ts-1106\" class=\"btn btn-outline\">Shop Now</a>\n            <a href=\"https://tsquaredputters.com/products/ts-1106\" class=\"btn btn-fill\">Learn More</a>\n          </div>\n          <div class=\"card-name\">TS-1106+ Mallet</div>\n          <div class=\"card-desc\">Affectionately known as \"The CAT.\" Face balanced only. A defining shape in our lineup.</div>\n          <div class=\"card-price\">$349.00</div>\n        </div>\n      </div>\n\n      <!-- ══════════════════════════════════════\n           CARD 4 — TS-503 BLADE\n      ══════════════════════════════════════ -->\n      <div class=\"product-card\">\n        <span class=\"card-category\">Blade</span>\n        <div class=\"card-img-wrap\">\n          <img class=\"img-default\" src=\"https://cdn.shopify.com/s/files/1/0597/8855/8523/files/IMG_0755.jpg?v=1774460564\" alt=\"TS-503 Blade\">\n          <img class=\"img-hover\" src=\"https://cdn.shopify.com/s/files/1/0597/8855/8523/files/TS-503_Silver_Short.png?v=1736353340\" alt=\"TS-503 Blade alternate angle\">\n        </div>\n        <div class=\"card-info\">\n          <div class=\"card-actions\">\n            <a href=\"https://tsquaredputters.com/products/ts-503-blade\" class=\"btn btn-outline\">Shop Now</a>\n            <a href=\"https://tsquaredputters.com/products/ts-503-blade\" class=\"btn btn-fill\">Learn More</a>\n          </div>\n          <div class=\"card-name\">TS-503 Blade</div>\n          <div class=\"card-desc\">A sleek version of the classic blade providing a compact setup at address.</div>\n          <div class=\"card-price\">$349.00</div>\n        </div>\n      </div>\n\n      <!-- ══════════════════════════════════════\n           CARD 5 — TS-713 MID-MALLET\n      ══════════════════════════════════════ -->\n      <div class=\"product-card\">\n        <span class=\"card-category\">Mid-Mallet</span>\n        <div class=\"card-img-wrap\">\n          <img class=\"img-default\" src=\"https://cdn.shopify.com/s/files/1/0597/8855/8523/files/IMG_0766_2.jpg?v=1774461157\" alt=\"TS-713 Mid-Mallet\">\n          <img class=\"img-hover\" src=\"https://cdn.shopify.com/s/files/1/0597/8855/8523/files/TS-713_Silver_Short_v2.png?v=1724979211\" alt=\"TS-713 Mid-Mallet alternate angle\">\n        </div>\n        <div class=\"card-info\">\n          <div class=\"card-actions\">\n            <a href=\"https://tsquaredputters.com/products/713-mid-mallet\" class=\"btn btn-outline\">Shop Now</a>\n            <a href=\"https://tsquaredputters.com/products/713-mid-mallet\" class=\"btn btn-fill\">Learn More</a>\n          </div>\n          <div class=\"card-name\">TS-713 Mid-Mallet</div>\n          <div class=\"card-desc\">An update on the classic blade, featuring soft subtle sloping flanges for added forgiveness.</div>\n          <div class=\"card-price\">$349.00</div>\n        </div>\n      </div>\n\n      <!-- ══════════════════════════════════════\n           CARD 6 — TS-713I MID-MALLET\n      ══════════════════════════════════════ -->\n      <div class=\"product-card\">\n        <span class=\"card-category\">Mid-Mallet</span>\n        <div class=\"card-img-wrap\">\n          <img class=\"img-default\" src=\"https://cdn.shopify.com/s/files/1/0597/8855/8523/files/IMG_0763.jpg?v=1774461157\" alt=\"TS-713I Mid-Mallet\">\n          <img class=\"img-hover\" src=\"https://cdn.shopify.com/s/files/1/0597/8855/8523/files/TS-713i_Silver_Short_v2.webp?v=1771506832\" alt=\"TS-713I Mid-Mallet alternate angle\">\n        </div>\n        <div class=\"card-info\">\n          <div class=\"card-actions\">\n            <a href=\"https://tsquaredputters.com/products/ts-713i-mid-mallet\" class=\"btn btn-outline\">Shop Now</a>\n            <a href=\"https://tsquaredputters.com/products/ts-713i-mid-mallet\" class=\"btn btn-fill\">Learn More</a>\n          </div>\n          <div class=\"card-name\">TS-713I Mid-Mallet</div>\n          <div class=\"card-desc\">An update on the classic blade, featuring soft subtle sloping flanges with an insert face.</div>\n          <div class=\"card-price\">$349.00<