    "faq_Ayc6Xm": {
      "type": "faq",
      "blocks": {
        "question_rRBKtJ": {
          "type": "question",
          "settings": {
            "title": "What if I'm not ready to buy something?",
            "text": "<p>No problem. We can put the $150 store credit  on a Gift Card that you can use anytime.</p>"
          }
        },
        "question_EkTpyJ": {
          "type": "question",
          "settings": {
            "title": "Can I trade in more than one putter on the same order?",
            "text": "<p><strong>No — only one trade-in is allowed per order.</strong>Our Trade-In Program is designed to offer fair value on a one-to-one basis. If you have multiple putters you'd like to trade in, you'll need to submit separate orders for each trade-in credit to be applied individually.</p>"
          }
        },
        "question_rmwjwF": {
          "type": "question",
          "settings": {
            "title": "What are the condition requirements for my putter to qualify for the program?",
            "text": "<p>Your putter can be in any condition to qualify for the program; it just needs to be intact</p>"
          }
        },
        "question_RUhcfz": {
          "type": "question",
          "settings": {
            "title": "When will I receive my new putter after trading in mine?",
            "text": "<p>You will receive your new putter once we have received your trade-in and payment has been processed. The building and shipping of your new putter will take 2-3 weeks or less.</p>"
          }
        },
        "question_93bYA7": {
          "type": "question",
          "settings": {
            "title": "Can I customize my new putter?",
            "text": "<p>Yes, this process is the same as a regular order, except you're sending in your putter to receive $150 off a T Squared Putter.</p>"
          }
        },
        "question_8WTFqR": {
          "type": "question",
          "settings": {
            "title": "Am I able to return the new T Squared putter I receive?",
            "text": "<p>All sales are final for the Trade-In Program, and returns are not accepted for the new T Squared putter received through this offer</p>"
          }
        },
        "question_JRqH69": {
          "type": "question",
          "settings": {
            "title": "Why can't I see the Trade-In Program option at checkout?",
            "text": "<p>The Trade-In Program is not available directly at checkout. To participate, you must first complete the contact form on our website. After submitting the form, a T Squared representative will send you a prepaid shipping label for your putter. Once we have received your trade-in, you will be sent a unique discount code to apply towards your new T Squared Putter at checkout.</p>"
          }
        },
        "question_GWzxRy": {
          "type": "question",
          "settings": {
            "title": "When and how will I receive credit for my trade-in?",
            "text": "<p>Once we receive your trade-in, we'll send you a unique code to use at checkout to redeem your $150 store credit.</p>"
          }
        },
        "question_pwNFUX": {
          "type": "question",
          "settings": {
            "title": "Can I combine discount codes or promotions?",
            "text": "<p>No, discount codes and promotional offers cannot be combined. Only one discount or promotion may be applied per order.</p>"
          }
        }
      },
