        "text_QypbDa": {
          "type": "text",
          "settings": {
            "enlarge_text": true,
            "text": "<h1>T Squared Trade-In Program</h1>"
          }
        },
        "text_cCypRc": {
          "type": "text",
          "settings": {
            "enlarge_text": true,
            "text": "<p><strong>Upgrade Your Putter with the T Squared Trade-In Program - </strong>Exchange any putter, regardless of brand or condition, and receive <strong>$150</strong> towards the purchase of a new T Squared Putter of your choice. It’s a simple and seamless way to improve your game with a premium, precision-crafted putter. Visit us today to take advantage of this exclusive offer and elevate your putting performance.</p>"
          }
        }
      },
      "block_order": [
