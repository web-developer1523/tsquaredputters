    "rich_text_8qhPW6": {
      "type": "rich-text",
      "blocks": {
        "heading_CwXU4h": {
          "type": "heading",
          "settings": {
            "title": "Two easy ways to trade in"
          }
        },
        "text_NUwmjW": {
          "type": "text",
          "settings": {
            "enlarge_text": true,
            "text": "<p>Trade in your putter and save $150 on a new one! For online trade-ins, simply mail us your putter. Prefer in-person? Drop it off at our store to redeem your discount instantly.</p><p>If you are interested in the program, please provide your shipping address and email in the contact form below.</p>"
          }
        },
        "button_4TKV9L": {
          "type": "button",
          "settings": {
            "link": "https://tsquaredputters.com/pages/contact",
            "link_text": "Contact"
          }
        }
      },
