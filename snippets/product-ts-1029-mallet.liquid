    const tempImg = new Image();
    tempImg.crossOrigin = "anonymous";
    tempImg.src = img.src;
    tempImg.onload = function() {
      ctx.drawImage(tempImg, 0, 0, canvas.width, canvas.height);
      loaded++;
      if (loaded === images.length) uploadToCloudinary(canvas);
    };
  });

  function uploadToCloudinary(canvas) {
    const base64Data = canvas.toDataURL("image/png").split(",")[1];
    const formData = new FormData();
    formData.append("file", "data:image/png;base64," + base64Data);
    formData.append("upload_preset", UPLOAD_PRESET);

    fetch(`https://api.cloudinary.com/v1_1/${CLOUD_NAME}/image/upload`, {
      method: "POST",
      body: formData
    })
    .then(res => res.json())
    .then(data => {
      if(data.secure_url){
        document.getElementById("final-combined").src = canvas.toDataURL("image/png");
        document.getElementById("shareable-link").value = data.secure_url;

        // ✅ Add to cart attributes if form exists
        const cartForm = document.querySelector("form[action*='/cart']");
        if(cartForm){
          cartForm.insertAdjacentHTML(
            "beforeend",
            `<input type="hidden" name="attributes[Image]" value="${canvas.toDataURL("image/png")}">`
          );
        }
      }
          {% comment %} add to cart ajax {% endcomment %}
        var variant_id = $('.cst-custom-add-to-cart').data('variant');
        var quantity = 1;
        var imageLink = $('#shareable-link').val();  // Get the image link value
        console.log(imageLink); 

        var properties = {
            "Image": imageLink
        };    
    
         // Loop through ALL images in preview (not just active ones)
        $('#custom-image-preview img').each(function() {
            $.each(this.attributes, function() {
            if (this.specified) {
                // Check for custom attributes (finish_color, shaft_color, balance, etc.)
                if (this.name.endsWith('_color') || this.name === 'balance' || this.name === 'club_lie' || this.name === 'base_plate_color' || this.name === 'hand_style' || this.name === 'grip_style' || this.name === 'shaft_length') {
                // Format key nicely
                let key = this.name.replace('_color', '')
                                    .replace('_', ' ') 
                                    .replace(/\b\w/g, c => c.toUpperCase()); 

                // Only set property if not already set (to avoid duplicates)
                if (!properties[key]) {
                    properties[key] = this.value;
                }
                }
            }
            });
        });

        var addData = {
            id: variant_id,
            quantity: quantity,
            properties: properties
        };
        console.log("Final properties being sent:", properties);

        $.ajax({
            type: 'POST',
            url: '/cart/add.js',
            dataType: 'json',
            data: addData,
            success: function(res) {
                console.log('Item added to cart:', res);
                $('.cst-custom-add-to-cart .loader').hide();
                $('.cst-custom-add-to-cart').removeClass('cst-disabled');
                window.location.href="/cart";
            },
            error: function(err) {
                console.error('Error adding to cart:', err);
            }
        });  
    })
    .catch(err => console.error("Cloudinary upload error:", err));
  }
});
  
    {% comment %} end {% endcomment %}

    {% comment %} add to cart ajax {% endcomment %}

    $(document).on('click', '.cst-custom-add-to-cart', function(e) {
        e.preventDefault();
        {% comment %} check validation {% endcomment %}
        const container = $('.tab1 .image-wrapper .default-image-sides');
        const requiredGroups = ['finish','shaft','balance','sightline_color','base_plate', 'hand_style','grip_style','club_lie','shaft_length'];
        
        let missing = [];

        // Check if each required group exists in the preview
        requiredGroups.forEach(group => {
            if (container.find('img.' + group).length === 0) {
            missing.push(group.replace(/_/g, ' '));
            }
        });

        // Check which balance type is selected
        const balanceImg = container.find('img.balance');
        const balanceAlt = balanceImg.attr('alt');

        if (balanceAlt === 'ts_1029_select_balance_1') {
            // plumbers neck required
            if (container.find('img.plumbers_neck').length === 0) {
            missing.push('Plumbers Neck');
            }
        } else if (balanceAlt === 'ts_1029_select_balance_2') {
            // center shaft required
            if (container.find('img.center_shaft').length === 0) {
            missing.push('Center Shaft');
            }
        }

        if (missing.length > 0) {
            const alertBox = $('.alert-message');
            const formattedMissing = missing.map(name =>
              name.split(' ').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' '));
              const message = 'Please select: ' + formattedMissing.join(', ') + ' before adding to cart.';

            alertBox.html(message).stop(true, true).fadeIn(200).delay(4000);
            return false;
        }
        {% comment %} end validation {% endcomment %}
        $('.cst-custom-add-to-cart .loader').css('display','inline-block');
        $('.cst-custom-add-to-cart').addClass('cst-disabled');
         $('#merge-btn').trigger('click');

    });

    {% comment %} responsive open and close {% endcomment %}
    $('.cross-btn').click(function(){
        $('.color-selector').removeClass('active');
    });

    $('#tabMenu .tab').click(function(){
        $('.color-selector').addClass('active');
    });
});
