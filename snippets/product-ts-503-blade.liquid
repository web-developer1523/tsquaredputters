    const tabs = document.querySelectorAll(".tab");
    const sectionTitle = document.getElementById("sectionTitle");
    const colorGrid = document.getElementById("colorGrid");

    function loadColors(tabName) {
        sectionTitle.textContent = `${tabName}`;
        colorGrid.innerHTML = "";
        const colors = colorOptions[tabName] || [];

        colors.forEach((color) => {
            const box = document.createElement("div");
            box.className = "color-box";

            const img = document.createElement("img");
            img.src = color.url;
            img.alt = color.alt;
            img.className = "color-image";

            const info = document.createElement("div");
            info.className = "info-button";
            info.textContent = "+ info";

            box.appendChild(img);
            box.appendChild(info);

            // ✅ Add title ONLY for Club_lie
            if(tabName === "Club_lie" && color.title){
                const titleEl = document.createElement("div");
                titleEl.className = "club-lie-title";
                titleEl.textContent = color.title;
                box.appendChild(titleEl);
            }

            colorGrid.appendChild(box);
        });
    }

    tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
            document.querySelector(".tab.active")?.classList.remove("active");
            tab.classList.add("active");
            const selectedTab = tab.getAttribute("data-tab");
            loadColors(selectedTab);
        });
    });

    // Live-update shaft image when DOM or shaft_color changes inside the default-image-sides container
    (function () {
        var $container = $('.tab1 .image-wrapper .default-image-sides');
        if ($container.length === 0) return;

        const short_plumber_neck_shaft_image = {
            Silver: 'https://cdn.shopify.com/s/files/1/0597/8855/8523/files/ts_503_shaft_link_1.png',
            Black: 'https://cdn.shopify.com/s/files/1/0597/8855/8523/files/ts_503_shaft_link_2.png'
        };
        const long_plumber_neck_shaft_image = {
            Silver: 'https://cdn.shopify.com/s/files/1/0597/8855/8523/files/TS-503_Silver_Long_shaft_1.png',
            Black: 'https://cdn.shopify.com/s/files/1/0597/8855/8523/files/TS-503_Silver_Long_shaft_2.png'
        };

        function preloadAndSwap($shaft, url) {
            if (!$shaft || $shaft.length === 0 || !url) return;
            try {
                if ($shaft.attr('src') === url) return;
            } catch (e) {}

            // remove any previous overlay to avoid stacking
            $container.find('.shaft-overlay').remove();

            var img = new Image();
            img.onload = function () {
                // If shaft isn't visible just set the src and show it
                if ($shaft.is(':hidden')) {
                    $shaft.attr('src', url).show();
                    
                    return;
                }

                // Crossfade using an overlay image so the original doesn't go transparent
                var zIndex = parseInt($shaft.css('z-index'), 10) || 1;
                // compute position & size to exactly match the shaft element
                var relPos = $shaft.position(); // position relative to $container
                var shaftW = $shaft.outerWidth();
                var shaftH = $shaft.outerHeight();

                var $overlay = $('<img/>')
                    .addClass('shaft-overlay')
                    .attr('src', url)
                    .css({
                        position: 'absolute',
                        top: relPos.top,
                        left: "-30px",
                        opacity: 0
                    })
                    .appendTo($container);

                // animate overlay in, then swap the real image src and remove overlay
                $overlay.stop(true, true).animate({ opacity: 1 }, 50, function () {
                    try { $shaft.attr('src', url); } catch (e) {}
                    $overlay.remove();
                });
            };
            img.src = url;
        }

        function updateShaftImage() {
            var $shaft = $container.find('.shaft');
            // prefer short plumber neck if present
            if ($container.find('.short_plumber_neck.balance-only').length > 0) {
                var color = $shaft.attr('shaft_color');
                var url = short_plumber_neck_shaft_image[color];
                preloadAndSwap($shaft, url);
                return;
            }
            if ($container.find('.long_plumber_neck.balance-only').length > 0) {
                var color = $shaft.attr('shaft_color');
                var url = long_plumber_neck_shaft_image[color];
                preloadAndSwap($shaft, url);
                return;
            }
        }

        var debounceTimer = null;
        var observer = new MutationObserver(function () {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(updateShaftImage, 30);
        });

        // Observe for added/removed nodes and attribute changes (class, custom attrs) in subtree
        observer.observe($container[0], { childList: true, subtree: true, attributes: true, attributeFilter: ['class', 'shaft_color'] });

        // initial run
        updateShaftImage();
    })();
    // Initial load
    loadColors("Finish");

