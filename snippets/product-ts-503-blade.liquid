<script>
$(document).ready(function () {
// Initially hide the divs you want to show
$('.tab1 .style-tab .sidebar .tab[data-tab="Short_plumber_neck"]').hide();
$('.tab1 .style-tab .sidebar .tab[data-tab="Long_plumber_neck"]').hide();

// Use event delegation for dynamically added images
$(document).on('click', '#colorGrid .color-image', function() {
  var altText = $(this).attr('alt');
  console.log(altText);

  {% comment %} // Hide both tabs first
  $('.tab1 .style-tab .sidebar .tab[data-tab="Center_shaft"]').hide();
  $('.tab1 .style-tab .sidebar .tab[data-tab="Face_neck"]').hide(); {% endcomment %}

  // Show corresponding div based on which image is clicked
  if (altText === 'ts_503_select_balance_1') {
    $('.tab1 .style-tab .sidebar .tab[data-tab="Short_plumber_neck"]').show();
    $('.tab1 .style-tab .sidebar .tab[data-tab="Long_plumber_neck"]').hide();
    console.log('here clicked-1');
    $('.tab1 .image-wrapper .default-image-sides .balance-only').not('.balance').remove();
    $('.tab1 .image-wrapper .default-image-sides .front-only').show();
    $('.sidebar .tab[data-tab="Short_plumber_neck"]').trigger('click');
    $('div#colorGrid img').first().trigger('click'); 
    const short_plumber_neck_shaft_image = "https://tsquaredputters.com/cdn/shop/files/TS-503_Silver_Short.png";
   
    $('div#custom-image-preview img.active:first-child').attr('src', short_plumber_neck_shaft_image);
    $('div#custom-image-preview .balance').attr('src', short_plumber_neck_shaft_image);
    $('.hosel_color').show();
    $('.hosel-color-overlay').hide();
    $('.club_lie').hide();
    $('.club_loft').hide();

  } else if (altText === 'ts_503_select_balance_2') {
    $('.tab1 .style-tab .sidebar .tab[data-tab="Short_plumber_neck"]').hide();
    $('.tab1 .style-tab .sidebar .tab[data-tab="Long_plumber_neck"]').show();
    {% comment %} alert('here clicked-2'); {% endcomment %}
    $('.tab1 .image-wrapper .default-image-sides .balance-only').not('.balance').remove();
    $('.tab1 .image-wrapper .default-image-sides .front-only').show();

    setTimeout(function() {
        $('.sidebar .tab[data-tab="Long_plumber_neck"]').trigger('click');
        $('div#colorGrid img').first().trigger('click'); 
        var $container = $('.tab1 .image-wrapper .default-image-sides');
        if ($container.find('.long_plumber_neck.balance-only').length > 0) {
          {% comment %} alert('long_plumber_neck found'); {% endcomment %}
          $('.long_plumber_neck.balance-only').show().css('z-index','9');

          const long_plumber_neck_shaft_image = "https://tsquaredputters.com/cdn/shop/files/TS-503_Silver_Long.png"
         
          $('div#custom-image-preview img.active:first-child').attr('src', long_plumber_neck_shaft_image);
          $('div#custom-image-preview .balance').attr('src', long_plumber_neck_shaft_image);
          $('.shaft').show();
          $('.hosel_color').hide();
          $('.club_lie').hide();
          $('.club_loft').hide();
            
        // Check for .hosel_color class inside .default-image-sides div
        var $defaultImageSides = $('.tab1 .image-wrapper .default-image-sides');
        var $hoselColorEl = $defaultImageSides.find('.hosel_color');
        
        // Map for hosel_color color overlay images
        const balanceLongHoselColorOverlayMap = {
          Red:    "https://cdn.shopify.com/s/files/1/0597/8855/8523/files/ts_503_hosel_color_long_1.png",
          Black:  "https://cdn.shopify.com/s/files/1/0597/8855/8523/files/ts_503_hosel_color_long_2.png",
          Blue:   "https://cdn.shopify.com/s/files/1/0597/8855/8523/files/ts_503_hosel_color_long_3.png",
          Green:  "https://cdn.shopify.com/s/files/1/0597/8855/8523/files/ts_503_hosel_color_long_4.png",
          Gold:   "https://cdn.shopify.com/s/files/1/0597/8855/8523/files/ts_503_hosel_color_long_5.png",
          Pink:   "https://cdn.shopify.com/s/files/1/0597/8855/8523/files/ts_503_hosel_color_long_6.png",
          Purple: "https://cdn.shopify.com/s/files/1/0597/8855/8523/files/ts_503_hosel_color_long_7.png",
          Orange: "https://cdn.shopify.com/s/files/1/0597/8855/8523/files/ts_503_hosel_color_long_8.png"
        };

        // Remove any previous shaft overlay images we may have added before
