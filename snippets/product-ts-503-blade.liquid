<style>
    .color-selector {
        height: 920px;
        overflow-y: scroll;
    }
    .color-selector::-webkit-scrollbar {
        width: 0px;
    }
    {% comment %} size length {% endcomment %}
    #colorGrid .color-box:has(img[alt="ts_503_shaft_length_1"])::after {
        content: "33'";
        position: absolute;
        color: #000;
        top: 50% !important;
        left: 50%;
        transform: translate(-50%, -50%);
        display: block !important;
        width: 100%;
        text-align: center;
        padding: 0 8px;
    }
    #colorGrid .color-box:has(img[alt="ts_503_shaft_length_2"])::after {
        content: "33.5'";
        position: absolute;
        color: #000;
        top: 50% !important;
        left: 50%;
        transform: translate(-50%, -50%);
        display: block !important;
        width: 100%;
        text-align: center;
