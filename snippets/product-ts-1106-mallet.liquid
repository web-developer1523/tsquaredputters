<script>
$(document).ready(function () {
// Initially hide the divs you want to show
$('.tab1 .style-tab .sidebar .tab[data-tab="Center_shaft"]').hide();
$('.tab1 .style-tab .sidebar .tab[data-tab="Single_bend"]').hide();

// Use event delegation for dynamically added images
$(document).on('click', '#colorGrid .color-image', function() {
  var altText = $(this).attr('alt');
  console.log(altText);

  {% comment %} // Hide both tabs first
  $('.tab1 .style-tab .sidebar .tab[data-tab="Center_shaft"]').hide();
  $('.tab1 .style-tab .sidebar .tab[data-tab="Face_neck"]').hide(); {% endcomment %}

  // Show corresponding div based on which image is clicked
  if (altText === 'ts_1106_select_balance_1') {
    $('.tab1 .style-tab .sidebar .tab[data-tab="Single_bend"]').show();
    $('.tab1 .style-tab .sidebar .tab[data-tab="Center_shaft"]').hide();
   
      console.log('here clicked-1');
    $('.tab1 .image-wrapper .default-image-sides .balance-only').not('.balance').remove();

  } else if (altText === 'ts_1106_select_balance_2') {
    $('.tab1 .style-tab .sidebar .tab[data-tab="Center_shaft"]').show();
    $('.tab1 .style-tab .sidebar .tab[data-tab="Single_bend"]').hide();

    console.log('here clicked-2');
    $('.tab1 .image-wrapper .default-image-sides .balance-only').not('.balance').remove();

  }

});

$('#colorGrid').on('click', '.color-box .color-image', function () {
    $('.color-box').css('border','1px solid #000');
    $(this).parent().css('border','3px solid #000');
    const altText = $(this).attr('alt');
    const container = $('.tab1 .image-wrapper .default-image-sides');
  
    // 1. Store which image types were previously active
    const wasFrontActive = container.find('img.front-only.active').length > 0;
    const wasSideActive = container.find('img.side-only.active').length > 0;
    const wasBalanceActive = container.find('img.balance-only.active').length > 0;
  
    // 2. Find all images in source with the same alt
    const matchedImgs = $('.all-other-images img').filter(function () {
      return $(this).attr('alt') === altText;
    });
  
    if (matchedImgs.length === 0) {
      console.warn('No matching images found for alt:', altText);
      return;
    }
  
    // 3. Get the group class: finish, shaft, balance, etc.
    const groupClass = matchedImgs.first().attr('class').split(/\s+/).find(cls =>
      ['finish','shaft','balance','center_shaft','single_bend','face_color','base_plate','sightline_color','sole_inlay','hand_style','grip_style','shaft_length', 'club_lie'].includes(cls)
    );
  
    if (!groupClass) {
      console.warn('No valid group class found in matched image.');
      return;
    }
  
    // 4. Remove existing images for this group
    container.find(`img.${groupClass}.front-only`).remove();
    container.find(`img.${groupClass}.side-only`).remove();
    container.find(`img.${groupClass}.balance-only`).remove();

    // helper to clone + preserve active state + preserve custom attributes
    function appendCloned(img, wasActive) {
        if (img.length) {
            const cloned = img.clone();
            if (wasActive) cloned.addClass('active');
    
            // copy custom attributes dynamically
            $.each(img[0].attributes, function () {
            if (this.specified && !['src','class','alt'].includes(this.name)) {
                cloned.attr(this.name, this.value);
            }
            if (this.name.toLowerCase().includes("club_lie")) {
                console.log("Club Lie Title:", this.name, this.value);
        
                // Set the add-to-cart button's data-variant with the actual variant ID
                // But we'll use the title in properties later
                $('.cst-custom-add-to-cart').attr('data-variant', img.closest('.Club_lie').find('img[alt="' + altText + '"]').data('variant-id') || {{ product.selected_or_first_available_variant.id }});
                
            }
            });
    
            container.append(cloned);
        }
    }
  
    // 5. Find and clone the front, side, and balance images for the selected color
    appendCloned(matchedImgs.filter(`.front-only.${groupClass}`).first(), wasFrontActive);
    appendCloned(matchedImgs.filter(`.side-only.${groupClass}`).first(), wasSideActive);
    appendCloned(matchedImgs.filter(`.balance-only.${groupClass}`).first(), wasBalanceActive);
  });


