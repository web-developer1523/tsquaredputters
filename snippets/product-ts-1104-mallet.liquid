        <!-- Tab Radios -->
        {% comment %} <input type="radio" id="tab1" name="tab-control" checked />
        <label for="tab1" title="Tab 1"><span>Style</span></label>

        <input type="radio" id="tab2" name="tab-control" />
        <label for="tab2" title="Tab 2"><span>Extra</span></label>

        <input type="radio" id="tab3" name="tab-control" />
        <label for="tab3" title="Tab 3"><span>Summary</span></label> {% endcomment %}

