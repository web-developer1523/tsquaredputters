    e.preventDefault();

        {% comment %} check validation {% endcomment %}
        const container = $('.tab1 .image-wrapper .default-image-sides');
        const requiredGroups = ['finish','shaft','balance','base_plate','sightline_color','hand_style','grip_style','shaft_length'];

        let missing = [];

        // Check if each required group exists in the preview
        requiredGroups.forEach(group => {
            if (container.find('img.' + group).length === 0) {
            missing.push(group.replace(/_/g, ' '));
            }
        });

        // Check which balance type is selected
        const balanceImg = container.find('img.balance');
        const balanceAlt = balanceImg.attr('alt');

        if (balanceAlt === 'ts_1104_select_balance_1') {
            // plumbers neck required
            if (container.find('img.single_bend').length === 0) {
            missing.push('Single Bend');
            }
        } else if (balanceAlt === 'ts_1104_select_balance_2') {
            // center shaft required
            if (container.find('img.flow_neck').length === 0) {
            missing.push('Flow Neck');
            }
        }

        if (missing.length > 0) {
            const alertBox = $('.alert-message');
            const formattedMissing = missing.map(name =>
              name.split(' ').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' '));
              const message = 'Please select: ' + formattedMissing.join(', ') + ' before adding to cart.';

            alertBox.html(message).stop(true, true).fadeIn(200).delay(4000);
            return false;
        }
        {% comment %} end validation {% endcomment %}

    $('.cst-custom-add-to-cart .loader').css('display','inline-block');
    $('.cst-custom-add-to-cart').addClass('cst-disabled');
    $('#merge-btn').trigger('click');

});

{% comment %} responsive open and close {% endcomment %}
$('.cross-btn').click(function(){
    $('.color-selector').removeClass('active');
});

$('#tabMenu .tab').click(function(){
    $('.color-selector').addClass('active');
});


});
</script>
