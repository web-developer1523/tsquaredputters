<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
{{ 'custom.css' | asset_url | stylesheet_tag: preload: true }}
<section class="main-section">
  <div class="tabs">
    <!-- Tab Radios -->
    {% comment %}
      <input type="radio" id="tab1" name="tab-control" checked />
      <label for="tab1" title="Tab 1"><span>Style</span></label>

      <input type="radio" id="tab2" name="tab-control" />
      <label for="tab2" title="Tab 2"><span>Extra</span></label>

      <input type="radio" id="tab3" name="tab-control" />
      <label for="tab3" title="Tab 3"><span>Summary</span></label>
    {% endcomment %}

    <!-- Tab Content -->
    <div class="content">
      <!-- Tab 1: Leather Customization -->
      <section class="tab1">
        <div class="style-tab">
          <div class="sidebar" id="tabMenu">
            <div class="tab active" data-tab="Finish">Finish</div>
            <div class="tab" data-tab="Shaft">Shaft</div>
            <div class="tab" data-tab="Balance">
              Balance
              <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#000">
                <path d="M480-344 240-584l56-56 184 184 184-184 56 56-240 240Z"/>
              </svg>
            </div>
            <div class="tab" data-tab="Single_bend">
              <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#000">
                <path d="m560-120-57-57 144-143H200v-480h80v400h367L503-544l56-57 241 241-240 240Z"/>
              </svg>
              Single Bend
            </div>
            <div class="tab" data-tab="Flow_neck">
              <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#000">
                <path d="m560-120-57-57 144-143H200v-480h80v400h367L503-544l56-57 241 241-240 240Z"/>
              </svg>
              Flow Neck
            </div>
            <div class="tab" data-tab="Face_color">Face Color</div>
            <div class="tab" data-tab="Base_plate_color">Base Plate Color</div>
            <div class="tab" data-tab="Sightline_color">Sightline Color</div>
            <div class="tab" data-tab="Hand">Hand</div>
            <div class="tab" data-tab="Grip_style">Grip Style</div>
            <div class="tab" data-tab="Shaft_length">Shaft Length</div>
          </div>
          <div class="color-selector">
            <div class="cross-btn">
              <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#000">
                <path d="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z"/>
              </svg>
            </div>
            <div class="section-title" id="sectionTitle"></div>
            <div class="color-grid" id="colorGrid">
              <!-- Color boxes will be injected here -->
            </div>
          </div>
        </div>
        <div class="image-wrapper">
